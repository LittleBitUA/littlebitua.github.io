---
// ─── Game Card ─────────────────────────────────────────────────
// Усе на обкладинці, як у Steam: статус угорі, внизу назва,
// прогрес перекладу і кнопка «Грати» / «Підтримати».
// Уся картка веде на сторінку гри (розтягнуте посилання на назві),
// кнопка — окреме посилання поверх неї. data-* читає FilterBar.
import type { Game } from "../data/games";
import { cover } from "../lib/cover";
import {
  statusMeta, isPlayable, isFundraising, fundraisingPercent, formatMoney, formatPct, stagesOf, stageName, isStageAbandoned,
} from "../utils/status";

export interface Props {
  game: Game;
  headingLevel?: "h2" | "h3";
}
const { game, headingLevel: Heading = "h3" } = Astro.props;

const st = statusMeta(game.status);
const img = await cover(game.cover, 400);
const fundActive = isFundraising(game) && !!game.fundraisingGoal;

// Рядки прогресу: збір (якщо триває) + кожен етап локалізації
type Row = { label: string; pct: number; state: "done" | "active" | "todo" | "fund" | "abandoned" };
const rows: Row[] = [
  ...(fundActive ? [{ label: "Зібрано", pct: fundraisingPercent(game), state: "fund" as const }] : []),
  ...stagesOf(game).map((s) => ({
    label: stageName(s.label),
    pct: s.percent,
    state: (s.percent < 100 && isStageAbandoned(game, s.label)
      ? "abandoned"
      : s.percent >= 100 ? "done" : s.percent > 0 ? "active" : "todo") as Row["state"],
  })),
];

const fundUrl = game.fundraisingUrl ?? game.donateUrl;
// Кнопки на обкладинці: «Грати», якщо гра вже доступна, і «Підтримати», якщо триває збір
const actions = [
  ...(game.downloadUrl && isPlayable(game) ? [{ label: "Грати", href: game.downloadUrl, variant: "play" }] : []),
  ...(fundActive && fundUrl ? [{ label: "Підтримати", href: fundUrl, variant: "fund" }] : []),
];
---

<article
  class="card"
  style={`--state:${st.color}`}
  data-game-id={game.id}
  data-series={game.series ?? ""}
  data-status={game.status}
  data-title={game.title}
  data-tags={game.tags.join(",")}
  data-progress={game.progress}
  data-last-update={game.lastUpdate ?? ""}
  data-fundraising={isFundraising(game) ? "true" : ""}
  data-playable={isPlayable(game) ? "true" : ""}
>
  <img class="card__img" src={img} alt="" width="300" height="450" loading="lazy" decoding="async" />

  <span class="status card__status">{st.label}</span>
  {fundActive && (
    <span class="card__money">
      <strong class="num">{formatMoney(game.fundraisingRaised ?? 0)}</strong>
      <small>із {formatMoney(game.fundraisingGoal!)}</small>
    </span>
  )}

  <div class="card__bottom">
    <Heading class="card__title">
      <a href={`/games/${game.id}/`} class="card__link">{game.title}</a>
    </Heading>

    <ul class="card__rows">
      {rows.map((r) => (
        <li class={`row is-${r.state}`} title={r.state === "abandoned" ? `${r.label}: закинуто на ${formatPct(r.pct)}%` : undefined}>
          <span class="row__label">{r.label}</span>
          <span class="row__bar" aria-hidden="true"><i style={`width:${r.pct}%`}></i></span>
          <span class="row__pct num">{r.state === "todo" ? "—" : `${formatPct(r.pct)}%`}</span>
        </li>
      ))}
    </ul>

    {actions.length > 0 && (
      <div class="card__actions">
        {actions.map((action) => (
          <a
            href={action.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`card__action card__action--${action.variant}`}
            aria-label={`${action.label}: ${game.title}`}
          >
            {action.variant === "play" && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
            )}
            {action.label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    aspect-ratio: 2 / 3;
    min-width: 0;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: border-color 0.2s ease, translate 0.25s var(--ease);
  }
  .card:hover { border-color: var(--state); translate: 0 -3px; }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s var(--ease);
  }
  .card:hover .card__img { transform: scale(1.03); }

  /* Затемнення знизу під текст */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 9, 11, 0.35) 0%, transparent 22%, transparent 36%, rgba(8, 9, 11, 0.9) 64%, rgba(8, 9, 11, 0.97) 100%);
    pointer-events: none;
  }

  .card__status { position: absolute; top: 8px; left: 8px; z-index: 1; }

  .card__money {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    padding: 6px 8px;
    background: var(--bg);
  }
  .card__money strong { color: var(--st-fund); font-size: 11px; font-weight: 700; }
  .card__money small { color: var(--muted); font-size: 10px; font-weight: 700; }

  .card__bottom {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 12px;
  }

  .card__title {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
  .card__link {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Розтягнуте посилання: клікабельна вся картка */
  .card__link::after { content: ""; position: absolute; inset: 0; z-index: 2; }
  .card__link:focus-visible { outline: none; }
  .card:has(.card__link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }

  .card__rows { display: grid; gap: 5px; margin-top: 10px; }
  .row {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr) minmax(2.4rem, auto);
    align-items: center;
    gap: 8px;
    font-size: 11px;
    line-height: 1.2;
  }
  .row__label { overflow: hidden; color: rgba(242, 240, 233, 0.78); font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
  .row__bar { height: 3px; background: rgba(255, 255, 255, 0.18); }
  .row__bar i { display: block; height: 100%; }
  .row__pct { color: var(--ink); font-size: 10px; font-weight: 700; text-align: right; white-space: nowrap; }

  .row.is-done .row__bar i { background: var(--st-done); }
  .row.is-done .row__pct, .row.is-done .row__label { color: var(--st-done); }
  .row.is-active .row__bar i { background: var(--accent); }
  .row.is-fund .row__bar i { background: var(--st-fund); }
  .row.is-fund .row__pct, .row.is-fund .row__label { color: var(--st-fund); }
  .row.is-todo .row__label, .row.is-todo .row__pct { color: rgba(242, 240, 233, 0.5); }
  /* Закинутий етап: закреслена назва й заштрихована смуга до місця, де зупинились */
  .row.is-abandoned .row__label { color: var(--st-abandoned); text-decoration: line-through; text-decoration-thickness: 1.5px; }
  .row.is-abandoned .row__pct { color: var(--st-abandoned); }
  .row.is-abandoned .row__bar { height: 4px; }
  .row.is-abandoned .row__bar i { background: var(--hatch-abandoned); }

  .card__actions { display: flex; gap: 6px; margin-top: 10px; }
  .card__action {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 6px;
    white-space: nowrap;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .card__action svg { width: 12px; height: 12px; fill: currentColor; }
  .card__action--play { background: var(--accent); color: var(--on-accent); }
  .card__action--play:hover { background: var(--accent-hover); }
  .card__action--fund { background: rgba(8, 9, 11, 0.8); border: 1px solid var(--st-fund); color: var(--st-fund); }
  .card__action--fund:hover { background: var(--st-fund); color: var(--on-accent); }

  @media (max-width: 479px) {
    .card__bottom { padding: 8px; }
    .card__title { font-size: 12px; }
    .row { grid-template-columns: 3.9rem minmax(0, 1fr) minmax(2.1rem, auto); gap: 5px; font-size: 10px; }
    .card__rows { gap: 4px; margin-top: 6px; }
    .card__money small { display: none; }
    .card__actions { gap: 4px; margin-top: 8px; }
    .card__action { min-height: 30px; font-size: 10px; letter-spacing: 0.04em; }
  }
</style>
