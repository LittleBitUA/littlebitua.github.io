---
import type { Game } from "../data/games";
import { getProgressPalette } from "../utils/statusColors";

export interface Props {
  game: Game;
}

const { game } = Astro.props;

const translationStage = game.stageDetails?.find((d) => d.label === "Переклад");
const translationPercent = translationStage?.percent ?? game.progress;
const palette = getProgressPalette(game.status, translationPercent);

type StatusCfg = { icon: string; label: string; color: string };
const STATUS: Record<string, StatusCfg> = {
  "done":         { icon: "check",    label: "Готово до гри",  color: "#10b981" },
  "early-access": { icon: "play",     label: "Ранній доступ",  color: "#0ea5e9" },
  "in-progress":  { icon: "progress", label: "Перекладається", color: "#8b5cf6" },
  "fundraising":  { icon: "coin",     label: "Збір коштів",    color: "#f59e0b" },
};
const cfg: StatusCfg = STATUS[game.status] ?? { icon: "dot", label: game.status, color: "#64748b" };
---

<article
  class="game-card"
  data-game-id={game.id}
  data-series={game.series}
  data-status={game.status}
  data-title={game.title}
  data-tags={game.tags.join(",")}
  data-progress={game.progress}
  data-platform={game.platform?.join(",") || ""}
  data-translation-size={game.translationSize || ""}
  data-game-year={game.gameYear || 0}
  data-last-update={game.lastUpdate || ""}
  data-download-url={game.downloadUrl ?? ""}
  data-animate
>
  <div class="nd-game-card group">
    <div class="relative aspect-[2/3] overflow-hidden rounded-2xl" style="background:#090b14;">

      <!-- Cover -->
      <img
        src={game.cover}
        alt={game.title}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.05]"
        loading="lazy"
        decoding="async"
      />

      <!-- Gradient overlay -->
      <div
        class="absolute inset-0"
        style="background: linear-gradient(to top, rgba(7,9,18,0.96) 0%, rgba(7,9,18,0.45) 30%, transparent 55%);"
      ></div>

      <!-- Status pill — top left -->
      <div class="absolute top-2.5 left-2.5 z-10">
        <span class="gc-pill" style={`color: ${cfg.color}; border-color: ${cfg.color}44;`}>
          {cfg.icon === "check" && (
            <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
          )}
          {cfg.icon === "play" && (
            <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          )}
          {cfg.icon === "progress" && (
            <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/>
            </svg>
          )}
          {cfg.icon === "coin" && (
            <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          )}
          {cfg.label}
        </span>
      </div>

      <!-- Bottom: title + status content -->
      <div class="absolute inset-x-0 bottom-0 p-3 z-10">
        <h3 class="text-sm font-bold text-white leading-snug mb-2 nd-line-clamp">
          {game.title}
        </h3>

        {game.status === "done" ? (
          <div>
            <div class="h-[3px] w-full rounded-full mb-2" style={`background: ${cfg.color};`}></div>
            <a
              href={game.downloadUrl ?? "/#launcher"}
              target={game.downloadUrl ? "_blank" : "_self"}
              rel="noopener noreferrer"
              class="gc-play-btn"
              style={`background: ${cfg.color}22; border-color: ${cfg.color}55; color: ${cfg.color};`}
              onclick="event.stopPropagation()"
            >
              <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              Грати українською
            </a>
          </div>
        ) : game.status === "early-access" ? (
          <div>
            <div class="flex items-center gap-2 mb-0.5">
              <div class="flex-1 h-[3px] rounded-full overflow-hidden" style="background: rgba(255,255,255,0.10);">
                <div class="h-full rounded-full" style={`width: ${translationPercent}%; background: ${palette.solid};`}></div>
              </div>
              <span class="text-[10px] font-bold tabular-nums shrink-0" style={`color: ${cfg.color};`}>{translationPercent}%</span>
            </div>
            <p class="text-[9px] text-white/30 font-medium mb-2 uppercase tracking-wide">перекладено</p>
            <!-- Full-width play strip — whole card click handles navigation -->
            <div class="gc-ea-strip" style={`background: ${cfg.color}16; color: ${cfg.color};`}>
              <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              Грати зараз
            </div>
          </div>
        ) : (
          <div>
            <div class="flex items-center gap-2 mb-1">
              <div class="flex-1 h-[3px] rounded-full overflow-hidden" style="background: rgba(255,255,255,0.10);">
                <div class="h-full rounded-full" style={`width: ${translationPercent}%; background: ${palette.solid};`}></div>
              </div>
              <span class="text-[10px] font-bold tabular-nums shrink-0" style={`color: ${cfg.color};`}>
                {translationPercent}%
              </span>
            </div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-[9px] text-white/35 font-medium uppercase tracking-wide">перекладено</span>
              {game.status === "fundraising" && game.fundraisingGoal && (
                <span class="text-[9px] font-bold" style="color: #f59e0b;">
                  {((game.fundraisingRaised ?? 0) / game.fundraisingGoal * 100).toFixed(0)}% зібрано
                </span>
              )}
            </div>
          </div>
        )}
      </div>

    </div>
  </div>
</article>

<style>
  .nd-game-card {
    display: block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .nd-game-card:hover { transform: translateY(-4px); }
  }

  .nd-line-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gc-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: rgba(7, 9, 18, 0.72);
    border: 1px solid;
    white-space: nowrap;
    line-height: 1.4;
  }

  .gc-play-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
    padding: 0.35rem 0.65rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    text-decoration: none;
    line-height: 1.4;
  }
  .gc-play-btn:hover { opacity: 0.85; }

  /* Early-access: full-width strip, card click handles navigation */
  .gc-ea-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.38rem 0.5rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
    opacity: 0.75;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  @media (hover: hover) {
    .nd-game-card:hover .gc-ea-strip {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".game-card").forEach((card) => {
    card.style.cursor = "pointer";
    card.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a, button")) return;
      const id = card.dataset.gameId;
      const status = card.dataset.status;
      const downloadUrl = card.dataset.downloadUrl;
      if (!id) return;
      if (status === "early-access" && downloadUrl) {
        window.open(downloadUrl, "_blank", "noopener noreferrer");
      } else {
        window.location.href = `/games/${id}/`;
      }
    });
  });
</script>
