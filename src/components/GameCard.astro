---
// ─── GameCard ─────────────────────────────────────────────────
// White liquid glass game card with cover, status, progress, actions.
// Status labels under the card are loaded from src/data/gameBadges.ts.

import Tag from "./Tag.astro";
import StatusBadge from "./StatusBadge.astro";
import type { Game } from "../data/games";
import { STATUS_LABELS } from "../data/games";
import { getBadge } from "../data/gameBadges";
import { getProgressPalette } from "../utils/statusColors";

export interface Props {
  game: Game;
}

const { game } = Astro.props;
const hasDetails = game.stageDetails && game.stageDetails.length > 0;
const badge = getBadge(game.id);

// Прогрес перекладу — показуємо над полоскою, щоб бар сам розʼяснював що там за відсоток.
const translationStage = game.stageDetails?.find((d) => d.label === "Переклад");
const translationPercent = translationStage?.percent ?? game.progress;

// Сегменти: 20 кубиків × 5% кожен. Кубик або повністю кольоровий, або порожній,
// а перший незаповнений ("next") пульсує напівпрозорим — наче ціль, до якої йдемо.
const filledCubes = Math.floor(translationPercent / 5);
const cubePalette = getProgressPalette(game.status, translationPercent);

// Top-of-cover status pill (from game data, kept dynamic)
const topPillLabel = game.status === "fundraising"
  ? STATUS_LABELS.fundraising
  : (game.status === "early-access" ? STATUS_LABELS["early-access"]
    : (game.status === "done" ? STATUS_LABELS.done
      : (game.status === "in-progress" ? STATUS_LABELS["in-progress"] : STATUS_LABELS.planned)));

const topPillColor =
  game.status === "done" ? "text-emerald-300 bg-emerald-950/60 border-emerald-700/40" :
  game.status === "early-access" ? "text-sky-300 bg-sky-950/60 border-sky-700/40" :
  game.status === "in-progress" ? "text-violet-300 bg-violet-950/60 border-violet-700/40" :
  game.status === "fundraising" ? "text-amber-300 bg-amber-950/60 border-amber-700/40" :
  "text-slate-300 bg-slate-900/60 border-slate-600/40";

// Чи має гра активний збір коштів (навіть якщо вона вже у ранньому доступі)
const fundraisingActive = !!game.fundraisingGoal && !game.fundraisingCompleted;
---

<article
  class="game-card group relative flex flex-col"
  data-game-id={game.id}
  data-series={game.series}
  data-status={game.status}
  data-title={game.title}
  data-tags={game.tags.join(",")}
  data-progress={game.progress}
  data-platform={game.platform?.join(",") || ""}
  data-translation-size={game.translationSize || ""}
  data-game-year={game.gameYear || 0}
  data-last-update={game.lastUpdate || ""}
  data-animate
>
  <div class="lb-glass lb-lift flex flex-col flex-1 overflow-hidden">

    <!-- Cover (Steam 2:3) -->
    <div class="relative aspect-[2/3] overflow-hidden">
      <img
        src={game.cover}
        alt={game.title}
        class="absolute inset-0 w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      {!badge && (
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent"></div>
      )}

      <!-- Top-left status pill -->
      <div class="absolute top-2.5 left-2.5 z-10">
        <span class={`inline-flex items-center gap-1 px-2.5 py-1 text-[10px] font-bold rounded-full border ${topPillColor}`}>
          {game.status === "done" && (
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          )}
          {(game.status === "early-access" || game.status === "in-progress") && (
            <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
          )}
          {game.status === "fundraising" && (<span class="text-xs font-bold leading-none">₴</span>)}
          {topPillLabel}
        </span>
      </div>

      <!-- Top-right percent -->
      <div class="absolute top-2.5 right-2.5 z-10">
        <span
          class="px-2.5 py-1 text-xs font-extrabold tabular-nums text-white rounded-lg"
          style="background: rgba(15, 23, 42, 0.78); box-shadow: 0 0 0 1px rgba(255,255,255,0.18) inset, 0 6px 14px -6px rgba(15,23,42,0.6); text-shadow: 0 1px 0 rgba(0,0,0,0.4);"
        >
          {game.progress}<span class="text-[10px] font-medium opacity-70">%</span>
        </span>
      </div>

      <!-- Status badge overlaid on the cover bottom (config-driven) -->
      {badge && (
        <div class="absolute bottom-0 left-0 right-0 z-10">
          <StatusBadge badge={badge} variant="overlay" />
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="p-4 sm:p-5 flex flex-col flex-1">
      <h3 class="text-base font-bold leading-snug mb-2 line-clamp-2 text-slate-100 lb-card-title">
        {game.title}
      </h3>

      <p class="card-desc text-[13px] leading-relaxed mb-3 line-clamp-2 text-slate-600 transition-all lb-card-desc">
        {game.description}
      </p>

      <!-- Progress (Variant B final: segmented step-bar, teal, "next cube" pulse) -->
      <div class="mb-3 lb-card-progress">
        {hasDetails ? (
          <div class="game-progress-toggle cursor-pointer" data-expanded="false">
            <div class="flex items-center justify-end mb-1.5">
              <span class="text-[11px] font-bold tabular-nums text-slate-300">{translationPercent}%</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 flex items-center gap-[2px]">
                {Array.from({ length: 20 }).map((_, i) => {
                  const isFull = i < filledCubes;
                  const isNext = i === filledCubes && translationPercent < 100;
                  return (
                    <div class="flex-1 h-2 rounded-sm bg-white/10 overflow-hidden relative">
                      {isFull && (
                        <div class="absolute inset-0 lb-cube-fill" style={`background: ${cubePalette.solid}; transition-delay: ${i * 28}ms;`}></div>
                      )}
                      {isNext && (
                        <div class="lb-cube-next absolute inset-0" style={`background: ${cubePalette.solid};`}></div>
                      )}
                    </div>
                  );
                })}
              </div>
              <button
                type="button"
                class="expand-btn flex-shrink-0 w-6 h-6 rounded-md bg-white/10 border border-white/15
                       flex items-center justify-center text-slate-400 hover:text-teal-400 hover:bg-white/15"
                aria-label="Деталі прогресу"
              >
                <svg class="w-3.5 h-3.5 expand-icon transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>

            <div class="stage-details overflow-hidden max-h-0 transition-all duration-300 ease-in-out">
              <div class="pt-3 space-y-1.5">
                {game.stageDetails!.map((detail) => (
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-between gap-1.5 flex-shrink-0 w-[110px] px-2 py-0.5 rounded-full bg-teal-950/60 border border-teal-700/40 text-teal-300">
                      <span class="text-[10px] font-semibold truncate">{detail.label}</span>
                      <span class="text-[10px] font-bold tabular-nums">{detail.percent}%</span>
                    </span>
                    <div class="flex-1 h-1.5 rounded-full bg-white/10 overflow-hidden">
                      <div
                        class="h-full rounded-full transition-all duration-500"
                        style={`width: ${detail.percent}%; background: ${detail.percent >= 100 ? "linear-gradient(90deg, #14b8a6, #0d9488)" : detail.percent > 0 ? "linear-gradient(90deg, #5eead4, #14b8a6)" : "transparent"};`}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <>
            <div class="flex items-center justify-end mb-1.5">
              <span class="text-[11px] font-bold tabular-nums text-slate-300">{translationPercent}%</span>
            </div>
            <div class="flex items-center gap-[2px]">
              {Array.from({ length: 20 }).map((_, i) => {
                const isFull = i < filledCubes;
                const isNext = i === filledCubes && translationPercent < 100;
                return (
                  <div class="flex-1 h-2 rounded-sm bg-white/10 overflow-hidden relative">
                    {isFull && (
                      <div class="absolute inset-0 lb-cube-fill" style={`background: ${translationPercent >= 100 ? "#10b981" : "#14b8a6"}; transition-delay: ${i * 28}ms;`}></div>
                    )}
                    {isNext && (
                      <div class="lb-cube-next absolute inset-0" style="background: #14b8a6;"></div>
                    )}
                  </div>
                );
              })}
            </div>
          </>
        )}
      </div>

      <!-- Tags (single row, fixed height) -->
      <div class="flex flex-wrap gap-1.5 mb-4 lb-card-tags">
        {game.tags.slice(0, 3).map((tag) => <Tag label={tag} />)}
      </div>

      <!-- Action row -->
      <div class="flex items-center gap-1.5 mt-2">
        {game.downloadUrl ? (
          <a
            href={game.downloadUrl}
            target="_blank" rel="noopener noreferrer"
            class="flex-1 lb-btn !py-2 !text-xs"
            style="color:#4ade80; background: rgba(34,197,94,0.18); border: 1px solid rgba(34,197,94,0.45);"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Завантажити
          </a>
        ) : (
          <span
            class="flex-1 lb-btn !py-2 !text-xs cursor-not-allowed"
            style="color: #94a3b8; background: rgba(148,163,184,0.12); border: 1px solid rgba(148,163,184,0.25);"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Скоро
          </span>
        )}

        {game.steamUrl && (
          <a
            href={game.steamUrl}
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-9 h-9 rounded-xl border bg-white/10 text-slate-300 border-white/15 hover:bg-white/20 hover:text-white transition-colors"
            aria-label="Сторінка в Steam"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.455 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/>
            </svg>
          </a>
        )}

        {(game.status === "fundraising" || game.fundraisingGoal) && (
          <a
            href={game.donateUrl}
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-9 h-9 rounded-xl border bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-100 transition-colors"
            aria-label="Підтримати збір"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll(".game-progress-toggle").forEach((toggle) => {
    const btn = toggle.querySelector(".expand-btn");
    const icon = toggle.querySelector(".expand-icon");
    const details = toggle.querySelector(".stage-details") as HTMLElement;
    if (!btn || !icon || !details) return;

    const card = toggle.closest("article");
    const desc = card?.querySelector(".card-desc");

    const handleClick = (e: Event) => {
      e.stopPropagation();
      const expanded = toggle.getAttribute("data-expanded") === "true";
      toggle.setAttribute("data-expanded", String(!expanded));
      if (!expanded) {
        details.style.maxHeight = details.scrollHeight + "px";
        icon.classList.add("rotate-180");
        desc?.classList.remove("line-clamp-2");
      } else {
        details.style.maxHeight = "0px";
        icon.classList.remove("rotate-180");
        desc?.classList.add("line-clamp-2");
      }
    };

    btn.addEventListener("click", handleClick);
    toggle.addEventListener("click", handleClick);
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Fixed sizes — every card has the same vertical rhythm.
     Title 2 lines, description 2 lines, tags single row.
     Buttons stack at the same Y across all cards regardless of text length. */
  .lb-card-title {
    height: calc(1.4em * 2);
    min-height: calc(1.4em * 2);
    line-height: 1.4em;
  }
  .lb-card-desc {
    min-height: calc(1.55em * 2);
    line-height: 1.55em;
  }
  .lb-card-tags {
    overflow: visible;
  }
  .lb-card-progress { min-height: 0.875rem; }

  /* "Наступний" сегмент — пульсує напівпрозорим тілом-акцентом,
     наче ціль, до якої прямує заливка. */
  .lb-cube-next {
    animation: lbCubeNext 1.6s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes lbCubeNext {
    0%, 100% { opacity: 0.18; }
    50%      { opacity: 0.55; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-cube-next { animation: none; opacity: 0.3; }
  }

  /* ── Покращення 1: Status glow on hover ──────────────────────
     Кольоровий glow під карткою при hover — колір відповідає статусу.
     Щоб вимкнути: видали цей блок цілком. */
  .game-card[data-status="done"]:hover .lb-glass {
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.10),
      0 20px 50px -20px rgba(16,185,129,0.55),
      0 8px 20px -10px rgba(16,185,129,0.25);
  }
  .game-card[data-status="early-access"]:hover .lb-glass {
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.10),
      0 20px 50px -20px rgba(14,165,233,0.55),
      0 8px 20px -10px rgba(14,165,233,0.25);
  }
  .game-card[data-status="in-progress"]:hover .lb-glass {
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.10),
      0 20px 50px -20px rgba(139,92,246,0.55),
      0 8px 20px -10px rgba(139,92,246,0.25);
  }
  .game-card[data-status="fundraising"]:hover .lb-glass {
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.10),
      0 20px 50px -20px rgba(245,158,11,0.55),
      0 8px 20px -10px rgba(245,158,11,0.25);
  }
  /* ── кінець Покращення 1 ──────────────────────────────────── */

  /* ── Покращення 2: Scroll-reveal cube fill ────────────────────
     Куби заповнюються зліва-направо при скролі до картки.
     Щоб вимкнути: видали цей блок + <script> нижче. */
  .lb-cube-fill {
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lb-cubes-revealed .lb-cube-fill {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .lb-cube-fill { transform: scaleX(1); transition: none; }
  }
  /* ── кінець Покращення 2 ──────────────────────────────────── */
</style>

<script>
/* ── Покращення 2: Scroll-reveal cube fill ─────────────────────
   IntersectionObserver вмикає lb-cubes-revealed на .lb-card-progress
   щойно картка потрапляє у вʼюпорт.
   Щоб вимкнути: видали цей <script> блок + CSS вище. */
if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
  const cubeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("lb-cubes-revealed");
          cubeObserver.unobserve(e.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll(".lb-card-progress").forEach((el) => cubeObserver.observe(el));
}
</script>
