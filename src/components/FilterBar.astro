---
// ─── FilterBar ─────────────────────────────────────────────────
// Пошук, фільтр за статусом, сортування. Працює з будь-якими
// елементами [data-game-id] на сторінці (див. GameCard).
// Стан синхронізується з URL: ?status=…&q=…&tag=…
import { getStatusList } from "../data/games";
import { STATUS_META } from "../utils/status";

const filters = [
  { value: "all", label: "Усі" },
  { value: "playable", label: "Можна грати" },
  ...getStatusList().map((s) => ({ value: s, label: STATUS_META[s].label })),
];
---

<div class="filters" id="filters">
  <label class="search">
    <span class="sr-only">Пошук</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-5-5m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
    <input id="search-input" type="search" placeholder="Назва, серія, жанр…" autocomplete="off" />
  </label>

  <div class="status-filters" role="group" aria-label="Статус">
    {filters.map((f) => (
      <button type="button" class="filter-btn" data-value={f.value} aria-pressed={f.value === "all" ? "true" : "false"}>
        {f.label}
      </button>
    ))}
  </div>

  <div class="filters__end">
    <span id="results-counter" class="counter" aria-live="polite"></span>
    <label class="sort">
      <span class="sr-only">Сортування</span>
      <select id="sort-select">
        <option value="default">За статусом</option>
        <option value="update-desc">Нещодавно оновлені</option>
        <option value="progress-desc">Прогрес ↓</option>
        <option value="progress-asc">Прогрес ↑</option>
        <option value="title-asc">Назва А–Я</option>
      </select>
    </label>
  </div>

  <div id="active-tag" class="active-tag" hidden>
    Тег: <b id="active-tag-label"></b>
    <button id="clear-tag" type="button" aria-label="Скинути тег">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6l12 12" /></svg>
    </button>
  </div>
</div>

<div id="filter-empty" class="empty" hidden>
  <p id="filter-empty-title" class="empty__title">Нічого не знайдено</p>
  <p class="empty__text">Спробуйте коротший запит або скиньте фільтри.</p>
  <button id="filter-reset" type="button" class="btn btn--primary btn--sm">Скинути фільтри</button>
</div>

<script>
  import Fuse from "fuse.js";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const searchInput = $<HTMLInputElement>("search-input");
  const sortSelect = $<HTMLSelectElement>("sort-select");
  const counter = $("results-counter");
  const tagBox = $("active-tag");
  const tagLabel = $("active-tag-label");
  const empty = $("filter-empty");
  const emptyTitle = $("filter-empty-title");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"));

  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-game-id]")).map((el, index) => ({
    el,
    index,
    title: el.dataset.title ?? "",
    series: el.dataset.series ?? "",
    tags: el.dataset.tags ?? "",
    status: el.dataset.status ?? "",
    progress: Number(el.dataset.progress ?? 0),
    lastUpdate: el.dataset.lastUpdate ?? "",
    fundraising: el.dataset.fundraising === "true",
  }));
  type Item = (typeof items)[number];

  const fuse = new Fuse(items, { keys: ["title", "series", "tags"], threshold: 0.3, useExtendedSearch: true });

  const params = new URLSearchParams(location.search);
  const state = {
    status: params.get("status") ?? "all",
    query: params.get("q") ?? "",
    tag: params.get("tag") ?? "",
    sort: "default",
  };

  const matchesStatus = (g: Item) => {
    switch (state.status) {
      case "all": return true;
      case "playable": return g.status === "done" || g.status === "early-access";
      case "fundraising": return g.status === "fundraising" || g.fundraising;
      default: return g.status === state.status;
    }
  };

  const sorters: Record<string, (a: Item, b: Item) => number> = {
    default: (a, b) => a.index - b.index,
    "update-desc": (a, b) => b.lastUpdate.localeCompare(a.lastUpdate),
    "progress-desc": (a, b) => b.progress - a.progress,
    "progress-asc": (a, b) => a.progress - b.progress,
    "title-asc": (a, b) => a.title.localeCompare(b.title, "uk"),
  };

  function syncUrl() {
    const p = new URLSearchParams();
    if (state.status !== "all") p.set("status", state.status);
    if (state.query.trim()) p.set("q", state.query.trim());
    if (state.tag) p.set("tag", state.tag);
    const qs = p.toString();
    history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
  }

  function render() {
    const query = state.query.trim();
    let list = query
      ? fuse.search(query.split(/\s+/).map((t) => `'${t}`).join(" ")).map((r) => r.item)
      : items;
    list = list.filter(matchesStatus);
    if (state.tag) list = list.filter((g) => g.tags.toLowerCase().split(",").includes(state.tag.toLowerCase()));
    list = [...list].sort(sorters[state.sort] ?? sorters.default);

    const order = new Map(list.map((g, i) => [g.el, i]));
    for (const { el } of items) {
      const pos = order.get(el);
      el.hidden = pos === undefined;
      el.style.order = pos === undefined ? "" : String(pos);
    }

    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.value === state.status)));
    tagBox.hidden = !state.tag;
    tagLabel.textContent = state.tag;

    const filtered = state.status !== "all" || query || state.tag;
    counter.textContent = filtered ? `${list.length} з ${items.length}` : "";
    empty.hidden = list.length > 0;
    emptyTitle.textContent = query ? `За запитом «${query}» нічого не знайдено` : "За цими фільтрами нічого не знайдено";

    syncUrl();
  }

  searchInput.value = state.query;
  let timer: ReturnType<typeof setTimeout>;
  searchInput.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => { state.query = searchInput.value; render(); }, 200);
  });
  buttons.forEach((b) => b.addEventListener("click", () => { state.status = b.dataset.value ?? "all"; render(); }));
  sortSelect.addEventListener("change", () => { state.sort = sortSelect.value; render(); });
  $("clear-tag").addEventListener("click", () => { state.tag = ""; render(); });
  $("filter-reset").addEventListener("click", () => {
    Object.assign(state, { status: "all", query: "", tag: "", sort: "default" });
    searchInput.value = "";
    sortSelect.value = "default";
    render();
  });

  render();
</script>

<style>
  .filters {
    position: sticky;
    top: calc(var(--header-h) - 4px);
    z-index: 30;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 28px;
    padding: 12px 0;
    background: rgba(8, 9, 11, 0.96);
    border-block: 1px solid var(--line);
  }

  .search { position: relative; flex: 1 1 100%; }
  .search svg {
    position: absolute;
    left: 12px;
    top: 50%;
    width: 16px;
    height: 16px;
    translate: 0 -50%;
    fill: none;
    stroke: var(--faint);
    stroke-width: 2.2;
    pointer-events: none;
  }
  .search input, .sort select {
    width: 100%;
    height: 40px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 14px;
    transition: border-color 0.18s ease;
  }
  .search input { padding: 0 12px 0 38px; }
  .search input::placeholder { color: var(--faint); }
  .search input:focus, .sort select:focus { outline: none; border-color: var(--accent); }

  .status-filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter-btn {
    min-height: 34px;
    padding: 0 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: border-color 0.18s ease, color 0.18s ease, background-color 0.18s ease;
  }
  .filter-btn:hover { border-color: var(--line-strong); color: var(--ink); }
  .filter-btn[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

  .filters__end { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .counter { color: var(--faint); font-size: 12px; font-weight: 700; white-space: nowrap; }
  .sort select { min-width: 190px; padding: 0 12px; font-size: 12px; font-weight: 700; color-scheme: dark; cursor: pointer; }

  .active-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 10px;
    border: 1px solid var(--accent);
    color: var(--muted);
    font-size: 12px;
  }
  .active-tag[hidden] { display: none; }
  .active-tag b { color: var(--accent); }
  .active-tag button { display: grid; place-items: center; width: 22px; height: 22px; }
  .active-tag svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.4; }

  .empty {
    margin-bottom: 32px;
    padding: 48px 20px;
    border: 1px dashed var(--line-strong);
    text-align: center;
  }
  .empty[hidden] { display: none; }
  .empty__title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; }
  .empty__text { margin: 8px 0 20px; color: var(--muted); }

  @media (min-width: 640px) { .search { flex: 0 1 260px; } }
  @media (max-width: 639px) {
    .filters { position: static; }
    .filters__end { width: 100%; }
    .sort { flex: 1; }
  }
</style>
