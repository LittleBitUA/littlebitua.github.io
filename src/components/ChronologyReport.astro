---
// ─── Chronology report ─────────────────────────────────────────
// Рендер одного звіту (див. src/lib/chronology.ts) у стилі решти сайту:
// шапка з підсумками-фільтрами, липка панель пошуку, розділи з нумерацією,
// роки й квартали як заголовки груп, картки подій із датою зліва.
// Виходи показуємо від найновіших до найстаріших.
import { reports, type Report, type Entry, type Item } from "../lib/chronology";
import { cover } from "../lib/cover";
import { liveNumbers } from "../lib/live";

export interface Props { report: Report; isLatest: boolean }
const { report, isLatest } = Astro.props;
const base = isLatest ? "/chronology/" : `/chronology/${report.date}/`;

// ── Підсумки (вони ж фільтри) ──
const count = (fn: (e: Entry) => boolean) => report.entries.filter(fn).length;
const FILTERS = [
  { value: "released", label: "Вийшли", n: count((e) => e.kind === "released") },
  { value: "ea", label: "Ранній доступ", n: count((e) => e.earlyAccess) },
  { value: "updated", label: "Оновлюються", n: count((e) => e.kind === "updated") },
  { value: "upcoming", label: "Ще не вийшли", n: count((e) => e.kind === "upcoming") },
  { value: "fund", label: "Зі збором", n: count((e) => e.fundraising) },
].filter((f) => f.n > 0);

const others = reports.filter((r) => r.date !== report.date);
const thumbs = new Map(
  await Promise.all(report.entries.filter((e) => e.game).map(async (e) => [e.id, await cover(e.game!.cover, 200)] as const)),
);

// ── Плоский список вузлів → групи «рік → квартал → події» ──
interface G2 { id: string | null; text: string | null; summary: string; entries: Entry[] }
interface G1 { id: string | null; text: string | null; summary: string; groups: G2[] }
function group(items: Item[]): G1[] {
  const out: G1[] = [];
  let g1: G1 | null = null;
  let g2: G2 | null = null;
  const top = () => (g1 ??= (out.push({ id: null, text: null, summary: "", groups: [] }), out.at(-1)!));
  for (const it of items) {
    if (it.kind === "node" && it.level === 1) {
      g1 = { id: it.id, text: it.text, summary: "", groups: [] };
      out.push(g1);
      g2 = null;
    } else if (it.kind === "node") {
      g2 = { id: it.id, text: it.text, summary: "", entries: [] };
      top().groups.push(g2);
    } else if (it.kind === "summary") {
      if (g2) g2.summary += it.html;
      else top().summary += it.html;
    } else {
      if (!g2) {
        g2 = { id: null, text: null, summary: "", entries: [] };
        top().groups.push(g2);
      }
      g2.entries.push(it.entry);
    }
  }
  return out;
}
// Найновіші вгорі; групи «дата не уточнена» лишаються в кінці свого року
const undated = (g: G2) => /не уточн/i.test(g.text ?? "");
function newestFirst(list: G1[]): G1[] {
  return [...list].reverse().map((g) => ({
    ...g,
    groups: [...g.groups.filter((x) => !undated(x)).reverse(), ...g.groups.filter(undated)].map((x) => ({
      ...x,
      // Події без дати (поточний стан проєктів) — після датованих
      entries: [...x.entries.filter((e) => e.date).reverse(), ...x.entries.filter((e) => !e.date)],
    })),
  }));
}
const sections = report.sections.map((s, i) => {
  const groups = group(s.items);
  const reversed = i === 0;
  return { ...s, num: String(i + 1).padStart(2, "0"), reversed, groups: reversed ? newestFirst(groups) : groups };
});

// ── Дрібниці для картки ──
const SHORT: Record<string, string> = {
  січня: "січ", лютого: "лют", березня: "бер", квітня: "кві", травня: "тра", червня: "чер",
  липня: "лип", серпня: "сер", вересня: "вер", жовтня: "жов", листопада: "лис", грудня: "гру",
};
const dayOf = (date: string | null) => {
  const m = date?.match(/^(\d{1,2})\s+(\S+)/);
  return m ? { d: m[1], m: SHORT[m[2].toLowerCase()] ?? m[2] } : null;
};
const statusOf = (e: Entry) =>
  /ранн\S* доступ/i.test(e.note ?? "") && e.kind !== "upcoming"
    ? { label: "Ранній доступ", cls: "ea" }
    : e.kind === "released"
      ? { label: "Вийшов", cls: "done" }
      : e.kind === "updated"
        ? { label: "Оновлюється", cls: "progress" }
        : { label: "Ще не вийшов", cls: "planned" };
// Позначку з заголовка не повторюємо, якщо вона збігається зі статусом
const noteOf = (e: Entry) => (e.note && !/^ранн\S* доступ$/i.test(e.note) ? e.note : null);
const liveOf = (e: Entry) => {
  const l = e.game ? liveNumbers(e.game, e.html) : null;
  return l && (l.differs || l.translation < 100 || (l.editing != null && l.editing < 100)) ? l : null;
};
---

<div class="page container chron">
  <nav aria-label="Навігація">
    <ol class="crumbs">
      <li><a href="/">Головна</a></li>
      <li class="sep" aria-hidden="true">/</li>
      {isLatest ? (
        <li aria-current="page">Хронологія</li>
      ) : (
        <>
          <li><a href="/chronology/">Хронологія</a></li>
          <li class="sep" aria-hidden="true">/</li>
          <li aria-current="page">{report.dateLabel}</li>
        </>
      )}
    </ol>
  </nav>

  {!isLatest && (
    <p class="archived">
      Це архівний звіт від {report.dateLabel}. <a href="/chronology/">Відкрити найсвіжіший →</a>
    </p>
  )}

  <header class="head">
    <span class="eyebrow">Хронологія · станом на {report.dateLabel}</span>
    <h1 class="title">Хронологія перекладів</h1>
    <p class="lead">
      Коли виходили українські переклади «Little Bit», що зараз оновлюється і що ще попереду — зі зборами коштів,
      учасниками й поточними відсотками з LBK Launcher.
    </p>
    {report.intro.slice(1).map((p) => <p class="callout" set:html={p} />)}
    {report.intro[0] && (
      <details class="howto">
        <summary>Як читати звіт</summary>
        <p set:html={report.intro[0]} />
      </details>
    )}
  </header>

  <!-- Підсумки звіту — водночас фільтри -->
  <ul class="kpi" role="group" aria-label="Підсумки звіту — натисніть, щоб відфільтрувати">
    {FILTERS.map((f) => (
      <li>
        <button type="button" class="kpi__btn" data-filter={f.value} aria-pressed="false">
          <strong>{f.n}</strong>
          <span>{f.label}</span>
        </button>
      </li>
    ))}
  </ul>

  <!-- Липка панель: пошук і фільтри -->
  <div class="tools" id="chron-tools">
    <label class="search">
      <span class="sr-only">Пошук у звіті</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-5-5m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <input id="chron-q" type="search" placeholder="Гра, учасник, інструмент…" autocomplete="off" />
    </label>
    <div class="chips" role="group" aria-label="Фільтр">
      <button type="button" class="chip-btn" data-filter="all" aria-pressed="true">Усі <b>{report.entries.length}</b></button>
      {FILTERS.map((f) => (
        <button type="button" class="chip-btn" data-filter={f.value} aria-pressed="false">{f.label} <b>{f.n}</b></button>
      ))}
    </div>
    <span class="count" id="chron-count" aria-live="polite"></span>
  </div>

  <div class="layout">
    <aside class="toc" aria-label="Зміст">
      <p class="toc__title">Зміст</p>
      <ol>
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`}><span>{s.num}</span>{s.title}</a>
            {s.groups.some((g) => g.id) && (
              <ol class="toc__sub">{s.groups.filter((g) => g.id).map((g) => <li><a href={`#${g.id}`}>{g.text}</a></li>)}</ol>
            )}
          </li>
        ))}
        {report.footnote && <li><a href="#note"><span>·</span>Про фінансові дані</a></li>}
        {others.length > 0 && <li><a href="#archive"><span>·</span>Архів звітів</a></li>}
      </ol>
    </aside>

    <div class="report">
      <p class="empty" id="chron-empty" hidden>Нічого не знайдено. Спробуйте інший запит або фільтр.</p>

      {sections.map((s) => (
        <section class="sec" id={s.id} data-sec>
          <header class="sec__head">
            <span class="sec__num">{s.num}</span>
            <h2>{s.title}</h2>
            {s.reversed && <p class="sec__hint">Найновіші — вгорі</p>}
          </header>
          {s.lead && <div class="sec__lead" set:html={s.lead} />}

          {s.groups.map((g1) => (
            <div class="g1" data-group>
              {g1.text && <h3 class="g1__title" id={g1.id}>{g1.text}</h3>}
              {g1.summary && <div class="summary" data-summary set:html={g1.summary} />}

              {g1.groups.map((g2) => (
                <div class="g2" data-group>
                  {g2.text && <p class="g2__title" id={g2.id}><span>{g2.text}</span></p>}
                  {g2.summary && <div class="summary" data-summary set:html={g2.summary} />}

                  <ol class="events">
                    {g2.entries.map((e) => {
                      const day = dayOf(e.date);
                      const st = statusOf(e);
                      const note = noteOf(e);
                      const live = liveOf(e);
                      return (
                        <li
                          class="ev"
                          id={e.id}
                          data-entry
                          data-kind={e.kind}
                          data-ea={e.earlyAccess ? "1" : ""}
                          data-fund={e.fundraising ? "1" : ""}
                          data-search={e.search}
                        >
                          <div class="ev__day" aria-hidden="true">
                            {day ? <><strong>{day.d}</strong><span>{day.m}</span></> : <span class="ev__nodate">—</span>}
                          </div>
                          <article class="ev__card c-panel">
                            {e.game ? (
                              <a class="ev__cover" href={`/games/${e.game.id}/`} tabindex="-1" aria-hidden="true">
                                <img src={thumbs.get(e.id) ?? e.game.cover} alt="" width="84" height="126" loading="lazy" decoding="async" />
                              </a>
                            ) : (
                              <span class="ev__cover ev__cover--empty" aria-hidden="true"></span>
                            )}
                            <div class="ev__body">
                              <div class="ev__meta">
                                <span class={`badge badge--${st.cls}`}><i aria-hidden="true"></i>{st.label}</span>
                                {e.date && <span class="ev__date">{e.date}</span>}
                                {note && <span class="ev__note">{note}</span>}
                                {e.fundraising && <span class="ev__note ev__note--fund">Збір коштів</span>}
                              </div>
                              <h4 class="ev__title">
                                {e.game ? <a href={`/games/${e.game.id}/`}>{e.title}</a> : e.title}
                              </h4>
                              <div class="ev__text" data-clamp set:html={e.html} />
                              <div class="ev__foot">
                                {live && (
                                  <div class="live" title="Свіжі цифри з LBK Launcher; текст звіту міг бути написаний раніше">
                                    <span class="live__tag">Зараз</span>
                                    <span class="live__row"><em>переклад</em><i class="live__bar"><i style={`width:${live.translation}%`}></i></i><b>{live.translation}%</b></span>
                                    {live.editing != null && (
                                      <span class="live__row live__row--ed"><em>редактура</em><i class="live__bar"><i style={`width:${live.editing}%`}></i></i><b>{live.editing}%</b></span>
                                    )}
                                  </div>
                                )}
                                <span class="ev__actions">
                                  <button type="button" class="ev__more" data-more hidden>Докладніше</button>
                                  <button type="button" class="ev__copy" data-copy={`${base}#${e.id}`} aria-label={`Скопіювати посилання на «${e.title}»`}>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1" /></svg>
                                    <span>Посилання</span>
                                  </button>
                                </span>
                              </div>
                            </div>
                          </article>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              ))}
            </div>
          ))}
        </section>
      ))}

      {report.footnote && (
        <aside class="note" id="note">
          <p class="note__title">Про фінансові дані</p>
          <div set:html={report.footnote} />
        </aside>
      )}

      {others.length > 0 && (
        <section class="archive" id="archive">
          <h2 class="archive__title">Архів звітів</h2>
          <p class="archive__lead">Попередні версії звіту — щоб побачити, як змінювалися плани й цифри.</p>
          <ul>
            {reports.map((r, i) => (
              <li>
                <a href={i === 0 ? "/chronology/" : `/chronology/${r.date}/`} aria-current={r.date === report.date ? "page" : undefined}>
                  {r.dateLabel.replace(/ року$/, "")}
                  {i === 0 && <small>найсвіжіший</small>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</div>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const input = $<HTMLInputElement>("chron-q");
  const count = $("chron-count");
  const empty = $("chron-empty");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const entries = Array.from(document.querySelectorAll<HTMLElement>("[data-entry]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-sec]"));
  const summaries = Array.from(document.querySelectorAll<HTMLElement>("[data-summary]"));

  const params = new URLSearchParams(location.search);
  const state = { filter: params.get("f") ?? "all", q: params.get("q") ?? "" };

  const matches = (el: HTMLElement) => {
    const d = el.dataset;
    const byFilter =
      state.filter === "all" ||
      (state.filter === "ea" && d.ea === "1") ||
      (state.filter === "fund" && d.fund === "1") ||
      d.kind === state.filter;
    const words = state.q.toLowerCase().trim().split(/\s+/).filter(Boolean);
    return byFilter && words.every((w) => (d.search ?? "").includes(w));
  };

  function apply() {
    const active = state.filter !== "all" || state.q.trim() !== "";
    let shown = 0;
    for (const el of entries) {
      const ok = matches(el);
      el.hidden = !ok;
      if (ok) shown++;
      // Під час пошуку показуємо текст повністю — збіг може бути в прихованій частині
      el.classList.toggle("is-open", ok && state.q.trim() !== "");
    }
    // Рік, квартал і розділ показуємо, лише якщо в них лишилися видимі події
    for (const g of [...groups].reverse()) g.hidden = !g.querySelector("[data-entry]:not([hidden])");
    for (const sec of sections) sec.hidden = !sec.querySelector("[data-entry]:not([hidden])");
    summaries.forEach((s) => (s.hidden = active));
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === state.filter)));
    if (count) count.textContent = active ? `${shown} з ${entries.length}` : "";
    if (empty) empty.hidden = shown > 0;
    markClamped();

    const p = new URLSearchParams();
    if (state.filter !== "all") p.set("f", state.filter);
    if (state.q.trim()) p.set("q", state.q.trim());
    const qs = p.toString();
    history.replaceState(null, "", (qs ? `?${qs}` : location.pathname) + location.hash);
  }

  // «Докладніше» — лише там, де текст справді обрізано
  function markClamped() {
    for (const el of entries) {
      if (el.hidden) continue;
      const text = el.querySelector<HTMLElement>("[data-clamp]");
      const more = el.querySelector<HTMLButtonElement>("[data-more]");
      if (!text || !more) continue;
      const open = el.classList.contains("is-open");
      more.hidden = !open && text.scrollHeight <= text.clientHeight + 2;
      more.textContent = open ? "Згорнути" : "Докладніше";
    }
  }
  document.querySelectorAll<HTMLButtonElement>("[data-more]").forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.closest("[data-entry]")?.classList.toggle("is-open");
      markClamped();
    });
  });

  if (input) {
    input.value = state.q;
    let t: ReturnType<typeof setTimeout>;
    input.addEventListener("input", () => {
      clearTimeout(t);
      t = setTimeout(() => { state.q = input.value; apply(); }, 150);
    });
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const v = b.dataset.filter ?? "all";
      // Повторне натискання на підсумок знімає фільтр
      state.filter = state.filter === v ? "all" : v;
      apply();
      if (b.classList.contains("kpi__btn")) $("chron-tools")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }),
  );
  // Перехід за якорем на картку — розгорнути її
  const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
  if (target && target.dataset.entry !== undefined) target.classList.add("is-open");
  apply();
  window.addEventListener("resize", () => markClamped(), { passive: true });

  // Копіювання посилання на картку
  document.querySelectorAll<HTMLButtonElement>(".ev__copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = new URL(btn.dataset.copy ?? "", location.origin).toString();
      const label = btn.querySelector("span");
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = "Скопійовано";
      } catch {
        if (label) label.textContent = "Не вдалося";
      }
      history.replaceState(null, "", url.replace(location.origin, ""));
      setTimeout(() => { if (label) label.textContent = "Посилання"; }, 1600);
    });
  });
</script>

<style>
  /* Сховані фільтром елементи мають display у своїх стилях — hidden має перемагати */
  .chron [hidden] { display: none !important; }

  /* ── Шапка ── */
  .archived {
    margin-top: 20px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }
  .archived a { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .head { margin: 24px 0 28px; }
  .title { margin-top: 10px; font-size: clamp(2rem, 5vw, 3.75rem); letter-spacing: -0.02em; }
  .lead { max-width: 68ch; margin-top: 14px; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .callout { max-width: 68ch; margin-top: 12px; color: var(--faint); font-size: 14px; line-height: 1.6; }
  .howto { max-width: 78ch; margin-top: 14px; color: var(--muted); font-size: 14px; line-height: 1.65; }
  .howto summary { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); font-weight: 600; cursor: pointer; list-style: none; }
  .howto summary::-webkit-details-marker { display: none; }
  .howto summary::after { content: "+"; color: var(--faint); font-weight: 500; }
  .howto[open] summary::after { content: "−"; }
  .howto p { margin-top: 10px; }

  /* ── Підсумки-фільтри ── */
  .kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .kpi li + li { border-left: 1px solid var(--line); }
  .kpi__btn { display: grid; gap: 8px; width: 100%; height: 100%; padding: 22px 20px; text-align: left; transition: background-color 0.18s ease; }
  .kpi li:first-child .kpi__btn { padding-left: 0; }
  .kpi__btn:hover { background: rgba(255, 255, 255, 0.04); }
  .kpi__btn strong { font-size: clamp(1.9rem, 3.4vw, 2.7rem); font-weight: 700; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .kpi__btn span { color: var(--muted); font-size: 13px; }
  .kpi__btn[aria-pressed="true"] strong, .kpi__btn[aria-pressed="true"] span { color: var(--ink); }
  .kpi__btn[aria-pressed="true"] span { text-decoration: underline; text-underline-offset: 4px; }

  /* ── Липка панель ── */
  .tools {
    position: sticky;
    top: calc(var(--header-h) - 4px);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 28px;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--tint) 30%, rgba(14, 12, 18, 0.86));
    border: 1px solid var(--glass-line);
    border-radius: 9999px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .search { position: relative; flex: 0 1 280px; }
  .search svg { position: absolute; left: 12px; top: 50%; width: 16px; height: 16px; translate: 0 -50%; fill: none; stroke: var(--faint); stroke-width: 2.2; pointer-events: none; }
  .search input {
    width: 100%;
    height: 38px;
    padding: 0 12px 0 38px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--line);
    border-radius: 9999px;
