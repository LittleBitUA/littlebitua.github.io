---
// ─── Chronology report ─────────────────────────────────────────
// Рендер одного звіту (див. src/lib/chronology.ts) у стилі решти сайту:
// шапка з підсумками-фільтрами, липка панель пошуку, розділи з нумерацією,
// роки й квартали як заголовки груп, картки подій із датою зліва.
// Виходи показуємо від найновіших до найстаріших.
import { reports, withoutMissingCrew, type Report, type Entry, type Item } from "../lib/chronology";
import { cover } from "../lib/cover";
import { liveNumbers } from "../lib/live";
import PersonAvatar from "./PersonAvatar.astro";
import { PEOPLE } from "../data/people";
import { games as catalog } from "../data/catalog";
import { telegramPosts } from "../lib/telegram";
import { artOf } from "../lib/art";
import { stagesOf, stageName, translationPercent, formatPct } from "../utils/status";

export interface Props { report: Report; isLatest: boolean }
const { report, isLatest } = Astro.props;
const base = isLatest ? "/chronology/" : `/chronology/${report.date}/`;

// ── Підсумки (вони ж фільтри) ──
const count = (fn: (e: Entry) => boolean) => report.entries.filter(fn).length;
const FILTERS = [
  { value: "released", label: "Вийшли", n: count((e) => e.kind === "released") },
  { value: "ea", label: "Ранній доступ", n: count((e) => e.earlyAccess) },
  { value: "updated", label: "Оновлюються", n: count((e) => e.kind === "updated") },
  { value: "upcoming", label: "Ще не вийшли", n: count((e) => e.kind === "upcoming") },
  { value: "fund", label: "Зі збором", n: count((e) => e.fundraising) },
].filter((f) => f.n > 0);

const others = reports.filter((r) => r.date !== report.date);
const thumbs = new Map(
  await Promise.all(report.entries.filter((e) => e.game).map(async (e) => [e.id, await cover(e.game!.cover, 200)] as const)),
);

// ── Плоский список вузлів → групи «рік → квартал → події» ──
interface G2 { id: string | null; text: string | null; summary: string; entries: Entry[] }
interface G1 { id: string | null; text: string | null; summary: string; groups: G2[] }
function group(items: Item[]): G1[] {
  const out: G1[] = [];
  let g1: G1 | null = null;
  let g2: G2 | null = null;
  const top = () => (g1 ??= (out.push({ id: null, text: null, summary: "", groups: [] }), out.at(-1)!));
  for (const it of items) {
    if (it.kind === "node" && it.level === 1) {
      g1 = { id: it.id, text: it.text, summary: "", groups: [] };
      out.push(g1);
      g2 = null;
    } else if (it.kind === "node") {
      g2 = { id: it.id, text: it.text, summary: "", entries: [] };
      top().groups.push(g2);
    } else if (it.kind === "summary") {
      if (g2) g2.summary += it.html;
      else top().summary += it.html;
    } else {
      if (!g2) {
        g2 = { id: null, text: null, summary: "", entries: [] };
        top().groups.push(g2);
      }
      g2.entries.push(it.entry);
    }
  }
  return out;
}
// Найновіші вгорі; групи «дата не уточнена» лишаються в кінці свого року
const undated = (g: G2) => /не уточн/i.test(g.text ?? "");
function newestFirst(list: G1[]): G1[] {
  return [...list].reverse().map((g) => ({
    ...g,
    groups: [...g.groups.filter((x) => !undated(x)).reverse(), ...g.groups.filter(undated)].map((x) => ({
      ...x,
      // Події без дати (поточний стан проєктів) — після датованих
      entries: [...x.entries.filter((e) => e.date).reverse(), ...x.entries.filter((e) => !e.date)],
    })),
  }));
}
const sections = report.sections.map((s, i) => {
  const groups = group(s.items);
  const reversed = i === 0;
  // «Ще не вийшли» — дошка прогресу: найготовіші вгорі
  const board = s.items.some((it) => it.kind === "entry" && it.entry.kind === "upcoming");
  const ready = (e: Entry) => (e.game ? translationPercent(e.game) : -1);
  const sorted = board ? groups.map((g) => ({ ...g, groups: g.groups.map((x) => ({ ...x, entries: [...x.entries].sort((a, b) => ready(b) - ready(a)) })) })) : groups;
  return { ...s, num: String(i + 1).padStart(2, "0"), reversed, board, groups: reversed ? newestFirst(sorted) : sorted };
});

// ── Дрібниці для картки ──
const SHORT: Record<string, string> = {
  січня: "січ", лютого: "лют", березня: "бер", квітня: "кві", травня: "тра", червня: "чер",
  липня: "лип", серпня: "сер", вересня: "вер", жовтня: "жов", листопада: "лис", грудня: "гру",
};
const dayOf = (date: string | null) => {
  const m = date?.match(/^(\d{1,2})\s+(\S+)/);
  return m ? { d: m[1], m: SHORT[m[2].toLowerCase()] ?? m[2] } : null;
};
const statusOf = (e: Entry) =>
  /ранн\S* доступ/i.test(e.note ?? "") && e.kind !== "upcoming"
    ? { label: "Ранній доступ", cls: "ea" }
    : e.kind === "released"
      ? { label: "Вийшов", cls: "done" }
      : e.kind === "updated"
        ? { label: "Оновлюється", cls: "progress" }
        : { label: "Ще не вийшов", cls: "planned" };
// Позначку з заголовка не повторюємо, якщо вона збігається зі статусом
const noteOf = (e: Entry) => (e.note && !/^ранн\S* доступ$/i.test(e.note) ? e.note : null);
const liveOf = (e: Entry) => {
  const l = e.game ? liveNumbers(e.game, e.html) : null;
  return l && (l.differs || stagesOf(e.game!).some((x) => x.percent < 100)) ? l : null;
};

// ── Точні дати виходів (рік беремо з заголовка року в першому розділі) ──
const MONTH_NUM = Object.fromEntries(Object.keys(SHORT).map((m, i) => [m, i + 1]));
const isoOf = new Map<string, string>();
{
  let year = "";
  for (const it of report.sections[0]?.items ?? []) {
    if (it.kind === "node" && it.level === 1) year = it.text.match(/\d{4}/)?.[0] ?? year;
    if (it.kind !== "entry" || !year || !it.entry.date) continue;
    const m = it.entry.date.match(/^(\d{1,2})\s+(\S+)/);
    const mon = m && MONTH_NUM[m[2].toLowerCase()];
    if (mon) isoOf.set(it.entry.id, `${year}-${String(mon).padStart(2, "0")}-${m![1].padStart(2, "0")}`);
  }
}
const dayNum = (iso: string) => Date.parse(`${iso}T12:00:00Z`) / 864e5;

// ── Учасники з титрів сайту ──
const crewOf = (e: Entry) => (e.game ? PEOPLE.filter((p) => p.credits.some((c) => c.game === e.game!.id)) : []);

// ── Пост у Telegram про цей вихід (± 3 дні від дати) ──
const posts = isLatest ? await telegramPosts(catalog) : [];
// Якщо точного поста серед свіжих немає — пошук по каналу за назвою гри
const tgOf = (e: Entry) => {
  if (!e.game) return null;
  const iso = isoOf.get(e.id);
  const exact = iso ? posts.find((p) => p.game.id === e.game!.id && Math.abs(dayNum(p.date) - dayNum(iso)) <= 3) : null;
  if (exact) return { url: exact.url, title: exact.title, label: "Анонс" };
  const q = e.game.title.split(/[:™®]/)[0].trim();
  return { url: `https://t.me/s/LittleBitUA?q=${encodeURIComponent(q)}`, title: `Пости про ${q} у Telegram-каналі`, label: "У Telegram" };
};

// ── Що змінилося з попереднього звіту ──
const prev = reports[reports.findIndex((r) => r.date === report.date) + 1];
const keyOf = (e: Entry) => e.game?.id ?? e.id;
const plainOf = (h: string) => h.replace(/<[^>]+>/g, "");
const pctOf = (h: string) => {
  const t = plainOf(h);
  const tr = t.match(/перекладено(?: на)?\s*(?:приблизно\s*)?(\d+(?:,\d+)?)\s*%/i)?.[1];
  const ed = t.match(/редакту?р[а-яі]*[^.;\d]{0,30}?(\d+(?:,\d+)?)\s*%/i)?.[1];
  return { t: tr ? Math.round(parseFloat(tr.replace(",", "."))) : null, e: ed ? Math.round(parseFloat(ed.replace(",", "."))) : null };
};
const diff = (() => {
  if (!prev) return null;
  const before = new Map<string, Entry>();
  for (const e of prev.entries) before.set(keyOf(e), e);
  const released: Entry[] = [], added: Entry[] = [], moved: { e: Entry; parts: string[] }[] = [];
  const seen = new Set<string>();
  for (const e of [...report.entries].reverse()) {
    const k = keyOf(e);
    if (seen.has(k)) continue;
    seen.add(k);
    const b = before.get(k);
    if (!b) { (e.kind === "released" ? released : added).push(e); continue; }
    if (e.kind === "released" && b.kind !== "released") { released.push(e); continue; }
    const x = pctOf(b.html), y = pctOf(e.html), parts: string[] = [];
    if (x.t != null && y.t != null && y.t > x.t) parts.push(`переклад ${x.t} → ${y.t}%`);
    if (x.e != null && y.e != null && y.e > x.e) parts.push(`редактура ${x.e} → ${y.e}%`);
    if (parts.length) moved.push({ e, parts });
  }
  return released.length + added.length + moved.length ? { released, added, moved } : null;
})();

// ── Останній вихід — великою карткою ──
const latestEntry = [...isoOf.entries()].sort((a, b) => b[1].localeCompare(a[1])).map(([id]) => report.entries.find((e) => e.id === id && e.game)).find(Boolean) ?? null;
const latestArt = latestEntry?.game ? await artOf(latestEntry.game) : null;

// ── Ритм виходів: місяці з першого датованого виходу до звіту ──
const dated = [...isoOf.entries()].map(([id, iso]) => ({ e: report.entries.find((x) => x.id === id)!, iso })).filter((x) => x.e);
const months: { key: string; label: string; items: typeof dated }[] = [];
if (dated.length) {
  let [y, m] = dated.map((d) => d.iso).sort()[0].split("-").map(Number);
  const [ty, tm] = report.date.split("-").map(Number);
  while (y < ty || (y === ty && m <= tm)) {
    const key = `${y}-${String(m).padStart(2, "0")}`;
    months.push({ key, label: `${Object.values(SHORT)[m - 1]}${m === 1 ? ` ’${String(y).slice(2)}` : ""}`, items: dated.filter((d) => d.iso.startsWith(key)) });
    if (++m > 12) { m = 1; y++; }
  }
}

// ── Режим «за іграми»: усі записи про гру в одній картці ──
const byGame = new Map<string, Entry[]>();
for (const e of report.entries) byGame.set(keyOf(e), [...(byGame.get(keyOf(e)) ?? []), e]);
const gameCards = [...byGame.values()]
  .map((list) => {
    const sorted = [...list].sort((a, b) => (isoOf.get(a.id) ?? "").localeCompare(isoOf.get(b.id) ?? ""));
    return { list: sorted, last: sorted.at(-1)!, iso: sorted.map((e) => isoOf.get(e.id)).filter(Boolean).at(-1) ?? "" };
  })
  .sort((a, b) => b.iso.localeCompare(a.iso) || translationPercent(b.last.game ?? ({ progress: 0 } as never)) - translationPercent(a.last.game ?? ({ progress: 0 } as never)));

const shortDate = (iso: string) => `${+iso.slice(8, 10)} ${Object.keys(SHORT)[+iso.slice(5, 7) - 1]} ${iso.slice(0, 4)}`;
---

<div class="page container chron">
  <nav aria-label="Навігація">
    <ol class="crumbs">
      <li><a href="/">Головна</a></li>
      <li class="sep" aria-hidden="true">/</li>
      {isLatest ? (
        <li aria-current="page">Хронологія</li>
      ) : (
        <>
          <li><a href="/chronology/">Хронологія</a></li>
          <li class="sep" aria-hidden="true">/</li>
          <li aria-current="page">{report.dateLabel}</li>
        </>
      )}
    </ol>
  </nav>

  {!isLatest && (
    <p class="archived">
      Це архівний звіт від {report.dateLabel}. <a href="/chronology/">Відкрити найсвіжіший →</a>
    </p>
  )}

  <header class="head">
    <div class="head__top">
      <span class="eyebrow">Хронологія · станом на {report.dateLabel}</span>
      {reports.length > 1 && (
        <label class="pick">
          <span>Звіт</span>
          <select id="chron-archive" aria-label="Обрати звіт">
            {reports.map((r, i) => (
              <option value={i === 0 ? "/chronology/" : `/chronology/${r.date}/`} selected={r.date === report.date}>
                {r.dateLabel.replace(/ року$/, "")}{i === 0 ? " · найсвіжіший" : ""}
              </option>
            ))}
          </select>
        </label>
      )}
    </div>
    <h1 class="title">Хронологія перекладів</h1>
    <p class="lead">
      Коли виходили українські переклади «Little Bit», що зараз оновлюється і що ще попереду — зі зборами коштів,
      учасниками й поточними відсотками з LBK Launcher.
    </p>
    {report.intro.slice(1).map((p) => <p class="callout" set:html={p} />)}
    {report.intro[0] && (
      <details class="howto">
        <summary>Як читати звіт</summary>
        <p set:html={report.intro[0]} />
      </details>
    )}
  </header>

  <!-- Підсумки звіту — водночас фільтри -->
  <ul class="kpi" role="group" aria-label="Підсумки звіту — натисніть, щоб відфільтрувати">
    {FILTERS.map((f) => (
      <li>
        <button type="button" class="kpi__btn" data-filter={f.value} aria-pressed="false">
          <strong>{f.n}</strong>
          <span>{f.label}</span>
        </button>
      </li>
    ))}
  </ul>

  {diff && prev && (
    <section class="diff" aria-labelledby="diff-title">
      <h2 id="diff-title" class="diff__title">Що змінилося з {prev.dateLabel.replace(/ року$/, "")}</h2>
      <div class="diff__cols">
        {diff.released.length > 0 && (
          <div>
            <p class="diff__label"><i style="background:var(--st-done)"></i>Вийшли · {diff.released.length}</p>
            <ul>{diff.released.map((e) => <li><a href={`#${e.id}`}>{e.title}</a>{e.date && <small>{e.date}</small>}</li>)}</ul>
          </div>
        )}
        {diff.moved.length > 0 && (
          <div>
            <p class="diff__label"><i style="background:var(--st-progress)"></i>Просунулися · {diff.moved.length}</p>
            <ul>{diff.moved.map(({ e, parts }) => <li><a href={`#${e.id}`}>{e.title}</a><small>{parts.join(" · ")}</small></li>)}</ul>
          </div>
        )}
        {diff.added.length > 0 && (
          <div>
            <p class="diff__label"><i style="background:var(--st-early)"></i>Нові у звіті · {diff.added.length}</p>
            <ul>{diff.added.map((e) => <li><a href={`#${e.id}`}>{e.title}</a></li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Липка панель: пошук і фільтри -->
  <div class="tools" id="chron-tools">
    <label class="search">
      <span class="sr-only">Пошук у звіті</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-5-5m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <input id="chron-q" type="search" placeholder="Гра, учасник, інструмент…" autocomplete="off" />
    </label>
    <div class="chips" role="group" aria-label="Фільтр">
      <button type="button" class="chip-btn" data-filter="all" aria-pressed="true">Усі <b>{report.entries.length}</b></button>
      {FILTERS.map((f) => (
        <button type="button" class="chip-btn" data-filter={f.value} aria-pressed="false">{f.label} <b>{f.n}</b></button>
      ))}
    </div>
    <span class="count" id="chron-count" aria-live="polite"></span>
    <div class="views" role="group" aria-label="Вигляд">
      <button type="button" data-view="dates" aria-pressed="true">За датами</button>
      <button type="button" data-view="games" aria-pressed="false">За іграми</button>
    </div>
  </div>

  <div class="layout">
    <aside class="toc" aria-label="Зміст">
      <p class="toc__title">Зміст</p>
      <ol>
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`}><span>{s.num}</span>{s.title}</a>
            {s.groups.some((g) => g.id) && (
              <ol class="toc__sub">{s.groups.filter((g) => g.id).map((g) => <li><a href={`#${g.id}`}>{g.text}</a></li>)}</ol>
            )}
          </li>
        ))}
        {report.footnote && <li><a href="#note"><span>·</span>Про фінансові дані</a></li>}
        {others.length > 0 && <li><a href="#archive"><span>·</span>Архів звітів</a></li>}
      </ol>
    </aside>

    <div class="report">
      <p class="empty" id="chron-empty" hidden>Нічого не знайдено. Спробуйте інший запит або фільтр.</p>

      {latestEntry && latestEntry.game && (
        <article class="hero" data-intro>
          {(latestArt?.bannerLow || latestArt?.banner) && <img class="hero__bg" src={latestArt.bannerLow ?? latestArt.banner!} alt="" loading="lazy" decoding="async" />}
          <div class="hero__body">
            <span class="hero__label">Останній вихід · {latestEntry.date}</span>
            <h2 class="hero__title">{latestEntry.title}</h2>
            <div class="hero__actions">
              <a class="c-btn" href={`/games/${latestEntry.game.id}/`}>Сторінка гри</a>
              <a class="hero__link" href={`#${latestEntry.id}`}>Читати у звіті ↓</a>
            </div>
          </div>
        </article>
      )}

      {months.length > 1 && (
        <figure class="rhythm" data-intro>
          <figcaption>Ритм виходів <span>кожна крапка — вихід; натисніть, щоб перейти</span></figcaption>
          <ol>
            {months.map((m) => (
              <li class:list={{ "is-empty": !m.items.length }}>
                <span class="rhythm__dots">
                  {m.items.map((d) => (
                    <a href={`#${d.e.id}`} title={`${d.e.date} — ${d.e.title}`} style={`--state:${/ранн\S* доступ/i.test(d.e.note ?? "") ? "var(--st-early)" : "var(--st-done)"}`}></a>
                  ))}
                </span>
                <small>{m.label}</small>
              </li>
            ))}
          </ol>
        </figure>
      )}

      <div id="view-dates">
      {sections.map((s) => (
        <section class="sec" id={s.id} data-sec>
          <header class="sec__head">
            <span class="sec__num">{s.num}</span>
            <h2>{s.title}</h2>
            {s.reversed && <p class="sec__hint">Найновіші — вгорі</p>}
          </header>
          {s.lead && <div class="sec__lead" set:html={s.lead} />}

          {s.groups.map((g1) => (
            <div class="g1" data-group>
              {g1.text && <h3 class="g1__title" id={g1.id}>{g1.text}</h3>}
              {g1.summary && <div class="summary" data-summary set:html={g1.summary} />}

              {g1.groups.map((g2) => (
                <div class="g2" data-group>
                  {g2.text && <p class="g2__title" id={g2.id}><span>{g2.text}</span></p>}
                  {g2.summary && <div class="summary" data-summary set:html={g2.summary} />}

                  <ol class="events">
                    {g2.entries.map((e) => {
                      const day = dayOf(e.date);
                      const st = statusOf(e);
                      const note = noteOf(e);
                      const live = liveOf(e);
                      const crew = crewOf(e);
                      const tg = tgOf(e);
                      const stages = s.board && e.game ? stagesOf(e.game) : null;
                      return (
                        <li
                          class="ev"
                          id={e.id}
                          data-entry
                          data-kind={e.kind}
                          data-ea={e.earlyAccess ? "1" : ""}
                          data-fund={e.fundraising ? "1" : ""}
                          data-search={e.search}
                        >
                          <div class="ev__day" aria-hidden="true">
                            {day ? <><strong>{day.d}</strong><span>{day.m}</span></> : <span class="ev__nodate">—</span>}
                          </div>
                          <article class="ev__card c-panel">
                            {e.game ? (
                              <a class="ev__cover" href={`/games/${e.game.id}/`} tabindex="-1" aria-hidden="true">
                                <img src={thumbs.get(e.id) ?? e.game.cover} alt="" width="84" height="126" loading="lazy" decoding="async" />
                              </a>
                            ) : (
                              <span class="ev__cover ev__cover--empty" aria-hidden="true"></span>
                            )}
                            <div class="ev__body">
                              <div class="ev__meta">
                                <span class={`badge badge--${st.cls}`}><i aria-hidden="true"></i>{st.label}</span>
                                {e.date && <span class="ev__date">{e.date}</span>}
                                {note && <span class="ev__note">{note}</span>}
                                {e.fundraising && <span class="ev__note ev__note--fund">Збір коштів</span>}
                              </div>
                              <h4 class="ev__title">
                                {e.game ? <a href={`/games/${e.game.id}/`}>{e.title}</a> : e.title}
                              </h4>
                              {stages && (
                                <ul class="board">
                                  {stages.map((x) => (
                                    <li class={x.percent >= 100 ? "is-done" : x.percent > 0 ? "is-active" : "is-todo"}>
                                      <em>{stageName(x.label)}</em>
                                      <i class="board__bar"><i style={`width:${x.percent}%`}></i></i>
                                      <b>{x.percent > 0 ? `${formatPct(Math.round(x.percent))}%` : "—"}</b>
                                    </li>
                                  ))}
                                </ul>
                              )}
                              <div class="ev__text" data-clamp set:html={crew.length ? withoutMissingCrew(e.html) : e.html} />
                              {crew.length > 0 && (
                                <div class="crew">
                                  {crew.slice(0, 8).map((p) => <a href={`/team/${p.slug}/`} title={p.name}><PersonAvatar name={p.name} slug={p.slug} size={26} /></a>)}
                                  {crew.length > 8 && <span>+{crew.length - 8}</span>}
                                </div>
                              )}
                              <div class="ev__foot">
                                {live && !stages && (
                                  <div class="live" title="Свіжі цифри з LBK Launcher; текст звіту міг бути написаний раніше">
                                    <span class="live__tag">Зараз</span>
                                    {stagesOf(e.game!).map((x) => (
                                      <span class:list={["live__row", { "live__row--ed": /редакт/i.test(x.label), "live__row--art": /текстур|шрифт/i.test(x.label) }]}>
                                        <em>{stageName(x.label).toLowerCase()}</em><i class="live__bar"><i style={`width:${x.percent}%`}></i></i><b>{x.percent > 0 ? `${Math.round(x.percent)}%` : "—"}</b>
                                      </span>
                                    ))}
                                  </div>
                                )}
                                <span class="ev__actions">
                                  <button type="button" class="ev__more" data-more hidden>Докладніше</button>
                                  {tg && (
                                    <a class="ev__tg" href={tg.url} target="_blank" rel="noopener noreferrer" title={tg.title}>
                                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 4 3 11l6 2 2 6 3-4 5 4z" /><path d="m9 13 12-9" /></svg>
                                      <span>{tg.label}</span>
                                    </a>
                                  )}
                                  <button type="button" class="ev__copy" data-copy={`${base}#${e.id}`} aria-label={`Скопіювати посилання на «${e.title}»`}>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1M14 10a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1" /></svg>
                                    <span>Посилання</span>
                                  </button>
                                </span>
                              </div>
                            </div>
                          </article>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              ))}
            </div>
          ))}
        </section>
      ))}

      </div>

      <div id="view-games" class="gview" hidden>
        {gameCards.map(({ list, last }) => {
          const st = statusOf(last);
          const crew = crewOf(last);
          return (
            <article
              class="gcard c-panel"
              data-entry
              data-kind={last.kind}
              data-ea={list.some((e) => e.earlyAccess) ? "1" : ""}
              data-fund={list.some((e) => e.fundraising) ? "1" : ""}
              data-search={list.map((e) => e.search).join(" ")}
            >
              {last.game ? (
                <a class="ev__cover" href={`/games/${last.game.id}/`} tabindex="-1" aria-hidden="true">
                  <img src={thumbs.get(last.id) ?? last.game.cover} alt="" width="84" height="126" loading="lazy" decoding="async" />
                </a>
              ) : <span class="ev__cover ev__cover--empty" aria-hidden="true"></span>}
              <div class="ev__body">
                <div class="ev__meta"><span class={`badge badge--${st.cls}`}><i aria-hidden="true"></i>{st.label}</span></div>
                <h4 class="ev__title">{last.game ? <a href={`/games/${last.game.id}/`}>{last.title}</a> : last.title}</h4>
                <ol class="gcard__events">
                  {list.map((e) => (
                    <li>
                      <span>{isoOf.get(e.id) ? shortDate(isoOf.get(e.id)!) : "без дати"}</span>
                      <a href={`#${e.id}`} data-goto-dates>{statusOf(e).label}{noteOf(e) ? ` · ${noteOf(e)}` : ""}</a>
                    </li>
                  ))}
                </ol>
                <div class="ev__text" data-clamp set:html={crew.length ? withoutMissingCrew(last.html) : last.html} />
                {crew.length > 0 && (
                  <div class="crew">
                    {crew.slice(0, 8).map((p) => <a href={`/team/${p.slug}/`} title={p.name}><PersonAvatar name={p.name} slug={p.slug} size={26} /></a>)}
                    {crew.length > 8 && <span>+{crew.length - 8}</span>}
                  </div>
                )}
                <div class="ev__foot"><span class="ev__actions"><button type="button" class="ev__more" data-more hidden>Докладніше</button></span></div>
              </div>
            </article>
          );
        })}
      </div>

      {report.footnote && (
        <aside class="note" id="note">
          <p class="note__title">Про фінансові дані</p>
          <div set:html={report.footnote} />
        </aside>
      )}

      {others.length > 0 && (
        <section class="archive" id="archive">
          <h2 class="archive__title">Архів звітів</h2>
          <p class="archive__lead">Попередні версії звіту — щоб побачити, як змінювалися плани й цифри.</p>
          <ul>
            {reports.map((r, i) => (
              <li>
                <a href={i === 0 ? "/chronology/" : `/chronology/${r.date}/`} aria-current={r.date === report.date ? "page" : undefined}>
                  {r.dateLabel.replace(/ року$/, "")}
                  {i === 0 && <small>найсвіжіший</small>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</div>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const input = $<HTMLInputElement>("chron-q");
  const count = $("chron-count");
  const empty = $("chron-empty");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const entries = Array.from(document.querySelectorAll<HTMLElement>("[data-entry]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-sec]"));
  const summaries = Array.from(document.querySelectorAll<HTMLElement>("[data-summary]"));
  const intros = Array.from(document.querySelectorAll<HTMLElement>("[data-intro]"));
  const viewDates = $("view-dates");
  const viewGames = $("view-games");
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view]"));

  const params = new URLSearchParams(location.search);
  const state = { filter: params.get("f") ?? "all", q: params.get("q") ?? "", view: params.get("v") === "games" ? "games" : "dates" };
  const inView = (el: HTMLElement) => (state.view === "games" ? viewGames : viewDates)?.contains(el) ?? true;

  const matches = (el: HTMLElement) => {
    const d = el.dataset;
    const byFilter =
      state.filter === "all" ||
      (state.filter === "ea" && d.ea === "1") ||
      (state.filter === "fund" && d.fund === "1") ||
      d.kind === state.filter;
    const words = state.q.toLowerCase().trim().split(/\s+/).filter(Boolean);
    return byFilter && words.every((w) => (d.search ?? "").includes(w));
  };

  function apply() {
    const active = state.filter !== "all" || state.q.trim() !== "";
    let shown = 0;
    if (viewDates) viewDates.hidden = state.view !== "dates";
    if (viewGames) viewGames.hidden = state.view !== "games";
    viewButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === state.view)));
    intros.forEach((el) => (el.hidden = active || state.view !== "dates"));
    for (const el of entries) {
      const ok = matches(el);
      el.hidden = !ok;
      if (ok && inView(el)) shown++;
      // Під час пошуку показуємо текст повністю — збіг може бути в прихованій частині
      el.classList.toggle("is-open", ok && state.q.trim() !== "");
    }
    // Рік, квартал і розділ показуємо, лише якщо в них лишилися видимі події
    for (const g of [...groups].reverse()) g.hidden = !g.querySelector("[data-entry]:not([hidden])");
    for (const sec of sections) sec.hidden = !sec.querySelector("[data-entry]:not([hidden])");
    summaries.forEach((s) => (s.hidden = active));
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === state.filter)));
    if (count) count.textContent = active ? `${shown} з ${entries.filter(inView).length}` : "";
    if (empty) empty.hidden = shown > 0;
    markClamped();

    const p = new URLSearchParams();
    if (state.filter !== "all") p.set("f", state.filter);
    if (state.q.trim()) p.set("q", state.q.trim());
    if (state.view === "games") p.set("v", "games");
    const qs = p.toString();
    history.replaceState(null, "", (qs ? `?${qs}` : location.pathname) + location.hash);
  }

  // «Докладніше» — лише там, де текст справді обрізано
  function markClamped() {
    for (const el of entries) {
      if (el.hidden) continue;
      const text = el.querySelector<HTMLElement>("[data-clamp]");
      const more = el.querySelector<HTMLButtonElement>("[data-more]");
      if (!text || !more) continue;
      const open = el.classList.contains("is-open");
      more.hidden = !open && text.scrollHeight <= text.clientHeight + 2;
      more.textContent = open ? "Згорнути" : "Докладніше";
    }
  }
  document.querySelectorAll<HTMLButtonElement>("[data-more]").forEach((btn) => {
    btn.addEventListener("click", () => {
      btn.closest("[data-entry]")?.classList.toggle("is-open");
      markClamped();
    });
  });

  if (input) {
    input.value = state.q;
    let t: ReturnType<typeof setTimeout>;
    input.addEventListener("input", () => {
      clearTimeout(t);
      t = setTimeout(() => { state.q = input.value; apply(); }, 150);
    });
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const v = b.dataset.filter ?? "all";
      // Повторне натискання на підсумок знімає фільтр
      state.filter = state.filter === v ? "all" : v;
      apply();
      if (b.classList.contains("kpi__btn")) $("chron-tools")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }),
  );
  // Перемикач «За датами / За іграми»
  viewButtons.forEach((b) => b.addEventListener("click", () => { state.view = b.dataset.view === "games" ? "games" : "dates"; apply(); }));
  // З картки гри — до події в стрічці за датами
  document.querySelectorAll<HTMLAnchorElement>("[data-goto-dates]").forEach((a) =>
    a.addEventListener("click", () => {
      state.view = "dates";
      apply();
      document.getElementById(a.hash.slice(1))?.classList.add("is-open");
    }),
  );
  // Ритм виходів на вузьких екранах гортається — показуємо найсвіжіші місяці
  document.querySelectorAll<HTMLElement>(".rhythm ol").forEach((ol) => (ol.scrollLeft = ol.scrollWidth));
  // Вибір звіту з архіву
  document.getElementById("chron-archive")?.addEventListener("change", (e) => {
    location.href = (e.target as HTMLSelectElement).value;
  });

  // Перехід за якорем на картку — розгорнути її
  const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
  if (target && target.dataset.entry !== undefined) target.classList.add("is-open");
  apply();
  window.addEventListener("resize", () => markClamped(), { passive: true });

  // Копіювання посилання на картку
  document.querySelectorAll<HTMLButtonElement>(".ev__copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = new URL(btn.dataset.copy ?? "", location.origin).toString();
      const label = btn.querySelector("span");
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = "Скопійовано";
      } catch {
        if (label) label.textContent = "Не вдалося";
      }
      history.replaceState(null, "", url.replace(location.origin, ""));
      setTimeout(() => { if (label) label.textContent = "Посилання"; }, 1600);
    });
  });
</script>

<style>
  /* Сховані фільтром елементи мають display у своїх стилях — hidden має перемагати */
  .chron [hidden] { display: none !important; }

  /* ── Шапка ── */
  .archived {
    margin-top: 20px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }
  .archived a { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .head { margin: 24px 0 28px; }
  .title { margin-top: 10px; font-size: clamp(2rem, 5vw, 3.75rem); letter-spacing: -0.02em; }
  .lead { max-width: 68ch; margin-top: 14px; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .callout { max-width: 68ch; margin-top: 12px; color: var(--faint); font-size: 14px; line-height: 1.6; }
  .howto { max-width: 78ch; margin-top: 14px; color: var(--muted); font-size: 14px; line-height: 1.65; }
  .howto summary { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); font-weight: 600; cursor: pointer; list-style: none; }
  .howto summary::-webkit-details-marker { display: none; }
  .howto summary::after { content: "+"; color: var(--faint); font-weight: 500; }
  .howto[open] summary::after { content: "−"; }
  .howto p { margin-top: 10px; }

  /* ── Підсумки-фільтри ── */
  .kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .kpi li + li { border-left: 1px solid var(--line); }
  .kpi__btn { display: grid; gap: 8px; width: 100%; height: 100%; padding: 22px 20px; text-align: left; transition: background-color 0.18s ease; }
  .kpi li:first-child .kpi__btn { padding-left: 0; }
  .kpi__btn:hover { background: rgba(255, 255, 255, 0.04); }
  .kpi__btn strong { font-size: clamp(1.9rem, 3.4vw, 2.7rem); font-weight: 700; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .kpi__btn span { color: var(--muted); font-size: 13px; }
  .kpi__btn[aria-pressed="true"] strong, .kpi__btn[aria-pressed="true"] span { color: var(--ink); }
  .kpi__btn[aria-pressed="true"] span { text-decoration: underline; text-underline-offset: 4px; }

  /* ── Липка панель ── */
  .tools {
    position: sticky;
    top: calc(var(--header-h) - 4px);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 28px;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--tint) 30%, rgba(14, 12, 18, 0.86));
    border: 1px solid var(--glass-line);
    border-radius: 9999px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .search { position: relative; flex: 0 1 280px; }
  .search svg { position: absolute; left: 12px; top: 50%; width: 16px; height: 16px; translate: 0 -50%; fill: none; stroke: var(--faint); stroke-width: 2.2; pointer-events: none; }
  .search input {
    width: 100%;
    height: 38px;
    padding: 0 12px 0 38px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--line);
    border-radius: 9999px;
    font-size: 14px;
  }
  .search input::placeholder { color: var(--faint); }
  .search input:focus { outline: none; border-color: rgba(255, 255, 255, 0.5); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 14px;
    border-radius: 9999px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .chip-btn b { color: var(--faint); font-weight: 600; font-variant-numeric: tabular-nums; }
  .chip-btn:hover { background: rgba(255, 255, 255, 0.08); color: var(--ink); }
  .chip-btn[aria-pressed="true"] { background: #f4f1f4; color: #111; }
