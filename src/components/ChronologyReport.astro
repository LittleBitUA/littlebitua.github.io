  .count { margin-left: auto; padding-right: 8px; color: var(--faint); font-size: 12px; font-weight: 700; white-space: nowrap; }

  /* ── Розкладка зі змістом ── */
  .layout { display: grid; gap: 40px; margin-top: 40px; }
  .toc { display: none; }
  .report { min-width: 0; }
  .empty { padding: 48px 20px; border: 1px dashed var(--line-strong); border-radius: 14px; color: var(--muted); text-align: center; }

  /* ── Розділ ── */
  .sec { scroll-margin-top: calc(var(--header-h) + 80px); }
