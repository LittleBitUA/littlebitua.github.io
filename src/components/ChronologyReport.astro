  /* Рік / група */
  .g1 { margin-top: 36px; }
  .g1__title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    scroll-margin-top: calc(var(--header-h) + 80px);
  }
  /* Квартал / місяць */
  .g2 { margin-top: 22px; }
  .g2__title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    scroll-margin-top: calc(var(--header-h) + 80px);
  }
  .g2__title::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .summary { max-width: 78ch; margin: 10px 0 14px; color: var(--faint); font-size: 13px; line-height: 1.6; }
  .summary :global(strong) { color: var(--muted); font-weight: 600; }

  /* ── Подія ── */
  .events { display: grid; gap: 10px; }
  .ev { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 16px; scroll-margin-top: calc(var(--header-h) + 80px); }
  .ev__day { display: grid; justify-items: center; align-content: start; padding-top: 16px; line-height: 1; }
  .ev__day strong { font-size: 1.9rem; font-weight: 700; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .ev__day span { margin-top: 6px; color: var(--faint); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .ev__day .ev__nodate { margin-top: 0; font-size: 1.4rem; }

  .ev__card {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 20px;
    padding: 16px 20px 16px 16px;
    box-shadow: none;
    transition: border-color 0.2s ease;
  }
  .ev__card:hover { border-color: rgba(255, 255, 255, 0.28); }
  .ev:target .ev__card { border-color: rgba(255, 255, 255, 0.6); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.6); }
  .ev__cover { display: block; width: 84px; height: 126px; overflow: hidden; border-radius: 8px; background: var(--surface-2); }
  .ev__cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease); }
  .ev__card:hover .ev__cover img { transform: scale(1.04); }

  .ev__body { display: grid; align-content: start; gap: 8px; min-width: 0; }
  .ev__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .ev__date { display: none; color: var(--muted); font-size: 12px; font-weight: 700; }
  .badge { display: inline-flex; align-items: center; gap: 7px; color: var(--ink); font-size: 12px; font-weight: 700; }
  .badge i { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .badge--done i { background: var(--st-done); }
  .badge--ea i { background: var(--st-early); }
  .badge--progress i { background: var(--st-progress); }
  .badge--planned i { background: var(--st-planned); }
  .ev__note { padding: 2px 9px; border: 1px solid var(--line-strong); border-radius: 9999px; color: var(--muted); font-size: 11px; font-weight: 600; }
  .ev__note--fund { border-color: color-mix(in srgb, var(--st-fund) 55%, transparent); color: var(--st-fund); }
  .ev__title { font-family: var(--font-body); font-size: 1.15rem; font-weight: 700; letter-spacing: -0.01em; line-height: 1.3; }
  .ev__title a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .ev__text {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  .ev.is-open .ev__text { display: block; -webkit-line-clamp: unset; line-clamp: none; }
  .ev__text :global(p + p) { margin-top: 10px; }
  .ev__text :global(strong), .ev__text :global(em) { color: var(--ink); }
  .ev__text :global(a), .note :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .chron :global(.hl) { color: var(--ink); font-weight: 700; }

  .ev__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; margin-top: 2px; }
  .ev__actions { display: inline-flex; align-items: center; gap: 4px; margin-left: auto; }
  .ev__more, .ev__copy {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 9999px;
    color: var(--faint);
