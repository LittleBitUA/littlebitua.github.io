---
// ─── Donors Wall ───────────────────────────────────────────────
// Топ донатерів за сумою. Суми редагуються в data/donors.ts.
import { rankedDonors } from "../data/donors";
import { formatMoney } from "../utils/status";

const list = rankedDonors();
---

<div class="donors">
  <p class="donors__head">Топ-5 донатерів</p>
  <ol>
    {list.map((d, i) => (
      <li class:list={{ "is-top": i === 0 }}>
        <span class="donors__rank num">{String(i + 1).padStart(2, "0")}</span>
        <span class="donors__name">{d.name}</span>
        <span class="donors__amount num">{formatMoney(d.amount)}</span>
      </li>
    ))}
  </ol>
  <p class="donors__thanks">Дякуємо: без вас не було б нових перекладів.</p>
</div>

<style>
  .donors { padding: 24px; background: var(--surface); border: 1px solid var(--line); }
  .donors__head {
    margin-bottom: 8px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .donors li {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .donors__rank { color: var(--faint); font-size: 12px; }
  .donors__name { font-weight: 800; }
  .donors__amount { color: var(--muted); font-size: 14px; }
  .is-top .donors__rank, .is-top .donors__amount { color: var(--accent); }
  .is-top .donors__name { font-size: 1.1rem; }
  .donors__thanks { margin-top: 16px; color: var(--faint); font-size: 13px; }
</style>
