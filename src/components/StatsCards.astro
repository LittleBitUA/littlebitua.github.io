---
// ─── Stats ─────────────────────────────────────────────────────
// Сумарний обсяг роботи по всіх проєктах, де є статистика.
import { games } from "../data/catalog";
import { pluralize } from "../utils/pluralize";

const totals = games.reduce(
  (acc, g) => {
    acc.lines += g.stats?.translatedLines ?? 0;
    acc.words += g.stats?.totalWords ?? 0;
    acc.chars += g.stats?.totalCharacters ?? 0;
    return acc;
  },
  { lines: 0, words: 0, chars: 0 },
);

const compact = new Intl.NumberFormat("uk-UA", { notation: "compact", maximumFractionDigits: 1 });
const full = new Intl.NumberFormat("uk-UA");

const items = [
  { value: String(games.length), title: full.format(games.length), label: pluralize(games.length, "проєкт", "проєкти", "проєктів") + " у каталозі" },
  { value: compact.format(totals.lines), title: full.format(totals.lines), label: "рядків перекладено" },
  { value: compact.format(totals.words), title: full.format(totals.words), label: "слів у проєктах" },
  { value: compact.format(totals.chars), title: full.format(totals.chars), label: "символів тексту" },
].filter((i) => i.value !== "0");
---

<ul class="stats">
  {items.map((i) => (
    <li>
      <strong class="num" title={i.title}>{i.value}</strong>
      <span>{i.label}</span>
    </li>
  ))}
</ul>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .stats li {
    padding: 24px 20px 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .stats li:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--line); }
  .stats strong {
    display: block;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
  }
  .stats span {
    display: block;
    margin-top: 10px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
