---
// ─── Постер у ряду ─────────────────────────────────────────────
// Лише обкладинка, як у стрімінгах. Плашка статусу в куті;
// назва й відсоток з'являються при наведенні.
import type { Game } from "../../data/games";
import { cover } from "../../lib/cover";
import { statusMeta, translationPercent, formatPct, isFundraising, fundraisingPercent } from "../../utils/status";

export interface Props {
  game: Game;
  eager?: boolean;
}
const { game, eager = false } = Astro.props;

const st = statusMeta(game.status);
const img = await cover(game.cover, 360);
// Телефону вистачає меншого розміру: постер там ~120 px завширшки
const imgSmall = await cover(game.cover, 220);
const fund = isFundraising(game) && !!game.fundraisingGoal;
const pct = fund ? fundraisingPercent(game) : translationPercent(game);
const caption = fund ? `зібрано ${pct}%` : pct >= 100 ? "перекладено" : `перекладено ${formatPct(pct)}%`;
// Плашка статусу на кожному постері; під час збору — «Збір»
const badge = fund ? "Збір коштів" : st.label;
---

<a href={`/games/${game.id}/`} class="poster" style={`--state:${fund ? "var(--st-fund)" : st.color}`}>
  <img src={img} srcset={`${imgSmall} 220w, ${img} 360w`} sizes="(max-width: 760px) 120px, 170px" alt="" width="300" height="450" loading={eager ? "eager" : "lazy"} decoding="async" />
  {badge && <span class="poster__badge">{badge}</span>}
  <span class="poster__info">
    <strong>{game.title}</strong>
    <small>{caption}</small>
  </span>
</a>

<style>
  .poster {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--card-r, 10px);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset, 0 12px 28px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s var(--ease), box-shadow 0.25s ease;
  }
  .poster img { width: 100%; height: 100%; object-fit: cover; }
  .poster:hover, .poster:focus-visible { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45); }
  /* Рамка при наведенні — всередині постера, щоб ряд її не обрізав */
  .poster::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .poster:hover::after, .poster:focus-visible::after { opacity: 1; }
  .poster:focus-visible { outline: none; }

  .poster__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--state);
    color: #0b0b0d;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.05em;
    /* власний шар: текст не розмивається маскою ряду, яка гортається */
    transform: translateZ(0);
    backface-visibility: hidden;
    text-transform: uppercase;
  }

  .poster__info {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 40px 10px 14px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.88));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .poster:hover .poster__info, .poster:focus-visible .poster__info { opacity: 1; transform: none; }
  .poster__info strong { font-size: 13px; font-weight: 700; line-height: 1.2; }
  .poster__info small { color: rgba(255, 255, 255, 0.75); font-size: 11px; }


  @media (hover: none) {
    .poster__info { opacity: 1; transform: none; padding-top: 28px; }
    .poster__info strong { font-size: 12px; }
  }
</style>
