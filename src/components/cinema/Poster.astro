---
// ─── Постер у ряду ─────────────────────────────────────────────
// Лише обкладинка, як у стрімінгах. Плашка статусу в куті, тонка смужка
// прогресу внизу; назва й відсоток з'являються при наведенні.
import type { Game } from "../../data/games";
import { cover } from "../../lib/cover";
import { statusMeta, translationPercent, formatPct, isFundraising, fundraisingPercent } from "../../utils/status";

export interface Props {
  game: Game;
  eager?: boolean;
}
const { game, eager = false } = Astro.props;

const st = statusMeta(game.status);
const img = await cover(game.cover, 360);
const fund = isFundraising(game) && !!game.fundraisingGoal;
const pct = fund ? fundraisingPercent(game) : translationPercent(game);
const caption = fund ? `зібрано ${pct}%` : pct >= 100 ? "перекладено" : `перекладено ${formatPct(pct)}%`;
// Плашка статусу на кожному постері; під час збору — «Збір»
const badge = fund ? "Збір коштів" : st.label;
---

<a href={`/games/${game.id}/`} class="poster" style={`--state:${fund ? "var(--st-fund)" : st.color}`} aria-label={`${game.title} — ${st.label}, ${caption}`}>
  <img src={img} alt="" width="300" height="450" loading={eager ? "eager" : "lazy"} decoding="async" />
  {badge && <span class="poster__badge">{badge}</span>}
  <span class="poster__info" aria-hidden="true">
    <strong>{game.title}</strong>
    <small>{caption}</small>
  </span>
  {pct < 100 && <span class="poster__bar" aria-hidden="true"><i style={`width:${pct}%`}></i></span>}
</a>

<style>
  .poster {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: var(--card-r, 10px);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset, 0 12px 28px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s var(--ease), box-shadow 0.25s ease;
  }
  .poster img { width: 100%; height: 100%; object-fit: cover; }
  .poster:hover, .poster:focus-visible { transform: translateY(-4px) scale(1.03); box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85), 0 18px 40px rgba(0, 0, 0, 0.45); }

  .poster__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 7px;
    border-radius: 4px;
    background: var(--state);
    color: #0b0b0d;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .poster__info {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 40px 10px 14px;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.88));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .poster:hover .poster__info, .poster:focus-visible .poster__info { opacity: 1; transform: none; }
  .poster__info strong { font-size: 13px; font-weight: 700; line-height: 1.2; }
  .poster__info small { color: rgba(255, 255, 255, 0.75); font-size: 11px; }

  .poster__bar { position: absolute; inset: auto 0 0; height: 3px; background: rgba(0, 0, 0, 0.55); }
  .poster__bar i { display: block; height: 100%; background: var(--state); }

  @media (hover: none) {
    .poster__info { opacity: 1; transform: none; padding-top: 28px; }
    .poster__info strong { font-size: 12px; }
  }
</style>
