---
// ─── Support ───────────────────────────────────────────────────
import DonorsWall from "./DonorsWall.astro";

const REASONS = ["Купівля ігор для перекладу", "Мотивація команди", "Нові переклади швидше"];
---

<section id="support" class="section">
  <div class="container support">
    <div>
      <span class="eyebrow">Підтримка</span>
      <h2>Підтримайте команду</h2>
      <p class="support__text">
        Усі наші локалізації безкоштовні. Донати допомагають купувати ігри, тримати темп і
        братися за нові проєкти.
      </p>
      <ul class="support__reasons">
        {REASONS.map((r) => <li>{r}</li>)}
      </ul>
      <div class="support__actions">
        <a href="https://donatello.to/LittleBitUA" target="_blank" rel="noopener noreferrer" class="btn btn--primary">Donatello</a>
        <a href="https://send.monobank.ua/jar/3h4akVJRXK" target="_blank" rel="noopener noreferrer" class="btn">Банка Monobank</a>
      </div>
    </div>
    <DonorsWall />
  </div>
</section>

<style>
  .support { display: grid; gap: 48px; }
  .support h2 { margin: 12px 0 14px; font-size: clamp(1.6rem, 3vw, 2.5rem); text-transform: uppercase; }
  .support__text { max-width: 46ch; color: var(--muted); }
  .support__reasons { display: grid; gap: 8px; margin: 24px 0 32px; }
  .support__reasons li { display: flex; align-items: center; gap: 12px; font-weight: 700; }
  .support__reasons li::before { content: ""; width: 14px; height: 2px; background: var(--accent); }
  .support__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .support__actions .btn { min-width: 180px; }

  @media (min-width: 1024px) {
    .support { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 88px; align-items: start; }
  }
</style>
