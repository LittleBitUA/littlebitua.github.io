---
// ─── Підтримка (блок на головній) ──────────────────────────────
// Чому варто підтримати, поточний збір із прогресом, способи донату,
// проєкти, на які вже зібрали, і топ донатерів.
import DonorsWall from "./DonorsWall.astro";
import FundedProjects from "./FundedProjects.astro";
import { games } from "../data/catalog";
import { cover } from "../lib/cover";
import { isFundraising, fundraisingPercent, formatMoney, isPlayable } from "../utils/status";
import { pluralize } from "../utils/pluralize";

const active = await Promise.all(
  games
    .filter((g) => isFundraising(g) && g.fundraisingGoal)
    .sort((a, b) => fundraisingPercent(b) - fundraisingPercent(a))
    .slice(0, 2)
    .map(async (g) => ({
      g,
      img: await cover(g.cover, 200),
      pct: fundraisingPercent(g),
      left: Math.max(0, g.fundraisingGoal! - (g.fundraisingRaised ?? 0)),
      url: g.fundraisingUrl ?? g.donateUrl,
    })),
);
const funded = games.filter((g) => g.fundraisingCompleted);
const fundedPlayable = funded.filter(isPlayable).length;

const WHERE = [
  { title: "Купуємо ігри", text: "Кожну гру для перекладу треба мати — часто кілька видань і платформ." },
  { title: "Платимо за час", text: "Збір на конкретну гру йде саме тим, хто її перекладає." },
  { title: "Беремося за нове", text: "Більше підтримки — більше проєктів і швидші оновлення." },
];
---

<section id="support" class="sup">
  <div class="sup__grid">
    <div class="sup__main">
      <span class="eyebrow">Підтримка</span>
      <h2 class="sup__title">Переклади безкоштовні.<br />Їх роблять люди.</h2>
      <p class="sup__lead">
        Ми не продаємо переклади й не ховаємо їх за пейволом — і так лишиться. Ваш донат перетворюється на куплені
        ігри, оплачені години роботи та нові українські локалізації.
      </p>

      <ul class="sup__where">
        {WHERE.map((w, i) => (
          <li>
            <span>{String(i + 1).padStart(2, "0")}</span>
            <strong>{w.title}</strong>
            <small>{w.text}</small>
          </li>
        ))}
      </ul>

      {active.map(({ g, img, pct, left, url }) => (
        <article class="c-panel now">
          <a href={`/games/${g.id}/`} class="now__cover" tabindex="-1" aria-hidden="true">
            <img src={img} alt="" width="96" height="144" loading="lazy" decoding="async" />
          </a>
          <div class="now__body">
            <span class="now__label"><i aria-hidden="true"></i>Зараз збираємо</span>
            <a href={`/games/${g.id}/`} class="now__title">{g.title}</a>
            <div class="now__numbers">
              <strong>{formatMoney(g.fundraisingRaised ?? 0)}</strong>
              <span>із {formatMoney(g.fundraisingGoal!)}</span>
              <b>{pct}%</b>
            </div>
            <span class="now__bar" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100" aria-label="Зібрано">
              <i style={`width:${Math.min(100, pct)}%`}></i>
            </span>
            <div class="now__foot">
              {left > 0 && <span>Залишилось <b>{formatMoney(left)}</b></span>}
              <a class="c-btn c-btn--fund" href={url} target="_blank" rel="noopener noreferrer">Підтримати збір</a>
            </div>
          </div>
        </article>
      ))}

      <div class="sup__actions">
        <a href="https://donatello.to/LittleBitUA" target="_blank" rel="noopener noreferrer" class="c-btn">Задонатити на Donatello</a>
        <a href="https://send.monobank.ua/jar/3h4akVJRXK" target="_blank" rel="noopener noreferrer" class="c-btn c-btn--glass">Банка Monobank</a>
        <a href="/support/" class="sup__all">Усі збори →</a>
      </div>
    </div>

    <aside class="sup__side">
      <DonorsWall />
    </aside>
  </div>

  {funded.length > 0 && (
    <div class="sup__funded">
      <header class="sup__funded-head">
        <h3>Зібрали разом із вами</h3>
        <p>
          {funded.length} {pluralize(funded.length, "проєкт профінансовано", "проєкти профінансовано", "проєктів профінансовано")} донатами
          {fundedPlayable > 0 && <> · у {fundedPlayable} уже можна грати</>}
        </p>
      </header>
      <FundedProjects />
    </div>
  )}
</section>

<style>
  .sup { padding: clamp(56px, 8vw, 104px) var(--side); }
  .sup__grid { display: grid; gap: 40px; }
  .sup__title { margin-top: 12px; font-size: clamp(1.9rem, 4vw, 3.2rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.025em; }
  .sup__lead { max-width: 56ch; margin-top: 16px; color: var(--muted); font-size: 16px; line-height: 1.7; }

  .sup__where { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 28px; border-top: 1px solid var(--line); }
  .sup__where li { display: grid; gap: 6px; align-content: start; padding: 18px 18px 4px 0; }
  .sup__where li + li { padding-left: 18px; border-left: 1px solid var(--line); }
  .sup__where span { color: var(--faint); font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 0.08em; }
  .sup__where strong { font-size: 15px; font-weight: 700; }
  .sup__where small { color: var(--muted); font-size: 13px; line-height: 1.5; }

  /* Поточний збір */
  .now {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 20px;
    margin-top: 28px;
    padding: 18px;
    border-color: color-mix(in srgb, var(--st-fund) 40%, transparent);
    background: linear-gradient(120deg, rgba(242, 169, 75, 0.12), rgba(20, 20, 24, 0.55) 55%);
  }
  .now__cover img { width: 96px; height: 144px; object-fit: cover; border-radius: 8px; }
  .now__body { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .now__label { display: inline-flex; align-items: center; gap: 8px; color: var(--st-fund); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .now__label i { width: 8px; height: 8px; border-radius: 50%; background: var(--st-fund); box-shadow: 0 0 0 4px rgba(242, 169, 75, 0.2); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px rgba(242, 169, 75, 0); } }
  @media (prefers-reduced-motion: reduce) { .now__label i { animation: none; } }
  .now__title { font-size: 18px; font-weight: 700; line-height: 1.25; }
  .now__title:hover { text-decoration: underline; text-underline-offset: 3px; }
  .now__numbers { display: flex; align-items: baseline; gap: 8px; }
  .now__numbers strong { font-size: clamp(1.4rem, 2.4vw, 1.8rem); font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .now__numbers span { color: var(--muted); font-size: 13px; }
  .now__numbers b { margin-left: auto; font-size: 15px; font-variant-numeric: tabular-nums; }
  .now__bar { display: block; height: 8px; overflow: hidden; border-radius: 8px; background: rgba(255, 255, 255, 0.12); }
  .now__bar i { display: block; height: 100%; border-radius: 8px; background: linear-gradient(90deg, #f2a94b, #ffc477); }
  .now__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; margin-top: 4px; }
  .now__foot > span { color: var(--muted); font-size: 14px; }
  .now__foot b { color: var(--ink); }

  .sup .c-btn { min-height: 46px; padding: 0 24px; letter-spacing: 0; text-transform: none; }
  .now .c-btn { min-height: 42px; padding: 0 20px; }
  .sup__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-top: 24px; }
  .sup__all { margin-left: 6px; color: var(--muted); font-size: 14px; font-weight: 600; }
  .sup__all:hover { color: var(--ink); }

  /* Профінансовані проєкти */
  .sup__funded { margin-top: clamp(48px, 6vw, 72px); padding-top: 28px; border-top: 1px solid var(--line); }
  .sup__funded-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin-bottom: 18px; }
  .sup__funded-head h3 { font-size: clamp(1.15rem, 1.8vw, 1.45rem); font-weight: 700; }
  .sup__funded-head p { color: var(--faint); font-size: 13px; }

  @media (min-width: 1024px) {
    .sup__grid { grid-template-columns: minmax(0, 1.5fr) minmax(320px, 1fr); gap: 72px; align-items: start; }
    .sup__side { position: sticky; top: calc(var(--header-h) + 16px); }
  }
  @media (max-width: 640px) {
    .sup__where { grid-template-columns: minmax(0, 1fr); }
    .sup__where li, .sup__where li + li { padding: 14px 0; border-left: 0; }
    .sup__where li + li { border-top: 1px solid var(--line); }
    .now { grid-template-columns: 72px minmax(0, 1fr); gap: 14px; }
    .now__cover img { width: 72px; height: 108px; }
    .sup__actions .c-btn { flex: 1 1 100%; justify-content: center; }
    .sup__all { margin-left: 0; }
  }
</style>
