---
// ─── Footer ────────────────────────────────────────────────────
const year = new Date().getFullYear();
const NAV = [
  { href: "/games/", label: "Каталог" },
  { href: "/chronology/", label: "Хронологія перекладів" },
  { href: "/#pipeline", label: "Як ми працюємо" },
  { href: "/#launcher", label: "LBK Launcher" },
  { href: "/#faq", label: "FAQ" },
];
const LINKS = [
  { href: "https://t.me/LittleBitUA", label: "Telegram" },
  { href: "https://lbklauncher.com/", label: "LBK Launcher" },
  { href: "https://donatello.to/LittleBitUA", label: "Donatello" },
  { href: "https://send.monobank.ua/jar/3h4akVJRXK", label: "Monobank" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <a href="/" class="footer__brand"><span>LB</span>«Little Bit»</a>
        <p class="footer__text">Робимо так, щоб українським гравцям було комфортно грати рідною мовою.</p>
      </div>
      <nav aria-label="Розділи">
        <p class="footer__head">Розділи</p>
        <ul>{NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <p class="footer__head">Посилання</p>
        <ul>
          {LINKS.map((l) => (
            <li>
              <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="footer__legal">© {year} «Little Bit». Назви й зображення ігор належать їхнім правовласникам.</p>
  </div>
</footer>

<style>
  .footer { margin-top: auto; padding: 56px 0 32px; border-top: 1px solid var(--line); }
  .footer__grid { display: grid; gap: 40px; }
  .footer__brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; }
  .footer__brand span {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    font: 800 12px/1 var(--font-display);
  }
  .footer__text { max-width: 34ch; margin-top: 16px; color: var(--muted); font-size: 14px; }
  .footer__head {
    margin-bottom: 14px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer ul { display: grid; gap: 10px; }
  .footer ul a { color: var(--muted); font-size: 14px; font-weight: 600; transition: color 0.18s ease; }
  .footer ul a:hover { color: var(--accent); }
  .footer__legal { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--faint); font-size: 12px; }

  @media (min-width: 768px) {
    .footer__grid { grid-template-columns: 2fr 1fr 1fr; }
  }
</style>
