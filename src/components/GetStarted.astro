---
// ─── Get Started / LBK Launcher ───────────────────────────────
const STEPS = [
  { title: "Встановіть LBK Launcher", text: "Безкоштовний застосунок для Windows, macOS і Linux." },
  { title: "Оберіть гру", text: "У каталозі лаунчера є всі доступні локалізації команди." },
  { title: "Грайте українською", text: "Натисніть «Встановити»: лаунчер сам поставить і оновлюватиме переклад." },
];
---

<section id="launcher" class="section">
  <div class="container launcher">
    <div class="launcher__intro">
      <span class="eyebrow">Як почати грати</span>
      <h2>LBK Launcher — три кроки до гри</h2>
      <p>Менеджер для встановлення та автоматичного оновлення українських локалізацій.</p>
      <a href="https://lbklauncher.com/" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4-4 4m0 0-4-4m4 4V4" />
        </svg>
        Завантажити лаунчер
      </a>
      <p class="launcher__platforms">Windows · macOS · Linux · безкоштовно</p>
    </div>

    <ol class="steps">
      {STEPS.map((s, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .launcher { display: grid; gap: 40px; }
  .launcher__intro h2 {
    margin: 12px 0 14px;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    text-transform: uppercase;
  }
  .launcher__intro > p { max-width: 42ch; margin-bottom: 28px; color: var(--muted); }
  .launcher__intro .launcher__platforms { margin: 14px 0 0; color: var(--faint); font-size: 13px; }

  .steps { border-top: 1px solid var(--line); }
  .steps li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .steps .num { color: var(--accent); font-size: 1.5rem; font-weight: 700; line-height: 1; }
  .steps h3 { font-size: 1.1rem; }
  .steps p { margin-top: 6px; color: var(--muted); font-size: 15px; }

  @media (min-width: 1024px) {
    .launcher { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 88px; align-items: center; }
  }
</style>
