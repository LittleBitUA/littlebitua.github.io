---
// ─── Як почати грати / LBK Launcher ────────────────────────────
// Ліворуч — пояснення й кнопка завантаження, праворуч — віяло постерів
// свіжих релізів; нижче — три кроки картками.
import { games } from "../data/catalog";
import { cover } from "../lib/cover";
import { isPlayable } from "../utils/status";

const fresh = games
  .filter((g) => isPlayable(g) && g.releaseDate)
  .sort((a, b) => b.releaseDate!.localeCompare(a.releaseDate!))
  .slice(0, 3);
const posters = await Promise.all(fresh.map(async (g) => ({ g, img: await cover(g.cover, 360) })));
const playable = games.filter(isPlayable).length;

const STEPS = [
  {
    title: "Встановіть LBK Launcher",
    text: "Безкоштовний застосунок для Windows, macOS і Linux.",
    icon: "M12 4v11m0 0-4-4m4 4 4-4M5 19h14",
  },
  {
    title: "Оберіть гру",
    text: "У каталозі лаунчера — усі локалізації команди, разом із ранніми версіями.",
    icon: "M4 6h16M4 12h16M4 18h10",
  },
  {
    title: "Грайте українською",
    text: "Натисніть «Встановити» — лаунчер сам поставить переклад і підкаже, коли вийде оновлення.",
    icon: "M8 5v14l11-7z",
  },
];
---

<section id="launcher" class="gs">
  <div class="gs__top">
    <div class="gs__intro">
      <span class="eyebrow">Як почати грати</span>
      <h2 class="gs__title">Як встановити переклад</h2>
      <p class="gs__lead">
        LBK Launcher встановлює й оновлює переклади в один клац: не треба шукати файли, копіювати їх у теку гри
        чи стежити за новими версіями. Зараз там <b>{playable} наших перекладів</b>, у які вже можна грати.
      </p>
      <div class="gs__actions">
        <a href="https://lbklauncher.com/" target="_blank" rel="noopener noreferrer" class="c-btn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Завантажити лаунчер
        </a>
        <ul class="gs__platforms" aria-label="Платформи">
          <li>Windows</li><li>macOS</li><li>Linux</li>
        </ul>
      </div>
      <p class="gs__free">Безкоштовно · оновлення перекладів в один клац</p>
    </div>

    {posters.length === 3 && (
      <div class="gs__fan" aria-hidden="true">
        {posters.map(({ g, img }, i) => (
          <a href={`/games/${g.id}/`} class={`gs__poster gs__poster--${i}`} tabindex="-1">
            <img src={img} alt="" width="240" height="360" loading="lazy" decoding="async" />
          </a>
        ))}
        <span class="gs__toast">
          <i><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></i>
          <span><b>Переклад встановлено</b><small>{fresh[0].title}</small></span>
        </span>
      </div>
    )}
  </div>

  <ol class="gs__steps">
    {STEPS.map((s, i) => (
      <li class="c-panel">
        <span class="gs__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg></span>
        <span class="gs__num">Крок {i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .gs { padding: clamp(56px, 8vw, 96px) var(--side); scroll-margin-top: calc(var(--header-h) + 8px); }
  .gs__top { display: grid; gap: 40px; align-items: center; }
  .gs__title { margin-top: 12px; font-size: clamp(1.9rem, 4vw, 3.2rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.025em; }
  .gs__lead { max-width: 54ch; margin-top: 16px; color: var(--muted); font-size: 16px; line-height: 1.7; }
  .gs__lead b { color: var(--ink); }
  .gs__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 28px; }
  .gs .c-btn { min-height: 48px; padding: 0 26px; letter-spacing: 0; text-transform: none; }
  .gs .c-btn svg { width: 18px; height: 18px; fill: none; }
  .gs__platforms { display: flex; gap: 6px; }
  .gs__platforms li { padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: 9999px; color: var(--muted); font-size: 12px; font-weight: 600; }
  .gs__free { margin-top: 14px; color: var(--faint); font-size: 13px; }

  /* Віяло постерів */
  .gs__fan { position: relative; height: clamp(260px, 30vw, 380px); }
  .gs__poster {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(140px, 15vw, 210px);
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    transition: transform 0.35s var(--ease);
  }
  .gs__poster img { width: 100%; height: 100%; object-fit: cover; }
  .gs__poster--0 { z-index: 3; transform: translate(-50%, -50%); }
  .gs__poster--1 { z-index: 2; transform: translate(-112%, -46%) rotate(-9deg) scale(0.9); }
  .gs__poster--2 { z-index: 1; transform: translate(12%, -46%) rotate(9deg) scale(0.9); }
  .gs__fan:hover .gs__poster--1 { transform: translate(-122%, -46%) rotate(-12deg) scale(0.9); }
  .gs__fan:hover .gs__poster--2 { transform: translate(22%, -46%) rotate(12deg) scale(0.9); }
  .gs__toast {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 2%;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 92%;
    padding: 10px 16px 10px 10px;
    border-radius: 14px;
    background: rgba(16, 16, 20, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    transform: translateX(-50%);
  }
  .gs__toast i { display: grid; flex-shrink: 0; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--st-done); color: #08130d; }
  .gs__toast svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .gs__toast > span { display: grid; min-width: 0; }
  .gs__toast b { font-size: 13px; font-weight: 700; }
  .gs__toast small { overflow: hidden; color: var(--muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }

  /* Кроки */
  .gs__steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: clamp(36px, 5vw, 56px); counter-reset: step; }
  .gs__steps li { position: relative; display: grid; gap: 8px; align-content: start; padding: 24px; box-shadow: none; }
  .gs__icon { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 8px; border-radius: 12px; background: rgba(255, 255, 255, 0.08); }
  .gs__icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .gs__steps li:last-child .gs__icon { background: var(--st-done); color: #08130d; }
  .gs__steps li:last-child .gs__icon svg { fill: currentColor; stroke: none; }
  .gs__num { color: var(--faint); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .gs__steps h3 { font-size: 1.1rem; font-weight: 700; }
  .gs__steps p { color: var(--muted); font-size: 14px; line-height: 1.6; }
  /* Стрілка між кроками */
  .gs__steps li + li::before {
    content: "";
    position: absolute;
    top: 46px;
    left: -10px;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--faint);
    border-right: 2px solid var(--faint);
    transform: rotate(45deg);
  }

  @media (min-width: 1024px) {
    .gs__top { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 64px; }
  }
  @media (max-width: 760px) {
    .gs__steps { grid-template-columns: minmax(0, 1fr); }
    .gs__steps li + li::before { display: none; }
    .gs__fan { height: 280px; }
    .gs__poster { width: 140px; }
  }
</style>
