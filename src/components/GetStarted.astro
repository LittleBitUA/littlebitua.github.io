---
// ─── Get Started — merged HowToPlay + LBKLauncher ─────────────
// Один компактний блок: 3 кроки + download CTA + 3 feature chips.
---

<section id="launcher" class="gs-section">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="gs-header" data-animate>
      <span class="lb-section-eyebrow">Як розпочати</span>
      <h2 class="gs-heading">LBK Launcher — три кроки до гри</h2>
      <p class="gs-sub">Безкоштовний менеджер для встановлення та оновлення українських локалізацій.</p>
    </div>

    <!-- Steps + CTA row -->
    <div class="gs-layout">

      <!-- 3 steps -->
      <div class="gs-steps">
        {[
          {
            n: "01",
            color: "#0ea5e9",
            title: "Встановіть LBK Launcher",
            desc: "Завантажте безкоштовний застосунок для Windows, macOS або Linux.",
            icon: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4",
          },
          {
            n: "02",
            color: "#14b8a6",
            title: "Оберіть гру",
            desc: "У каталозі лаунчера — всі доступні локалізації від нашої спілки.",
            icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
          },
          {
            n: "03",
            color: "#10b981",
            title: "Грайте українською",
            desc: "Натисніть «Встановити» — лаунчер зробить усе сам. Запускайте гру через Steam.",
            icon: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
          },
        ].map((step) => (
          <div class="gs-step" data-animate>
            <div class="gs-step__top">
              <span class="gs-step__num" style={`color: ${step.color};`}>{step.n}</span>
              <div class="gs-step__icon" style={`background: ${step.color}18; color: ${step.color};`}>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={step.icon}/>
                </svg>
              </div>
            </div>
            <h3 class="gs-step__title" style={`color: ${step.color};`}>{step.title}</h3>
            <p class="gs-step__desc">{step.desc}</p>
          </div>
        ))}
      </div>

      <!-- Download + features -->
      <div class="gs-cta-col" data-animate>
        <a
          href="https://lbklauncher.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="gs-download"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Завантажити LBK Launcher
        </a>
        <p class="gs-platform">Windows · macOS · Linux · Безкоштовно</p>

        <div class="gs-chips">
          {[
            { label: "Автовстановлення", icon: "M5 13l4 4L19 7" },
            { label: "Автооновлення",    icon: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" },
            { label: "Всі локалізації",  icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" },
          ].map((c) => (
            <div class="gs-chip">
              <svg class="w-3.5 h-3.5 text-indigo-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={c.icon}/>
              </svg>
              <span>{c.label}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .gs-section {
    padding: 4.5rem 0;
  }
  @media (min-width: 640px) { .gs-section { padding: 5.5rem 0; } }

  /* Header */
  .gs-header { text-align: center; margin-bottom: 2.5rem; }
  .gs-heading {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 900;
    color: #f1f5f9;
    letter-spacing: -0.02em;
    margin: 0.6rem 0 0.5rem;
  }
  .gs-sub { font-size: .95rem; color: #64748b; }

  /* Main layout: steps left, CTA right */
  .gs-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .gs-layout {
      grid-template-columns: 1fr auto;
      gap: 3.5rem;
    }
  }

  /* Steps */
  .gs-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .gs-steps { grid-template-columns: repeat(3, 1fr); }
  }

  .gs-step {
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 14px;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .gs-step__top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 0.25rem;
  }
  .gs-step__num {
    font-size: .65rem; font-weight: 900; letter-spacing: .2em; text-transform: uppercase;
  }
  .gs-step__icon {
    width: 2rem; height: 2rem; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
  }
  .gs-step__title {
    font-size: .875rem; font-weight: 800; line-height: 1.3;
  }
  .gs-step__desc {
    font-size: .8rem; color: #64748b; line-height: 1.55;
  }

  /* CTA column */
  .gs-cta-col {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    min-width: 220px;
  }

  .gs-download {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .7rem 1.4rem;
    border-radius: 10px;
    font-size: .9rem; font-weight: 700;
    background: #6366f1; color: #fff;
    box-shadow: 0 4px 18px -6px rgba(99,102,241,.6);
    transition: background .18s, transform .18s, box-shadow .18s;
    white-space: nowrap;
  }
  .gs-download:hover {
    background: #4f46e5;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px -6px rgba(99,102,241,.8);
  }

  .gs-platform { font-size: .7rem; color: #475569; }

  .gs-chips {
    display: flex;
    flex-direction: column;
    gap: .45rem;
    margin-top: .25rem;
  }
  .gs-chip {
    display: flex; align-items: center; gap: .5rem;
    font-size: .78rem; color: #94a3b8; font-weight: 500;
  }
</style>
