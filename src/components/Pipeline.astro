---
// ─── Pipeline / How We Work ────────────────────────────────────
// Чотири етапи локалізації та ігри, які зараз на кожному з них.
// Дані беруться з games.ts автоматично.
import { games, type Game } from "../data/catalog";
import { pluralize } from "../utils/pluralize";
import { stageName } from "../utils/status";

const STAGES = [
  {
    key: "Переклад",
    color: "var(--st-progress)",
    text: "Перекладачі адаптують діалоги, інтерфейс, описи й решту текстів гри. Це найдовший етап — тисячі рядків і кілька місяців кропіткої роботи.",
  },
  {
    key: "Редактура",
    color: "var(--st-early)",
    text: "Редактори вичитують переклад, узгоджують термінологію та дбають, щоб репліки звучали природно й відповідали характерам персонажів.",
  },
  {
    key: "Текстури",
    color: "var(--st-fund)",
    text: "Художники відтворюють українською написи на текстурах та елементах інтерфейсу, зберігаючи стиль оригінальної гри.",
  },
  {
    key: "Готово",
    color: "var(--st-done)",
    text: "Готову локалізацію інтегрують у гру, ретельно тестують і виправляють виявлені помилки. Після фінальної перевірки вона стає доступною в LBK Launcher.",
  },
];

function gamesAtStage(key: string): Game[] {
  if (key === "Текстури") {
    return games.filter(
      (g) => g.stage === "Текстури" || g.stageDetails?.some((d) => d.label === "Текстури" && d.percent > 0 && d.percent < 100),
    );
  }
  return games.filter((g) => g.stage === key);
}
---

<section id="pipeline" class="section">
  <div class="container">
    <header class="section-head">
      <div>
        <span class="eyebrow">Процес</span>
        <h2>Як ми працюємо</h2>
        <p>Чотири етапи — від англомовного оригіналу до готової української локалізації у вашій бібліотеці.</p>
      </div>
    </header>

    <ol class="stages">
      {STAGES.map((stage, i) => {
        const list = gamesAtStage(stage.key);
        const shown = list.slice(0, 5);
        const more = list.length - shown.length;
        return (
          <li class="stage" style={`--state:${stage.color}`}>
            <span class="stage__num num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{stageName(stage.key)}</h3>
            <p class="stage__text">{stage.text}</p>
            <div class="stage__now">
              <p class="stage__label">
                {list.length === 0
                  ? "Поки порожньо"
                  : `${list.length} ${pluralize(list.length, "проєкт", "проєкти", "проєктів")} на цьому етапі`}
              </p>
              {shown.length > 0 && (
                <div class="stage__covers">
                  {shown.map((g) => (
                    <a href={`/games/${g.id}/`} title={g.title}>
                      <img src={g.cover} alt={g.title} width="40" height="60" loading="lazy" />
                    </a>
                  ))}
                  {more > 0 && <span class="stage__more">+{more}</span>}
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .stages {
    display: grid;
    border-top: 3px solid var(--line);
  }
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .stage::before {
    content: "";
    position: absolute;
    top: -3px;
    left: 0;
    width: 48px;
    height: 3px;
    background: var(--state);
  }
  .stage__num { color: var(--state); font-size: 14px; font-weight: 700; }
  .stage h3 { margin: 14px 0 10px; font-size: 1.35rem; text-transform: uppercase; }
  .stage__text { flex: 1; color: var(--muted); font-size: 14px; line-height: 1.65; }

  .stage__now { margin-top: 24px; }
  .stage__label {
    margin-bottom: 10px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stage__covers { display: flex; align-items: center; gap: 6px; }
  .stage__covers a { flex-shrink: 0; border: 1px solid var(--line); transition: border-color 0.18s ease, translate 0.18s ease; }
  .stage__covers a:hover { border-color: var(--state); translate: 0 -3px; }
  .stage__covers img { width: 40px; height: 60px; object-fit: cover; }
  .stage__more { padding-left: 6px; color: var(--muted); font-size: 12px; font-weight: 800; }

  @media (min-width: 640px) {
    .stages { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
  }
  @media (min-width: 1100px) {
    .stages { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 0; border-bottom: 1px solid var(--line); }
    .stage { padding: 28px 28px 28px 0; border-bottom: 0; }
    .stage + .stage { padding-left: 28px; border-left: 1px solid var(--line); }
    .stage + .stage::before { left: 28px; }
  }
</style>
