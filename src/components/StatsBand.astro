---
// Блок «У цифрах» на головній: велике число релізів за рік, графік по місяцях
// з підписами й головні показники з контекстом. Детально — на /stats/.
import { stats as s, MONTHS_GEN } from "../lib/stats";
import { pluralize } from "../utils/pluralize";

const n = (v: number) => v.toLocaleString("uk-UA");
const max = Math.max(1, ...s.releasesByMonth.map((m) => m.count));
const peakIdx = s.releasesByMonth.reduce((best, m, i, arr) => (m.count > arr[best].count ? i : best), 0);
const nowMonth = new Date().getMonth();
const sameYear = String(new Date().getFullYear()) === s.thisYear;
const prev = s.years.at(-2);
const IN = ["січні", "лютому", "березні", "квітні", "травні", "червні", "липні", "серпні", "вересні", "жовтні", "листопаді", "грудні"];

const ITEMS = [
  { value: n(s.playable), label: `${pluralize(s.playable, "переклад", "переклади", "перекладів")} уже можна грати`, sub: `із ${s.total} у каталозі` },
  { value: n(s.inWork), label: `${pluralize(s.inWork, "проєкт", "проєкти", "проєктів")} у роботі`, sub: `у середньому ${s.avgInWork}% тексту` },
  { value: n(s.lines), label: "рядків тексту", sub: `у ${s.linesProjects} ${pluralize(s.linesProjects, "проєкті", "проєктах", "проєктах")}, де пораховано` },
  { value: n(s.members + s.helpers), label: `${pluralize(s.members + s.helpers, "людина", "людини", "людей")} у титрах`, sub: `${s.members} у команді, ${s.helpers} допомагають` },
];
---

<section class="band" aria-labelledby="band-title">
  <div class="band__inner">
    <header class="band__head">
      <span class="eyebrow">У цифрах · {s.thisYear}</span>
      <h2 id="band-title" class="band__big">
        <strong>{s.releasesThisYear}</strong>
        <span>{pluralize(s.releasesThisYear, "реліз", "релізи", "релізів")} перекладів<br />за {s.thisYear} рік</span>
      </h2>
      <p class="band__note">
        Найбільше — у {IN[peakIdx]}: {s.releasesByMonth[peakIdx].count}.
        {prev && <> Минулого року — {prev.count}.</>}
      </p>
      <a href="/stats/" class="band__link">Усі цифри студії →</a>
    </header>

    <figure class="band__chart">
      <ol class="band__bars">
        {s.releasesByMonth.map((m, i) => (
          <li
            class:list={{ "is-peak": i === peakIdx && m.count > 0, "is-now": sameYear && i === nowMonth, "is-future": sameYear && i > nowMonth }}
            title={`${MONTHS_GEN[i]}: ${m.count}`}
          >
            <b>{m.count > 0 ? m.count : ""}</b>
            <span style={`--h:${m.count / max}`}></span>
            <small>{m.label}</small>
          </li>
        ))}
      </ol>
      <figcaption class="sr-only">Релізи перекладів по місяцях {s.thisYear} року: {s.releasesByMonth.map((m) => `${m.label} — ${m.count}`).join(", ")}.</figcaption>
    </figure>

    <ul class="band__kpi">
      {ITEMS.map((it) => (
        <li>
          <strong>{it.value}</strong>
          <span>{it.label}</span>
          <small>{it.sub}</small>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .band { padding: 24px var(--side, 20px) 56px; }
  .band__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: 32px 56px;
    overflow: hidden;
    padding: 36px 36px 30px;
    border-radius: 20px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(92, 169, 255, 0.14), transparent 55%),
      rgba(20, 20, 24, 0.55);
    border: 1px solid var(--glass-line, rgba(255, 255, 255, 0.12));
  }

  .band__head { display: grid; gap: 12px; align-content: start; }
  .band__big { display: flex; align-items: flex-end; gap: 16px; margin-top: 4px; }
  .band__big strong { font-size: clamp(4rem, 8vw, 6.5rem); font-weight: 700; line-height: 0.85; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .band__big span { padding-bottom: 4px; font-size: clamp(1.05rem, 1.6vw, 1.3rem); font-weight: 600; line-height: 1.25; }
  .band__note { color: var(--muted); font-size: 14px; line-height: 1.55; }
  .band__link {
    justify-self: start;
    margin-top: 6px;
    padding: 9px 16px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    transition: background-color 0.18s ease;
  }
  .band__link:hover { background: rgba(255, 255, 255, 0.18); }

  /* Графік */
  .band__chart { align-self: end; }
  .band__bars {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 8px;
    height: 180px;
    padding-bottom: 0;
  }
  .band__bars { --area: 130px; }
  .band__bars li { position: relative; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 6px; }
  .band__bars b { min-height: 14px; color: var(--muted); font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .band__bars span {
    width: min(100%, 30px);
    height: calc(var(--h) * var(--area));
    min-height: 3px;
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(180deg, rgba(92, 169, 255, 0.95), rgba(92, 169, 255, 0.55));
  }
  .band__bars small { padding-top: 6px; color: var(--faint); font-size: 11px; }
  .band__bars li::after { content: ""; position: absolute; left: -4px; right: -4px; bottom: 22px; height: 1px; background: var(--line); z-index: -1; }
  .band__bars .is-peak span { background: linear-gradient(180deg, #8fc4ff, var(--st-early)); box-shadow: 0 0 24px rgba(92, 169, 255, 0.35); }
  .band__bars .is-peak b { color: var(--ink); font-size: 14px; }
  .band__bars .is-now small { color: var(--ink); font-weight: 700; }
  .band__bars .is-future span { background: rgba(255, 255, 255, 0.08); }

  /* Показники */
  .band__kpi { display: grid; grid-column: 1 / -1; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .band__kpi li { display: grid; gap: 6px; align-content: start; padding: 22px 16px 0 0; }
  .band__kpi li + li { padding-left: 22px; border-left: 1px solid var(--line); }
  .band__kpi strong { font-size: clamp(1.7rem, 3vw, 2.4rem); font-weight: 700; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .band__kpi span { color: var(--ink); font-size: 13px; font-weight: 600; }
  .band__kpi small { color: var(--faint); font-size: 12px; }

  @media (max-width: 900px) {
    .band__inner { grid-template-columns: minmax(0, 1fr); padding: 24px 20px; }
    .band__bars { --area: 100px; height: 150px; gap: 4px; }
    .band__bars small { font-size: 10px; }
    .band__kpi { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .band__kpi li, .band__kpi li + li { padding: 16px 12px 6px 0; border-left: 0; }
    .band__kpi li:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--line); }
    .band__kpi li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
