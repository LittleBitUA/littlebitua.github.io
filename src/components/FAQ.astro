---
// ─── FAQ ───────────────────────────────────────────────────────
const faqs = [
  {
    question: "Чи безкоштовні українські переклади від «Little Bit»?",
    answer: "Так. Усі наші локалізації безкоштовні й завжди такими залишаться.",
  },
  {
    question: "Чи потрібна ліцензійна гра для встановлення перекладу?",
    answer: "Так. Усі патчі тестуються лише з офіційними версіями ігор.",
  },
  {
    question: "Як оновити переклад до нової версії?",
    answer: "LBK Launcher сам перевіряє оновлення. Коли вийде нова версія перекладу, ви отримаєте сповіщення й оновите її в один клац.",
  },
  {
    question: "Що тут роблять локалізації «Солов'їної команди»?",
    answer: "Усі локалізації команди, над якими триває робота, відтепер опрацьовуються під нашою егідою.",
  },
];
---

<section id="faq" class="section">
  <div class="container faq">
    <div>
      <span class="eyebrow">FAQ</span>
      <h2>Часті питання</h2>
      <p class="faq__more">
        Не знайшли відповіді?
        <a href="https://t.me/LittleBitUA" target="_blank" rel="noopener noreferrer" class="link">Напишіть у Telegram</a>
      </p>
    </div>

    <div class="faq__list">
      {faqs.map((f) => (
        <details>
          <summary>
            <span>{f.question}</span>
            <i aria-hidden="true"></i>
          </summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { display: grid; gap: 32px; }
  .faq h2 { margin: 12px 0 16px; font-size: clamp(1.6rem, 3vw, 2.5rem); text-transform: uppercase; }
  .faq__more { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; color: var(--muted); }

  .faq__list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    font-size: 1.05rem;
    font-weight: 800;
    transition: color 0.18s ease;
  }
  summary:hover { color: var(--accent); }
  /* Плюс, що стає мінусом */
  summary i { position: relative; width: 14px; height: 14px; flex-shrink: 0; }
  summary i::before, summary i::after {
    content: "";
    position: absolute;
    inset: 6px 0 auto;
    height: 2px;
    background: var(--accent);
    transition: rotate 0.2s ease;
  }
  summary i::after { rotate: 90deg; }
  details[open] summary i::after { rotate: 0deg; }
  details p { max-width: 62ch; padding-bottom: 22px; color: var(--muted); }

  @media (min-width: 1024px) {
    .faq { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 88px; }
  }
</style>
