---
// ─── Stage list ────────────────────────────────────────────────
// Розбивка прогресу по етапах: переклад, редактура, текстури…
// Завершений етап — зелений, у роботі — жовтий,
// не розпочатий — порожня доріжка. Так видно, що «ранній доступ»
// може означати повністю перекладений текст без текстур.
import type { Game } from "../data/games";
import { stagesOf, stageName } from "../utils/status";

export interface Props {
  game: Game;
}
const { game } = Astro.props;
const stages = stagesOf(game);
---

  <ul class="stages">
    {stages.map((s) => {
      const state = s.percent >= 100 ? "done" : s.percent > 0 ? "active" : "todo";
      return (
        <li class={`stage is-${state}`}>
          <span class="stage__label">
            {stageName(s.label)}
          </span>
          <span class="stage__pct num">{state === "todo" ? "не розпочато" : `${s.percent}%`}</span>
          <span class="stage__bar" aria-hidden="true"><i style={`width:${s.percent}%`}></i></span>
        </li>
      );
    })}
  </ul>

<style>
  /* ── Великий (сторінка гри) ── */
  .stages { display: grid; gap: 20px; }
  .stage { display: grid; grid-template-columns: 1fr auto; align-items: baseline; column-gap: 8px; row-gap: 8px; }
  .stage__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .stage__pct { color: var(--muted); font-size: 20px; font-weight: 700; }
  .stage__bar { grid-column: 1 / -1; height: 5px; background: rgba(255, 255, 255, 0.1); }
  .stage__bar i { display: block; height: 100%; }

  .stage.is-done .stage__label, .stage.is-done .stage__pct { color: var(--st-done); }
  .stage.is-done .stage__bar i { background: var(--st-done); }
  .stage.is-active .stage__bar i { background: var(--accent); }
  .stage.is-active .stage__pct { color: var(--ink); }
  .stage.is-todo .stage__label, .stage.is-todo .stage__pct { color: var(--faint); }
  .stage.is-todo .stage__pct { font-size: 13px; }
</style>
