---
// ─── Header ────────────────────────────────────────────────────
const NAV = [
  { href: "/games/", label: "Каталог" },
  { href: "/updates/", label: "Оновлення" },
  { href: "/#launcher", label: "LBK Launcher" },
  { href: "/#faq", label: "FAQ" },
];
const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes("#") && path.startsWith(href);
---

<header id="site-header" class="site-header">
  <div class="container">
    <nav class="bar-shell" aria-label="Головна навігація">
      <a href="/" class="brand" aria-label="«Little Bit» — на головну">
        <span class="brand__mark">LB</span>
        <span class="brand__copy">
          <strong>«Little Bit»</strong>
          <small>Українські локалізації</small>
        </span>
      </a>

      <ul class="nav">
        {NAV.map((item) => (
          <li>
            <a href={item.href} class:list={["nav__link", { "is-active": isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="actions">
        <a href="/#support" class="btn btn--primary btn--sm">Підтримати</a>
        <button id="menu-toggle" class="menu-btn" type="button" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="i-open" d="M4 7h16M4 12h16M4 17h16" />
            <path class="i-close" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="mobile-menu" hidden>
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/#support">Підтримати</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;

  const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 20);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    header.classList.toggle("is-open", open);
  };
  toggle.addEventListener("click", () => setOpen(menu.hidden));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: 12px;
    transition: padding 0.2s ease;
  }
  .site-header.is-scrolled { padding-top: 8px; }

  .bar-shell {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 60px;
    padding: 8px 8px 8px 10px;
    background: rgba(8, 9, 11, 0.86);
    border: 1px solid var(--line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .is-scrolled .bar-shell { background: rgba(8, 9, 11, 0.97); }

  .brand { display: flex; align-items: center; gap: 10px; }
  .brand__mark {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    font: 800 13px/1 var(--font-display);
    letter-spacing: -0.06em;
  }
  .brand__copy { display: flex; flex-direction: column; line-height: 1.15; }
  .brand__copy strong { font-size: 14px; font-weight: 800; }
  .brand__copy small { margin-top: 3px; color: var(--faint); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }

  .nav { display: none; gap: 4px; }
  .nav__link {
    display: block;
    padding: 10px 12px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    border-bottom: 2px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .nav__link:hover, .nav__link.is-active { color: var(--ink); border-bottom-color: var(--accent); }

  .actions { display: flex; align-items: center; gap: 8px; }

  .menu-btn {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
  }
  .menu-btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; }
  .menu-btn .i-close, .is-open .menu-btn .i-open { display: none; }
  .is-open .menu-btn .i-close { display: inline; }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu a { padding: 14px 12px; font-weight: 700; border-bottom: 1px solid var(--line); }
  .mobile-menu a:last-child { border-bottom: 0; }
  .mobile-menu a:hover { color: var(--accent); }

  @media (max-width: 479px) { .brand__copy { display: none; } }
  @media (min-width: 900px) {
    .nav { display: flex; }
    .menu-btn, .mobile-menu { display: none; }
  }
</style>
