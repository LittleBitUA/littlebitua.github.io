---
// ─── Hero — merged with AvailableNow ─────────────────────────
// Перший екран: ліворуч — messaging + CTAs + stats,
// праворуч — мозаїка обкладинок доступних ігор.

import { getOverallProgress, games } from "../data/games";

const overall = getOverallProgress();
const totalGames = games.length;
const doneCount = games.filter((g) => g.status === "done").length;
const earlyCount = games.filter((g) => g.status === "early-access").length;
const inProgressCount = games.filter((g) => g.status === "in-progress").length;

// Мозаїка: done → early-access → in-progress
const STATUS_ORDER: Record<string, number> = { done: 0, "early-access": 1 };
const available = games
  .filter((g) => g.status === "done" || g.status === "early-access")
  .sort((a, b) => {
    const sa = STATUS_ORDER[a.status] ?? 99;
    const sb = STATUS_ORDER[b.status] ?? 99;
    if (sa !== sb) return sa - sb;
    return (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? "");
  });

const featured = available[0];
const others = available.slice(1, 7);
---

<section class="nd-hero">
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 90% 60% at 50% -10%, rgba(99,102,241,0.12), transparent);"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="nd-hero__grid">

      <!-- ── Left: copy ── -->
      <div class="nd-hero__copy">

        <div class="nd-eyebrow">
          <span class="nd-eyebrow__dot" aria-hidden="true"></span>
          Локалізація відеоігор
        </div>

        <h1 class="nd-headline">
          Перекладаємо те,<br/>
          у&nbsp;що <em>самі граємо</em>
        </h1>

        <p class="nd-sub">
          Сюжет, інтерфейс і дрібниці — українською.<br class="hidden sm:block"/>
          Без машинного перекладу. Без компромісів.
        </p>

        <div class="nd-ctas">
          <a href="/games/" class="nd-btn nd-btn--primary">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h10"/>
            </svg>
            Усі проєкти
          </a>
          <a href="/#launcher" class="nd-btn nd-btn--ghost">
            Завантажити Launcher
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
          </a>
        </div>

        <div class="nd-stats">
          <div class="nd-stat">
            <span class="nd-stat__n">{totalGames}</span>
            <span class="nd-stat__l">проєктів</span>
          </div>
          <div class="nd-divider" aria-hidden="true"></div>
          <div class="nd-stat">
            <span class="nd-stat__n" style="color:#34d399;">{doneCount + earlyCount}</span>
            <span class="nd-stat__l">можна грати</span>
          </div>
          <div class="nd-divider" aria-hidden="true"></div>
          <div class="nd-stat">
            <span class="nd-stat__n" style="color:#a78bfa;">{inProgressCount}</span>
            <span class="nd-stat__l">у роботі</span>
          </div>
          <div class="nd-divider" aria-hidden="true"></div>
          <div class="nd-stat">
            <span class="nd-stat__n" style="color:#818cf8;">{overall}%</span>
            <span class="nd-stat__l">прогрес</span>
          </div>
        </div>
      </div>

      <!-- ── Right: cover mosaic ── -->
      {featured && (
        <div class="nd-mosaic">
          <!-- Featured (large, spans 2 rows) -->
          <a href={`/games/${featured.id}/`} class="nd-cover nd-cover--featured" aria-label={featured.title}>
            <img src={featured.cover} alt={featured.title} loading="eager" decoding="async" />
            <span class={`nd-dot ${featured.status === "done" ? "nd-dot--green" : "nd-dot--sky"}`}></span>
            <span class="nd-caption">
              <span class="nd-caption__status">{featured.status === "done" ? "Готово до гри" : "Ранній доступ"}</span>
              <span class="nd-caption__title">{featured.title}</span>
            </span>
          </a>

          <!-- 6 smaller covers -->
          {others.map((g) => (
            <a href={`/games/${g.id}/`} class="nd-cover" aria-label={g.title}>
              <img src={g.cover} alt={g.title} loading="eager" decoding="async" />
              <span class={`nd-dot ${g.status === "done" ? "nd-dot--green" : "nd-dot--sky"}`}></span>
              <span class="nd-hover-title">{g.title}</span>
            </a>
          ))}
        </div>
      )}

    </div>
  </div>
</section>

<style>
  .nd-hero {
    position: relative;
    padding-top: 7rem;
    padding-bottom: 5rem;
  }
  @media (min-width: 640px) {
    .nd-hero { padding-top: 8.5rem; padding-bottom: 6rem; }
  }

  /* Grid: text left, mosaic right */
  .nd-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .nd-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 4rem;
    }
  }

  .nd-hero__copy { display: flex; flex-direction: column; }

  /* Eyebrow */
  .nd-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #818cf8;
    margin-bottom: 1rem;
    opacity: 0;
    animation: ndUp .5s cubic-bezier(.16,1,.3,1) 0s forwards;
  }
  .nd-eyebrow__dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #6366f1;
    box-shadow: 0 0 8px rgba(99,102,241,.8);
    flex-shrink: 0;
    animation: pulse 2.8s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

  /* Headline */
  .nd-headline {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #f1f5f9;
    margin-bottom: 1rem;
    opacity: 0;
    animation: ndUp .6s cubic-bezier(.16,1,.3,1) .08s forwards;
  }
  .nd-headline em {
    font-style: normal;
    background: linear-gradient(130deg, #818cf8 15%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nd-sub {
    font-size: 1rem;
    line-height: 1.65;
    color: #94a3b8;
    max-width: 32rem;
    margin-bottom: 1.75rem;
    opacity: 0;
    animation: ndUp .6s cubic-bezier(.16,1,.3,1) .16s forwards;
  }

  /* CTAs */
  .nd-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: ndUp .6s cubic-bezier(.16,1,.3,1) .24s forwards;
  }
  .nd-btn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.625rem 1.2rem;
    border-radius: 10px;
    font-size: 0.875rem; font-weight: 700;
    transition: transform .18s ease, box-shadow .18s ease, background .18s ease, border-color .18s ease;
    white-space: nowrap;
  }
  .nd-btn:hover { transform: translateY(-2px); }
  .nd-btn--primary {
    background: #6366f1; color: #fff;
    box-shadow: 0 4px 18px -6px rgba(99,102,241,.6);
  }
  .nd-btn--primary:hover {
    background: #4f46e5;
    box-shadow: 0 6px 24px -6px rgba(99,102,241,.8);
  }
  .nd-btn--ghost {
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.10);
    color: #cbd5e1;
  }
  .nd-btn--ghost:hover {
    background: rgba(255,255,255,.09);
    border-color: rgba(255,255,255,.16);
    color: #f1f5f9;
  }

  /* Stats */
  .nd-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,.07);
    opacity: 0;
    animation: ndUp .6s cubic-bezier(.16,1,.3,1) .32s forwards;
  }
  .nd-stat { display: flex; flex-direction: column; gap: .1rem; }
  .nd-stat__n {
    font-size: 1.5rem; font-weight: 900; line-height: 1;
    color: #e2e8f0; font-variant-numeric: tabular-nums;
  }
  .nd-stat__l {
    font-size: 0.65rem; font-weight: 600; color: #475569;
    text-transform: uppercase; letter-spacing: .07em; white-space: nowrap;
  }
  .nd-divider {
    width: 1px; height: 28px;
    background: rgba(255,255,255,.08);
    flex-shrink: 0; align-self: center;
  }

  /* Cover mosaic */
  .nd-mosaic {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 6px;
    opacity: 0;
    animation: ndUp .7s cubic-bezier(.16,1,.3,1) .2s forwards;
  }
  @media (max-width: 500px) {
    .nd-mosaic {
      grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    }
    .nd-mosaic > .nd-cover:nth-child(n+6) { display: none; }
  }

  .nd-cover {
    position: relative;
    display: block;
    aspect-ratio: 2/3;
    border-radius: 12px;
    overflow: hidden;
    background: #090b14;
    transition: transform .22s ease, box-shadow .22s ease;
  }
  .nd-cover--featured { grid-row: span 2; aspect-ratio: auto; }
  .nd-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .nd-cover:hover { transform: translateY(-3px); box-shadow: 0 14px 30px -10px rgba(0,0,0,.7); }
  .nd-cover:hover img { transform: scale(1.05); }

  /* Status dot */
  .nd-dot {
    position: absolute; top: 7px; right: 7px;
    width: 9px; height: 9px; border-radius: 50%; z-index: 2;
  }
  .nd-dot--green { background: #10b981; box-shadow: 0 0 0 2px rgba(255,255,255,.8), 0 0 10px rgba(16,185,129,.5); }
  .nd-dot--sky   { background: #0ea5e9; box-shadow: 0 0 0 2px rgba(255,255,255,.8), 0 0 10px rgba(14,165,233,.5); }

  /* Featured caption */
  .nd-caption {
    position: absolute; inset-x: 0; bottom: 0;
    padding: .75rem .85rem .85rem;
    background: linear-gradient(180deg, transparent, rgba(7,9,18,.93));
    display: flex; flex-direction: column; gap: .2rem;
    pointer-events: none;
  }
  .nd-caption__status {
    font-size: .6rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: .08em;
    color: rgba(255,255,255,.6);
  }
  .nd-caption__title {
    font-weight: 800; font-size: .875rem; line-height: 1.2; color: #fff;
  }

  /* Hover title for small covers */
  .nd-hover-title {
    position: absolute; inset: 0;
    display: flex; align-items: flex-end;
    padding: .5rem .55rem;
    background: linear-gradient(180deg, transparent 40%, rgba(7,9,18,.88) 100%);
    color: #fff; font-weight: 700; font-size: .7rem; line-height: 1.2;
    opacity: 0; transition: opacity .2s ease; pointer-events: none;
  }
  .nd-cover:hover .nd-hover-title { opacity: 1; }

  @keyframes ndUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nd-eyebrow, .nd-headline, .nd-sub, .nd-ctas, .nd-stats, .nd-mosaic, .nd-eyebrow__dot
    { animation: none; opacity: 1; transform: none; }
  }
</style>
