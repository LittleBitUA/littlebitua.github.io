---
// ─── Hero ──────────────────────────────────────────────────────
// Ліворуч: хто ми, одна пропозиція, дві дії й три цифри.
// Праворуч: стіна обкладинок ігор, у які можна грати вже зараз.
import { games } from "../data/catalog";
import { pluralize } from "../utils/pluralize";
import { isPlayable, isFundraising, fundraisingPercent } from "../utils/status";

const playable = games
  .filter(isPlayable)
  .sort((a, b) => (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? ""));
const wall = playable.slice(0, 8);

const inProgress = games.filter((g) => g.status === "in-progress").length;
const fundraisers = games.filter(isFundraising);

const stats = [
  { value: games.length, label: pluralize(games.length, "проєкт", "проєкти", "проєктів"), href: "/games/" },
  { value: playable.length, label: "можна грати вже зараз", href: "/games/?status=playable" },
  { value: inProgress, label: "у роботі", href: "/games/?status=in-progress" },
];
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker">
        <span>«Little Bit»</span>
        <span>Українська локалізація відеоігор</span>
      </p>

      <h1 class="hero__title">
        <span>Перекладаємо те,</span>
        <span>у що <em>граємо самі</em></span>
      </h1>

      <p class="hero__lede">
        Сюжет, інтерфейс і кожна дрібниця — українською. Без машинного перекладу, цілком безкоштовно
        та зі встановленням в один клац через LBK Launcher.
      </p>

      <div class="hero__actions">
        <a href="/games/" class="btn btn--primary">Дивитися каталог</a>
        <a href="/#launcher" class="btn">Як почати грати</a>
        <a href="/chronology/" class="btn">Хронологія</a>
      </div>

      <ul class="hero__stats">
        {stats.map((s) => (
          <li>
            <a href={s.href} class="hero__stat">
              <strong class="num">{s.value}</strong>
              <span>{s.label}</span>
            </a>
          </li>
        ))}
      </ul>

      {fundraisers.length === 1 && (
        <a class="hero__fund" href={`/games/${fundraisers[0].id}/`}>
          <span class="hero__fund-dot" aria-hidden="true"></span>
          Триває збір на <b>{fundraisers[0].title}</b> — {fundraisingPercent(fundraisers[0])}%
        </a>
      )}
      {fundraisers.length > 1 && (
        <a class="hero__fund" href="/games/?status=fundraising">
          <span class="hero__fund-dot" aria-hidden="true"></span>
          {pluralize(fundraisers.length, "Триває", "Тривають", "Триває")} {fundraisers.length}{" "}
          {pluralize(fundraisers.length, "збір", "збори", "зборів")} коштів на нові переклади
        </a>
      )}
    </div>

    <div class="hero__wall">
      <div class="hero__wall-head">
        <span class="eyebrow">Можна грати вже зараз</span>
        <a href="/games/?status=playable" class="link">Усі {playable.length}</a>
      </div>
      <ul class="hero__posters">
        {wall.map((g, i) => {
          return (
            <li style={`--i:${i}`}>
              <a href={`/games/${g.id}/`} class="poster">
                <img
                  src={g.cover}
                  alt=""
                  width="300"
                  height="450"
                  loading={i < 4 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : undefined}
                  decoding="async"
                />
                <span class="poster__info">
                  <span class="poster__title">{g.title}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px));
    padding-bottom: clamp(56px, 7vw, 96px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  /* ── Copy ── */
  .hero__copy { container-type: inline-size; min-width: 0; }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__kicker span:first-child { color: var(--accent); }

  .hero__title {
    display: flex;
    flex-direction: column;
    margin: 28px 0 24px;
    /* Розмір від ширини колонки: два рядки однакової довжини ніколи не обріжуться */
    font-size: clamp(1.5rem, 6.3cqi, 4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .hero__title span { white-space: nowrap; }
  .hero__title em { font-style: normal; color: var(--accent); }

  .hero__lede {
    max-width: 34rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .hero__actions .btn { min-width: 200px; }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 40px;
    border-block: 1px solid var(--line);
  }
  .hero__stat {
    display: block;
    height: 100%;
    padding: 18px 16px;
    border-left: 1px solid var(--line);
  }
  .hero__stats li:first-child .hero__stat { border-left: 0; padding-left: 0; }
  .hero__stat:hover strong { color: var(--accent); }
  .hero__stat strong {
    display: block;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1;
    transition: color 0.18s ease;
  }
  .hero__stat span {
    display: block;
    margin-top: 8px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .hero__fund {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    color: var(--muted);
    font-size: 14px;
    transition: color 0.18s ease;
  }
  .hero__fund b { color: var(--ink); font-weight: 800; }
  .hero__fund:hover { color: var(--st-fund); }
  .hero__fund-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    background: var(--st-fund);
    box-shadow: 0 0 0 4px rgba(242, 169, 75, 0.18);
  }

  /* ── Poster wall ── */
  .hero__wall { min-width: 0; }
  .hero__wall-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .hero__posters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }
  .hero__posters li {
    animation: poster-in 0.7s var(--ease) both;
    animation-delay: calc(var(--i) * 60ms);
  }

  .poster {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }
  .poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(8, 9, 11, 0.92));
  }
  .poster:hover img { transform: scale(1.03); }
  .poster:hover { border-color: var(--accent); }

  .poster__info {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 10px;
  }
  .poster__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.25;
  }

  @keyframes poster-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 639px) {
    .hero__title { font-size: clamp(1.6rem, 8.2vw, 2.4rem); }
    .hero__title { display: block; text-wrap: balance; }
    .hero__title span { white-space: normal; }
    .hero__actions .btn { flex: 1 1 100%; }
    .hero__stat { padding: 14px 10px; }
    .hero__stat span { font-size: 10px; }
    .hero__posters { gap: 6px; }
    .poster__title { display: none; }
    .poster__info { padding: 6px; }
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(48px, 5vw, 88px);
    }
    .hero__posters { gap: 12px; }
  }
</style>
