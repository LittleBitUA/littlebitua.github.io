---
// ─── Хронологія ────────────────────────────────────────────────
// Звіт про переклади. Текст — у src/data/chronology.md (звичайний
// Markdown); сторінка лише оформлює його як стрічку часу.
//
// Як читається Markdown:
//   #      — заголовок сторінки; перший жирний абзац — «станом на…», далі вступ
//   ##     — розділ, потрапляє в зміст
//   проміжні заголовки (рік, квартал, група) — вузли на лінії часу;
//             найвищий із них у розділі теж потрапляє в зміст
//   найглибший заголовок у розділі — картка гри.
//     «30 грудня — Назва · позначка» → дата, назва, позначка.
//     Назва шукається в GAME_IDS, щоб додати обкладинку й посилання.
//   ---    — усе після лінії стає приміткою внизу сторінки.
import Layout from "../layouts/Layout.astro";
import { marked, type Token, type Tokens } from "marked";
import source from "../data/chronology.md?raw";
import { games } from "../data/catalog";
import { SITE_URL } from "../utils/seo";

const all = marked.lexer(source);
const render = (list: Token[]) =>
  String(marked.parser(Object.assign([...list], { links: all.links })))
    // Відсотки й суми — жовтим
    .replace(/<strong>([^<]*(?:%|₴)[^<]*)<\/strong>/g, '<strong class="hl">$1</strong>');
const inline = (text: string) => String(marked.parseInline(text));
const plain = (text: string) => text.replace(/\*\*|__|\*/g, "");
const slug = (text: string) =>
  text.toLowerCase().replace(/[^a-zа-яіїєґ0-9]+/gi, "-").replace(/^-|-$/g, "");
const isHeading = (t: Token, depth?: number): t is Tokens.Heading =>
  t.type === "heading" && (depth === undefined || (t as Tokens.Heading).depth === depth);

// ── Назва в звіті → гра в каталозі ──
const GAME_IDS: Record<string, string> = {
  "As Dusk Falls": "as-dusk-falls",
  "No More Heroes 3": "nmh3",
  "A Game About Digging A Hole™": "digging-a-hole",
  "METAL GEAR SOLID 2: Sons of Liberty — Master Collection Version": "mgs2",
  "Uncharted: Drake’s Fortune": "uncharted1",
  "The MISSING: J.J. Macfield and the Island of Memories": "the-missing",
  "HOTEL BARCELONA": "hotel-barcelona",
  "Dispatch": "dispatch",
  "METAL GEAR & METAL GEAR 2: Solid Snake": "metal-gear-mg2",
  "METAL GEAR SOLID 4: Guns of the Patriots — Master Collection": "metal-gear-solid-4",
  "Dead Rising та Dead Rising Deluxe Remaster": "dead-rising-deluxe-remaster",
  "METAL GEAR SOLID 3: Snake Eater — Master Collection Version": "mgs3-master-collection",
  "Yakuza Kiwami 3 & Dark Ties": "yakuza-kiwami3",
  "METAL GEAR SOLID Δ: SNAKE EATER": "mgs-snake-eater",
  "KINGDOM HEARTS III + Re Mind (DLC)": "kingdom-hearts-3",
  "KINGDOM HEARTS III + Re Mind": "kingdom-hearts-3",
  "Judgment": "judgment",
  "KINGDOM HEARTS Birth by Sleep FINAL MIX": "kh-birth-by-sleep",
  "Mixtape": "mixtape",
  "JoJo’s Bizarre Adventure: All-Star Battle R": "jojo-asbr",
  "Catherine Classic": "catherine-classic",
  "Yakuza Kiwami 2": "yakuza-kiwami2",
  "Lost Judgment": "lost-judgment",
  "Like a Dragon: Ishin!": "lad-ishin",
  "Yakuza: Like a Dragon": "yakuza-lad",
  "KINGDOM HEARTS Re:Chain of Memories": "kh-rechain-of-memories",
  "KINGDOM HEARTS -HD 1.5+2.5 ReMIX-": "kingdom-hearts-1525",
  "METAL GEAR SOLID — Master Collection Version": "mgs1-master-collection",
  "METAL GEAR SOLID V: GROUND ZEROES": "mgsv-ground-zeroes",
  "Resident Evil Requiem": "resident-evil-requiem",
  "Silent Hill: Downpour": "silent-hill-downpour",
  "Deadly Premonition: The Director’s Cut": "deadly-premonition-dc",
  "Travis Strikes Again: No More Heroes": "travis-strikes-again",
  "Deadly Premonition 2: A Blessing in Disguise": "deadly-premonition-2",
  "The Good Life": "the-good-life",
  "Silent Hill: Shattered Memories": "silent-hill-shattered-memories",
  "Fire Emblem: Three Houses": "fire-emblem-three-houses",
  "Uncharted 2: Among Thieves": "uncharted2",
  "DAVE THE DIVER: In The Jungle": "dave-the-diver",
  "NieR Replicant™ ver.1.22474487139...": "nier-replicant",
  "Silent Hill: Townfall": "silent-hill-townfall",
  "Like a Dragon: Infinite Wealth": "lad-infinite-wealth",
};
// Довші назви перевіряємо першими («… Re Mind (DLC)» раніше за «… Re Mind»)
const KNOWN = Object.keys(GAME_IDS).sort((a, b) => b.length - a.length);
const gameById = new Map(games.map((g) => [g.id, g]));

/** «30 грудня — Назва · позначка» → дата, назва, позначка, гра */
function parseEntryTitle(raw: string) {
  const text = plain(raw).trim();
  const m = text.match(/^(\d{1,2}\s+[а-яіїєґʼ’']+)\s+—\s+(.+)$/i);
  const date = m ? m[1] : null;
  const rest = m ? m[2] : text;
  const known = KNOWN.find((k) => rest === k || rest.startsWith(k + " ") );
  const title = known ?? rest.split(/\s+·\s+/)[0];
  const note = rest.slice(title.length).replace(/^\s*[—·]\s*/, "").trim() || null;
  return { date, title, note, game: known ? gameById.get(GAME_IDS[known]) : undefined };
}

// ── Шапка, тіло, примітка після «---» ──
const hrAt = all.map((t) => t.type).lastIndexOf("hr");
const main = hrAt >= 0 ? all.slice(0, hrAt) : all;
const footnote = hrAt >= 0 ? render(all.slice(hrAt + 1)) : "";

const pageTitle = (main.find((t) => isHeading(t, 1)) as Tokens.Heading | undefined)?.text ?? "Хронологія";
const firstH2 = main.findIndex((t) => isHeading(t, 2));
const introParas = main.slice(0, firstH2).filter((t): t is Tokens.Paragraph => t.type === "paragraph");
const asOf = introParas[0] ? plain(introParas[0].text) : "";
const introHtml = introParas.slice(1).map((p) => inline(p.text));

// ── Розділи ──
type Entry = ReturnType<typeof parseEntryTitle> & { html: string };
type Item =
  | { kind: "node"; level: 1 | 2; text: string; id: string }
  | { kind: "summary"; html: string }
  | { kind: "entry"; entry: Entry };
interface Section { id: string; title: string; lead: string; items: Item[]; toc: { id: string; text: string }[] }

const sections: Section[] = [];
const rest = main.slice(firstH2);
const starts = rest.flatMap((t, i) => (isHeading(t, 2) ? [i] : []));
for (const [n, start] of starts.entries()) {
  const chunk = rest.slice(start, starts[n + 1] ?? rest.length);
  const h2 = chunk[0] as Tokens.Heading;
  const body = chunk.slice(1).filter((t) => t.type !== "space");
  const depths = [...new Set(body.filter((t) => isHeading(t)).map((t) => (t as Tokens.Heading).depth))].sort();
  const entryDepth = depths.length ? depths[depths.length - 1] : 99;
  const topDepth = depths.length > 1 ? depths[0] : 99;

  const section: Section = { id: slug(h2.text), title: h2.text, lead: "", items: [], toc: [] };
  let i = 0;
  const leadTokens: Token[] = [];
  while (i < body.length && !isHeading(body[i])) leadTokens.push(body[i++]);
  section.lead = render(leadTokens);

  while (i < body.length) {
    const h = body[i++] as Tokens.Heading;
    const content: Token[] = [];
    while (i < body.length && !isHeading(body[i])) content.push(body[i++]);
    if (h.depth === entryDepth) {
      section.items.push({ kind: "entry", entry: { ...parseEntryTitle(h.text), html: render(content) } });
    } else {
      const level = h.depth === topDepth ? 1 : 2;
      const id = `${section.id}-${slug(h.text)}`;
      section.items.push({ kind: "node", level, text: plain(h.text), id });
      if (level === 1) section.toc.push({ id, text: plain(h.text) });
      if (content.length) section.items.push({ kind: "summary", html: render(content) });
    }
  }
  sections.push(section);
}
---

<Layout
  title="Хронологія перекладів — «Little Bit»"
  description="Звіт «Little Bit»: дати виходу українських перекладів, ранній доступ, оновлення й плани — з обсягом роботи, зборами коштів та учасниками."
  canonicalUrl={`${SITE_URL}/chronology/`}
>
  <div class="page container">
    <nav aria-label="Навігація">
      <ol class="crumbs">
        <li><a href="/">Головна</a></li>
        <li class="sep" aria-hidden="true">/</li>
        <li aria-current="page">Хронологія</li>
      </ol>
    </nav>

    <header class="intro">
      <span class="eyebrow">Хронологія</span>
      <h1>{pageTitle}</h1>
      {asOf && <p class="intro__asof">{asOf}</p>}
      {introHtml.map((p) => <p class="intro__lead" set:html={p} />)}
    </header>

    <div class="layout">
      <aside class="toc" aria-label="Зміст">
        <p class="toc__title">Зміст</p>
        <ol>
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.title}</a>
              {s.toc.length > 0 && (
                <ol class="toc__sub">
                  {s.toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
                </ol>
              )}
            </li>
          ))}
          {footnote && <li><a href="#note">Як читати фінансові дані</a></li>}
        </ol>
      </aside>

      <div class="report">
        {sections.map((s) => (
          <section class="sec" id={s.id}>
            <h2 class="sec__title">{s.title}</h2>
            {s.lead && <div class="sec__lead" set:html={s.lead} />}

            <div class="tl">
              {s.items.map((it) =>
                it.kind === "node" ? (
                  it.level === 1 ? (
                    <h3 class="tl-period" id={it.id}><span class="tl-dot" aria-hidden="true"></span>{it.text}</h3>
                  ) : (
                    <p class="tl-month" id={it.id}>{it.text}</p>
                  )
                ) : it.kind === "summary" ? (
                  <div class="tl-summary" set:html={it.html} />
                ) : (
                  <article class="entry">
                    {it.entry.game ? (
                      <a class="entry__cover" href={`/games/${it.entry.game.id}/`} tabindex="-1" aria-hidden="true">
                        <img src={it.entry.game.cover} alt="" width="72" height="108" loading="lazy" decoding="async" />
                      </a>
                    ) : (
                      <span class="entry__cover entry__cover--empty" aria-hidden="true"></span>
                    )}
                    <div class="entry__body">
                      {(it.entry.date || it.entry.note) && (
                        <p class="entry__meta">
                          {it.entry.date && <span class="entry__date">{it.entry.date}</span>}
                          {it.entry.note && <span class="entry__note">{it.entry.note}</span>}
                        </p>
                      )}
                      <h4 class="entry__title">
                        {it.entry.game ? <a href={`/games/${it.entry.game.id}/`}>{it.entry.title}</a> : it.entry.title}
                      </h4>
                      <div class="entry__text" set:html={it.entry.html} />
                    </div>
                  </article>
                ),
              )}
            </div>
          </section>
        ))}

        {footnote && <aside class="note" id="note" set:html={footnote} />}
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ── Шапка ── */
  .intro { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
  .intro h1 { margin-top: 12px; font-size: clamp(2rem, 4.6vw, 4rem); font-weight: 800; line-height: 1; letter-spacing: -0.045em; }
  .intro__asof {
    display: inline-block;
    margin-top: 18px;
    padding: 6px 10px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .intro__lead { max-width: 78ch; margin-top: 18px; color: var(--muted); font-size: 1.05rem; line-height: 1.7; }

  /* ── Розкладка зі змістом ── */
  .layout { display: grid; gap: 40px; margin-top: 48px; }
  .toc { display: none; }
  .report { min-width: 0; }

  /* ── Розділ ── */
  .sec { scroll-margin-top: calc(var(--header-h) + 16px); }
  .sec + .sec { margin-top: 64px; }
  .sec__title {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    text-transform: uppercase;
  }
  .sec__lead { max-width: 78ch; margin-top: 14px; color: var(--muted); line-height: 1.7; }
  .sec__lead :global(strong) { color: var(--ink); }

  /* ── Стрічка часу ── */
  .tl { position: relative; margin-top: 28px; padding-left: 28px; }
  .tl::before { content: ""; position: absolute; top: 6px; bottom: 0; left: 5px; width: 2px; background: var(--line); }

  .tl-period {
    position: relative;
    margin: 40px 0 14px;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    text-transform: uppercase;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .tl-period:first-child { margin-top: 0; }
  .tl-dot {
    position: absolute;
    top: 50%;
    left: -28px;
    width: 12px;
    height: 12px;
    translate: 0 -50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .tl-month {
    position: relative;
    margin: 26px 0 10px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .tl-month::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -26px;
    width: 8px;
    height: 8px;
    translate: 0 -50%;
    border: 2px solid var(--accent);
    background: var(--bg);
  }

  .tl-summary { margin-bottom: 14px; }
  .tl-summary :global(p) {
    display: inline-block;
    max-width: 78ch;
    padding: 8px 12px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.55;
  }
  .tl-summary :global(strong) { color: var(--ink); font-weight: 700; }

  /* ── Картка гри ── */
  .entry {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 18px;
    margin-bottom: 12px;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: border-color 0.18s ease;
  }
  .entry:hover { border-color: var(--line-strong); }
  .entry__cover { display: block; width: 72px; height: 108px; overflow: hidden; border: 1px solid var(--line); background: var(--surface-2); }
  .entry__cover img { width: 100%; height: 100%; object-fit: cover; }
  .entry__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .entry__date { color: var(--accent); font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .entry__note {
    padding: 3px 7px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .entry__title { margin-top: 6px; font-family: var(--font-body); font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.3; }
  .entry__title a:hover { color: var(--accent); }
  .entry__text { margin-top: 10px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .entry__text :global(p + p) { margin-top: 10px; }
  .entry__text :global(strong) { color: var(--ink); }
  .entry__text :global(em) { color: var(--ink); }
  .entry__text :global(a), .note :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  :global(.hl) { color: var(--accent) !important; }

  /* ── Примітка внизу ── */
  .note {
    margin-top: 48px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .note :global(strong) { color: var(--ink); }

  @media (max-width: 559px) {
    .tl { padding-left: 20px; }
    .tl::before { left: 3px; }
    .tl-dot { left: -20px; width: 10px; height: 10px; }
    .tl-month::before { left: -19px; }
    .entry { grid-template-columns: 52px minmax(0, 1fr); gap: 12px; padding: 14px; }
    .entry__cover { width: 52px; height: 78px; }
    .entry__text { font-size: 14px; }
  }

  @media (min-width: 1100px) {
    .layout { grid-template-columns: 240px minmax(0, 1fr); gap: 64px; }
    .toc { display: block; position: sticky; top: calc(var(--header-h) + 24px); align-self: start; max-height: calc(100vh - var(--header-h) - 48px); overflow-y: auto; }
    .toc__title { color: var(--faint); font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
    .toc > ol { margin-top: 12px; border-left: 1px solid var(--line); }
    .toc a { display: block; padding: 7px 0 7px 14px; color: var(--muted); font-size: 14px; font-weight: 700; line-height: 1.35; transition: color 0.18s ease; }
    .toc a:hover { color: var(--accent); }
    .toc__sub a { padding: 4px 0 4px 26px; color: var(--faint); font-size: 13px; font-weight: 600; }
  }
</style>
