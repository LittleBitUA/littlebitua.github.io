---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Сторінку не знайдено — «Little Bit»" description="Сторінка не існує або була переміщена.">
  <div class="page container nf">
    <p class="nf__code num">404</p>
    <h1>Сторінку не знайдено</h1>
    <p class="nf__text">Можливо, посилання застаріле або сторінку було переміщено.</p>
    <div class="nf__actions">
      <a href="/" class="btn btn--primary">На головну</a>
      <a href="/games/" class="btn">Каталог локалізацій</a>
    </div>
  </div>
</Layout>

<style>
  .nf { display: flex; flex-direction: column; align-items: flex-start; min-height: 70vh; justify-content: center; }
  .nf__code { color: var(--accent); font-size: clamp(5rem, 16vw, 10rem); font-weight: 800; line-height: 0.9; }
  .nf h1 { margin-top: 20px; font-size: clamp(1.6rem, 3vw, 2.5rem); text-transform: uppercase; }
  .nf__text { margin-top: 12px; color: var(--muted); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
</style>
