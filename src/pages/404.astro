---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Сторінку не знайдено — Little Bit"
  description="Сторінка не існує або була переміщена."
>
  <Header />

  <main class="flex-1 flex items-center justify-center pt-28 pb-20 px-4">
    <div class="text-center max-w-md" data-animate>
      <p class="text-8xl font-black text-indigo-500/30 leading-none mb-4 select-none">404</p>
      <h1 class="text-2xl sm:text-3xl font-black text-white mb-3">
        Сторінку не знайдено
      </h1>
      <p class="text-slate-400 mb-8">
        Можливо, посилання застаріле або сторінку було переміщено.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="lb-btn">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          На головну
        </a>
        <a href="/games/" class="lb-btn lb-btn--ghost">
          Наші проєкти
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
