---
// ─── Store Prototype — вітрина ────────────────────────────────
// Пропозиції 1, 4, 5, 7, 8, 9, 10: широкі капсули Steam, цінник,
// кнопка дії на кожній картці, стеження, полиці за жанром.

import StoreLayout from "../../layouts/StoreLayout.astro";
import { games } from "../../data/games";
import { getAllUpdates } from "../../utils/updates";
import { steamCapsule, steamHero } from "../../utils/steamAssets";
import { pluralize } from "../../utils/pluralize";

type G = (typeof games)[number];

function xlat(g: G): number {
  const s = g.stageDetails ?? [];
  return (s.find((d) => /переклад/i.test(d.label)) ?? s[0])?.percent ?? g.progress;
}
const isPlayable = (g: G) => g.status === "done" || g.status === "early-access";

// Підпис описує стан перекладу, а не ціну — див. коментар до .state
const stateLabel = (g: G) => (g.status === "done" ? "Українською" : "Ранній доступ");
const stateClass = (g: G) => (g.status === "done" ? "state" : "state state--ea");

const playable = games
  .filter(isPlayable)
  .sort((a, b) => (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? ""));

const working = games.filter((g) => !isPlayable(g)).sort((a, b) => xlat(b) - xlat(a));
const almost = working.filter((g) => xlat(g) >= 70);

// Карусель банера — доступні релізи, у яких є широкий арт Steam
const featured = playable.filter((g) => steamHero(g)).slice(0, 6);
const hero = featured[0] ?? playable[0];

// Капсули лише там, де є Steam-арт (фолбек на постер у розмітці)
const capsules = playable.filter((g) => steamCapsule(g)).slice(0, 10);

const updatedIds = [...new Set(getAllUpdates().map((e) => e.gameId))];
const recent = updatedIds
  .map((id) => games.find((g) => g.id === id))
  .filter((g): g is G => !!g)
  .slice(0, 12);

// Полиці за жанром — з наявних тегів
const GENRES = ["Бойовик", "Пригоди", "Стелс", "JRPG", "Хорор", "Відкритий світ"];
const genreShelves = GENRES.map((tag) => ({
  tag,
  list: games.filter((g) => g.tags.some((t) => t.toLowerCase() === tag.toLowerCase())),
})).filter((s) => s.list.length >= 3);

const heroXlat = hero ? xlat(hero) : 0;
---

<StoreLayout active="store">
  <main class="flex-1">
    <!-- ── Карусель банера: гра веде екран ── -->
    {featured.length > 0 && (
      <section class="hero" id="hero" aria-roledescription="carousel" aria-label="Рекомендовані локалізації">
        {featured.map((g, i) => (
          <article class="slide" data-slide={i} aria-hidden={i !== 0}>
            <div class="slide__bg" aria-hidden="true">
              <img src={steamHero(g)!} alt="" data-fallback={g.cover} loading={i === 0 ? "eager" : "lazy"} decoding="async" />
            </div>
            <div class="slide__scrim" aria-hidden="true"></div>

            <div class="st-wrap slide__in">
              <p class="slide__k">Готово до завантаження</p>
              <h1 class="slide__t">{g.title}</h1>

              <div class="slide__meta">
                <span class={stateClass(g)}>{stateLabel(g)}</span>
                {g.gameYear && <span class="slide__yr">{g.gameYear}</span>}
                <span class="slide__tags">{g.tags.slice(0, 3).join(" · ")}</span>
              </div>

              <p class="slide__d">{g.description}</p>

              <div class="slide__cta">
                <a
                  href={g.downloadUrl ?? `/store/game/${g.id}/`}
                  target={g.downloadUrl ? "_blank" : undefined}
                  rel={g.downloadUrl ? "noopener" : undefined}
                  class="nf-btn nf-btn--play"
                >
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                  </svg>
                  Завантажити переклад
                </a>
                <a href={`/store/game/${g.id}/`} class="nf-btn nf-btn--info">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path stroke-linecap="round" d="M12 11v5M12 8h.01"/>
                  </svg>
                  Детальніше
                </a>
              </div>
            </div>
          </article>
        ))}

        <button class="hero__arw hero__arw--l" id="heroPrev" type="button" aria-label="Попередня гра">‹</button>
        <button class="hero__arw hero__arw--r" id="heroNext" type="button" aria-label="Наступна гра">›</button>

        <div class="hero__bars" id="heroDots" role="tablist" aria-label="Обрати гру">
          {featured.map((g, i) => (
            <button
              class={`hbar ${i === 0 ? "is-on" : ""}`}
              data-go={i}
              type="button"
              role="tab"
              aria-selected={i === 0}
              title={g.title}
            ><span></span></button>
          ))}
        </div>
      </section>
    )}

    <!-- ── Широкі капсули Steam ── -->
    {capsules.length > 0 && (
      <section class="st-sec st-wrap" id="free">
        <div class="st-sh">
          <h2>Можна завантажити зараз</h2>
          <span class="st-sh__n">{playable.length}</span>
          <div class="st-sh__nav">
            <button class="st-arw" data-scroll="capRow" data-dir="-1" aria-label="Назад">‹</button>
            <button class="st-arw" data-scroll="capRow" data-dir="1" aria-label="Далі">›</button>
          </div>
        </div>

        <div class="st-shelf st-shelf--cap" id="capRow">
          {capsules.map((g) => (
            <a href={`/store/game/${g.id}/`} class="cap">
              <span class="cap__art">
                <img src={steamCapsule(g)!} alt={g.title} data-fallback={g.cover} loading="lazy" decoding="async" />
              </span>
              <span class="cap__b">
                <span class="cap__t">{g.title}</span>
                <span class="cap__row">
                  <span class={stateClass(g)}>{stateLabel(g)}</span>
                  <span class="cap__meta">
                    {g.status === "done" ? "повний переклад" : `${xlat(g)}% перекладено`}
                  </span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── Щойно оновлені ── -->
    <section class="st-sec st-wrap">
      <div class="st-sh">
        <h2>Щойно оновлені</h2>
        <span class="st-sh__n">{recent.length}</span>
        <div class="st-sh__nav">
          <button class="st-arw" data-scroll="recRow" data-dir="-1" aria-label="Назад">‹</button>
          <button class="st-arw" data-scroll="recRow" data-dir="1" aria-label="Далі">›</button>
        </div>
      </div>

      <div class="st-shelf st-shelf--card" id="recRow">
        {recent.map((g) => (
          <a href={`/store/game/${g.id}/`} class="gc">
            <span class="gc__art">
              <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
              <span class="gc__over">
                <span class="gc__ovtags">
                  {g.tags.slice(0, 3).map((t) => <span class="st-tag">{t}</span>)}
                </span>
                <span class="st-btn st-btn--free st-btn--sm st-btn--block">
                  {isPlayable(g) ? "Завантажити" : "Детальніше"}
                </span>
              </span>
            </span>
            <span class="gc__t">{g.title}</span>
            <span class="gc__foot">
              {isPlayable(g) ? (
                <span class={stateClass(g)}>{stateLabel(g)}</span>
              ) : (
                <span class="gc__prog">
                  <span class="gc__bar"><span style={`width:${xlat(g)}%`}></span></span>
                  <span class="gc__pct">{xlat(g)}%</span>
                </span>
              )}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- ── Скоро ── -->
    {almost.length > 0 && (
      <section class="st-sec st-wrap">
        <div class="st-sh">
          <h2>Скоро вийде</h2>
          <span class="st-sh__n">{almost.length}</span>
          <a href="/store/catalog/?status=working" class="st-sh__more">Усі в роботі →</a>
        </div>

        <div class="st-shelf st-shelf--card" id="soonRow">
          {almost.map((g) => (
            <a href={`/store/game/${g.id}/`} class="gc">
              <span class="gc__art">
                <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                {g.fundraisingGoal && !g.fundraisingCompleted && (
                  <span class="gc__badge gc__badge--fund">збір</span>
                )}
                <span class="gc__over">
                  <span class="gc__ovtags">
                    {g.tags.slice(0, 3).map((t) => <span class="st-tag">{t}</span>)}
                  </span>
                  <span class="st-btn st-btn--ghost st-btn--sm st-btn--block">Детальніше</span>
                </span>
              </span>
              <span class="gc__t">{g.title}</span>
              <span class="gc__foot">
                <span class="gc__prog">
                  <span class="gc__bar"><span style={`width:${xlat(g)}%`}></span></span>
                  <span class="gc__pct">{xlat(g)}%</span>
                </span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── Полиці за жанром ── -->
    <script is:inline>
      (() => {
        const hero = document.getElementById("hero");
        if (!hero) return;
        const slides = [...hero.querySelectorAll("[data-slide]")];
        const bars = [...hero.querySelectorAll("[data-go]")];
        if (slides.length < 2) { slides[0]?.classList.add("is-on"); return; }

        let i = 0;
        let timer = null;
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

        function show(n) {
          i = (n + slides.length) % slides.length;
          slides.forEach((s, k) => {
            s.classList.toggle("is-on", k === i);
            s.setAttribute("aria-hidden", String(k !== i));
          });
          bars.forEach((b, k) => {
            b.classList.toggle("is-on", k === i);
            b.setAttribute("aria-selected", String(k === i));
          });
        }

        function play() {
          if (reduce) return;
          stop();
          timer = setInterval(() => show(i + 1), 7000);
        }
        function stop() { if (timer) clearInterval(timer); timer = null; }

        bars.forEach((b) => b.addEventListener("click", () => { show(Number(b.dataset.go)); play(); }));
        document.getElementById("heroPrev")?.addEventListener("click", () => { show(i - 1); play(); });
        document.getElementById("heroNext")?.addEventListener("click", () => { show(i + 1); play(); });

        hero.addEventListener("mouseenter", stop);
        hero.addEventListener("mouseleave", play);
        hero.addEventListener("focusin", stop);
        document.addEventListener("visibilitychange", () => document.hidden ? stop() : play());

        show(0);
        play();
      })();
    </script>

    {genreShelves.map((s, si) => (
      <section class="st-sec st-wrap">
        <div class="st-sh">
          <h2>{s.tag} українською</h2>
          <span class="st-sh__n">{s.list.length}</span>
          <a href={`/store/catalog/?tag=${encodeURIComponent(s.tag)}`} class="st-sh__more">Усі →</a>
        </div>

        <div class="st-shelf st-shelf--card" id={`gen${si}`}>
          {s.list.map((g) => (
            <a href={`/store/game/${g.id}/`} class="gc">
              <span class="gc__art">
                <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                <span class="gc__over">
                  <span class="gc__ovtags">
                    {g.tags.slice(0, 3).map((t) => <span class="st-tag">{t}</span>)}
                  </span>
                  <span class={`st-btn st-btn--sm st-btn--block ${isPlayable(g) ? "st-btn--free" : "st-btn--ghost"}`}>
                    {isPlayable(g) ? "Завантажити" : "Детальніше"}
                  </span>
                </span>
              </span>
              <span class="gc__t">{g.title}</span>
              <span class="gc__foot">
                {isPlayable(g) ? (
                  <span class={stateClass(g)}>{stateLabel(g)}</span>
                ) : (
                  <span class="gc__prog">
                    <span class="gc__bar"><span style={`width:${xlat(g)}%`}></span></span>
                    <span class="gc__pct">{xlat(g)}%</span>
                  </span>
                )}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</StoreLayout>

<style>
  /* ─── Білборд у стилі Netflix ─────────────────────────────── */
  .hero {
    position: relative;
    height: min(78vh, 660px);
    min-height: 440px;
    margin-top: -60px;           /* заходить під прозору шапку */
    isolation: isolate;
  }

  .slide {
    position: absolute; inset: 0;
    opacity: 0; visibility: hidden;
    transition: opacity .7s ease, visibility .7s;
  }
  .slide.is-on { opacity: 1; visibility: visible; }

  .slide__bg { position: absolute; inset: 0; z-index: 0; }
  .slide__bg img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 25%;
  }

  /* Градієнт зліва під текст + розчинення в сторінку знизу */
  .slide__scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(to right, rgba(9,11,20,.96) 0%, rgba(9,11,20,.78) 32%, rgba(9,11,20,.15) 62%, transparent 82%),
      linear-gradient(to top, #090b14 0%, rgba(9,11,20,.55) 22%, transparent 55%);
  }

  .slide__in {
    position: relative; z-index: 2;
    height: 100%;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
    max-width: 1400px;
  }

  .slide__k {
    font-size: .7rem; font-weight: 800; letter-spacing: .16em;
    text-transform: uppercase; color: #4ade80; margin: 0 0 .6rem;
  }
  .slide__t {
    font-size: clamp(2rem, 5.5vw, 3.75rem);
    font-weight: 900; color: #fff; line-height: 1.05;
    margin: 0 0 .75rem; max-width: 18ch;
    text-shadow: 0 3px 24px rgba(0,0,0,.55);
  }
  .slide__meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    margin-bottom: .8rem;
  }
  .slide__yr { font-size: .8rem; color: #cbd5e1; font-weight: 600; }
  .slide__tags { font-size: .8rem; color: #94a3b8; }
  .slide__d {
    font-size: .95rem; line-height: 1.6; color: #e2e8f0;
    max-width: 46ch; margin: 0 0 1.4rem;
    text-shadow: 0 2px 12px rgba(0,0,0,.6);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .slide__cta { display: flex; flex-wrap: wrap; gap: .65rem; }

  /* Кнопки Netflix: біла суцільна + напівпрозора сіра */
  .nf-btn {
    display: inline-flex; align-items: center; gap: .55rem;
    padding: .72rem 1.6rem; border-radius: 6px;
    font-size: .95rem; font-weight: 700;
    transition: background .16s, transform .1s;
  }
  .nf-btn:active { transform: translateY(1px); }
  .nf-btn--play { background: #fff; color: #0b0f14; }
  .nf-btn--play:hover { background: rgba(255,255,255,.8); }
  .nf-btn--info { background: rgba(109,121,140,.55); color: #fff; }
  .nf-btn--info:hover { background: rgba(109,121,140,.4); }

  /* Стрілки — з'являються при наведенні на білборд */
  .hero__arw {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 3; width: 44px; height: 76px;
    display: grid; place-items: center;
    background: rgba(9,11,20,.4); border: 0;
    color: #fff; font-size: 1.8rem; line-height: 1;
    cursor: pointer; opacity: 0;
    transition: opacity .2s, background .2s;
  }
  .hero:hover .hero__arw, .hero__arw:focus-visible { opacity: 1; }
  .hero__arw:hover { background: rgba(9,11,20,.72); }
  .hero__arw--l { left: 0; border-radius: 0 6px 6px 0; }
  .hero__arw--r { right: 0; border-radius: 6px 0 0 6px; }

  /* Індикатори — тонкі смужки, а не мініатюри */
  .hero__bars {
    position: absolute; z-index: 3;
    right: clamp(1rem, 4vw, 3.5rem);
    bottom: clamp(3rem, 8vh, 5.5rem);
    display: flex; gap: .4rem;
  }
  .hbar {
    width: 26px; height: 12px; padding: 0;
    background: none; border: 0; cursor: pointer;
    display: grid; align-items: center;
  }
  .hbar span {
    display: block; height: 3px; border-radius: 999px;
    background: rgba(255,255,255,.35);
    transition: background .2s;
  }
  .hbar:hover span { background: rgba(255,255,255,.6); }
  .hbar.is-on span { background: #fff; }

  @media (max-width: 700px) {
    .hero { height: auto; min-height: 0; margin-top: 0; }
    .slide { position: relative; opacity: 1; visibility: visible; display: none; }
    .slide.is-on { display: block; }
    .slide__bg { position: relative; height: 210px; }
    .slide__scrim {
      background: linear-gradient(to top, #090b14 24%, rgba(9,11,20,.3) 60%, transparent 100%);
    }
    .slide__in { padding-block: 1rem 1.5rem; }
    .slide__t { max-width: none; }
    .hero__arw { display: none; }
    .hero__bars { position: static; margin: 0 auto .5rem; justify-content: center; }
  }

  /* ─── Ряди в стилі Netflix: картка збільшується ────────────── */
  .st-shelf { padding-block: .5rem; }
  .st-shelf .gc { transition: transform .25s cubic-bezier(.16,1,.3,1); }
  @media (hover: hover) and (min-width: 900px) {
    .st-shelf:hover .gc { opacity: .72; }
    .st-shelf .gc:hover { transform: scale(1.09); opacity: 1; z-index: 5; }
  }
</style>
