---
// ─── Store Prototype — сторінка товару ────────────────────────
// Пропозиції 1, 2, 3: широкий банер Steam, buy box замість
// звичайної кнопки, галерея скріншотів (де вони є).

import StoreLayout from "../../../layouts/StoreLayout.astro";
import { games, STATUS_LABELS } from "../../../data/games";
import { steamHero, steamCapsule } from "../../../utils/steamAssets";

export function getStaticPaths() {
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;
type G = typeof game;

function xlat(g: G): number {
  const s = g.stageDetails ?? [];
  return (s.find((d) => /переклад/i.test(d.label)) ?? s[0])?.percent ?? g.progress;
}

const isPlayable = game.status === "done" || game.status === "early-access";
const stages = game.stageDetails ?? [];
const xlatStage = stages.find((d) => /переклад/i.test(d.label)) ?? stages[0];
const otherStages = stages.filter((d) => d !== xlatStage);
const percent = xlat(game);

const fundActive = !!game.fundraisingGoal && !game.fundraisingCompleted;
const fundPct = game.fundraisingGoal
  ? Math.min(Math.round(((game.fundraisingRaised ?? 0) / game.fundraisingGoal) * 100), 100)
  : 0;

const shots = game.screenshots ?? [];

// Схожі: та сама серія, інакше — спільні теги
const similar = games
  .filter((g) => g.id !== game.id)
  .map((g) => {
    let score = 0;
    if (game.series && g.series === game.series) score += 10;
    score += g.tags.filter((t) => game.tags.includes(t)).length;
    return { g, score };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map((x) => x.g);

function fmtDate(d?: string) {
  if (!d) return "—";
  return new Date(d).toLocaleDateString("uk-UA", { day: "numeric", month: "long", year: "numeric" });
}

const heroArt = steamHero(game);
---

<StoreLayout title={`${game.title} — українська локалізація`} description={game.description}>
  <main class="flex-1">
    <!-- ── Банер ── -->
    <section class="phero">
      <div class="phero__bg" aria-hidden="true">
        <img src={heroArt ?? game.cover} alt="" data-fallback={game.cover} decoding="async" />
        <div class="phero__veil"></div>
      </div>

      <div class="st-wrap phero__in">
        <nav style="margin-bottom:1.1rem;">
          <ol style="display:flex;gap:.5rem;list-style:none;margin:0;padding:0;font-size:.74rem;color:#64748b;">
            <li><a href="/store/" style="color:#94a3b8;">Магазин</a></li>
            <li>›</li>
            <li><a href="/store/catalog/" style="color:#94a3b8;">Каталог</a></li>
            <li>›</li>
            <li style="color:#cbd5e1;">{game.title}</li>
          </ol>
        </nav>

        <div class="pg">
          <img class="pg__poster" src={game.cover} alt={game.title} decoding="async" />

          <div style="min-width:0;">
            <h1 style="font-size:clamp(1.5rem,3.6vw,2.5rem);font-weight:900;color:#fff;line-height:1.12;margin:0 0 .6rem;">
              {game.title}
            </h1>
            <p style="font-size:.78rem;color:#94a3b8;margin:0 0 .8rem;">
              Українська локалізація · {STATUS_LABELS[game.status]}
              {game.gameYear && ` · ${game.gameYear}`}
              {game.platform?.length ? ` · ${game.platform.join(", ")}` : ""}
            </p>
            <div style="display:flex;flex-wrap:wrap;gap:.3rem;">
              {game.tags.map((t) => (
                <a href={`/store/catalog/?tag=${encodeURIComponent(t)}`} class="st-tag">{t}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="st-wrap" style="padding-block:1.75rem 3rem;">
      <div class="pcols">
        <!-- ── Головна колонка ── -->
        <div style="min-width:0;">
          <!-- Галерея -->
          {shots.length > 0 ? (
            <section style="margin-bottom:1.75rem;">
              <div class="gal">
                <div class="gal__main">
                  <img id="galMain" src={shots[0]} alt="Скріншот перекладу" decoding="async" />
                </div>
                <div class="gal__side">
                  {shots.slice(0, 8).map((s, i) => (
                    <button class={`gal__th ${i === 0 ? "is-on" : ""}`} data-shot={s} type="button">
                      <img src={s} alt={`Скріншот ${i + 1}`} loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
              </div>
            </section>
          ) : (
            <section style="margin-bottom:1.75rem;">
              <div class="gal__empty">
                Скріншотів перекладу ще немає.<br />
                <span style="font-size:.78rem;opacity:.75;">
                  Це найсильніший аргумент на сторінці товару — блок з'явиться сам,
                  щойно у грі буде заповнено <code style="color:#a5b4fc;">screenshots</code>.
                </span>
              </div>
            </section>
          )}

          <!-- Опис -->
          <section style="margin-bottom:1.75rem;">
            <h2 style="font-size:1rem;font-weight:800;color:#f1f5f9;margin:0 0 .7rem;">Про локалізацію</h2>
            <p style="font-size:.9rem;line-height:1.7;color:#94a3b8;margin:0;">
              {game.detailedDescription ?? game.description}
            </p>
          </section>

          <!-- Прогрес по стадіях -->
          <section style="margin-bottom:1.75rem;">
            <h2 style="font-size:1rem;font-weight:800;color:#f1f5f9;margin:0 0 .8rem;">Стан перекладу</h2>
            <div class="lb-glass" style="padding:1rem 1.1rem;">
              <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:.5rem;">
                <span style="font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#94a3b8;">
                  Переклад
                </span>
                <span style="font-size:1.4rem;font-weight:900;color:#a5b4fc;line-height:1;">{percent}%</span>
              </div>
              <div style="height:8px;border-radius:999px;background:rgba(255,255,255,.1);overflow:hidden;">
                <div style={`width:${percent}%;height:100%;border-radius:999px;background:linear-gradient(90deg,#818cf8,#6366f1);`}></div>
              </div>

              {otherStages.length > 0 && (
                <div style="margin-top:1rem;padding-top:.9rem;border-top:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;gap:.55rem;">
                  {otherStages.map((d) => (
                    <div style="display:flex;align-items:center;gap:.75rem;">
                      <span style="flex-shrink:0;width:88px;font-size:.74rem;color:#94a3b8;">{d.label}</span>
                      <span style="flex:1;height:4px;border-radius:999px;background:rgba(255,255,255,.1);overflow:hidden;">
                        <span style={`display:block;width:${d.percent}%;height:100%;background:linear-gradient(90deg,#5eead4,#14b8a6);`}></span>
                      </span>
                      <span style="font-size:.74rem;font-weight:700;color:#cbd5e1;width:3ch;text-align:right;">{d.percent}</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </section>

          <!-- Схожі -->
          {similar.length > 0 && (
            <section>
              <div class="st-sh">
                <h2>Схожі локалізації</h2>
              </div>
              <div class="st-shelf st-shelf--card" id="simRow">
                {similar.map((g) => (
                  <a href={`/store/game/${g.id}/`} class="gc">
                    <span class="gc__art">
                      <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                      {(g.status === "done" || g.status === "early-access") && (
                        <span class="gc__badge">безкоштовно</span>
                      )}
                    </span>
                    <span class="gc__t">{g.title}</span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- ── Buy box ── -->
        <aside class="pbuy">
          <div class={`buy ${isPlayable ? "" : "buy--soon"}`}>
            <div class="buy__top">
              <span class="buy__lbl">{isPlayable ? "Доступно" : "У роботі"}</span>
              {isPlayable
                ? <span class="price price--lg">Безкоштовно</span>
                : <span class="price price--soon">{percent}%</span>}
            </div>

            <div class="buy__cta">
              {isPlayable && game.downloadUrl ? (
                <a href={game.downloadUrl} target="_blank" rel="noopener" class="st-btn st-btn--free st-btn--block st-btn--lg">
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                  </svg>
                  Завантажити переклад
                </a>
              ) : isPlayable ? (
                <a href="https://lbklauncher.com/" target="_blank" rel="noopener" class="st-btn st-btn--free st-btn--block st-btn--lg">
                  Отримати через лаунчер
                </a>
              ) : (
                <button class="st-btn st-btn--ghost st-btn--block st-btn--lg" data-watch={game.id} type="button" aria-pressed="false">
                  <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 3h14a2 2 0 012 2v16l-9-4-9 4V5a2 2 0 012-2z"/>
                  </svg>
                  Стежити за перекладом
                </button>
              )}

              {fundActive && (
                <a href={game.donateUrl} target="_blank" rel="noopener" class="st-btn st-btn--block"
                   style="background:rgba(245,158,11,.18);color:#fbbf24;border-color:rgba(245,158,11,.45);">
                  Підтримати збір · {fundPct}%
                </a>
              )}

              {game.steamUrl && (
                <a href={game.steamUrl} target="_blank" rel="noopener" class="st-btn st-btn--ghost st-btn--block st-btn--sm">
                  Сторінка гри в Steam
                </a>
              )}
            </div>

            <div class="buy__meta">
              {game.version && <span>Версія <b>{game.version}</b></span>}
              <span>Оновлено <b>{fmtDate(game.lastUpdate)}</b></span>
              {game.stats?.translatedLines && (
                <span>Рядків <b>{game.stats.translatedLines.toLocaleString("uk-UA")}</b></span>
              )}
              <span>Мова <b>українська</b></span>
            </div>
          </div>

          {fundActive && game.fundraisingGoal && (
            <div class="lb-glass" style="padding:.95rem 1rem;margin-top:.75rem;border-color:rgba(245,158,11,.25);">
              <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.5rem;">
                <span style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:#fbbf24;">Збір</span>
                <span style="font-size:.76rem;color:#fbbf24;font-weight:700;">{fundPct}%</span>
              </div>
              <div style="height:6px;border-radius:999px;background:rgba(255,255,255,.1);overflow:hidden;margin-bottom:.5rem;">
                <div style={`width:${fundPct}%;height:100%;background:linear-gradient(90deg,#f59e0b,#fbbf24);`}></div>
              </div>
              <p style="font-size:.74rem;color:#94a3b8;margin:0;">
                {(game.fundraisingRaised ?? 0).toLocaleString("uk-UA")} із {game.fundraisingGoal.toLocaleString("uk-UA")} ₴
              </p>
            </div>
          )}

          <div class="lb-glass" style="padding:.9rem 1rem;margin-top:.75rem;">
            <p style="font-size:.76rem;color:#94a3b8;margin:0;line-height:1.6;">
              Переклади встановлюються через
              <a href="https://lbklauncher.com/" target="_blank" rel="noopener" style="color:#818cf8;font-weight:600;">LBK Launcher</a>
              — він сам знайде гру й оновлюватиме локалізацію.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</StoreLayout>

<style>
  .pg { display: grid; gap: 1.25rem; align-items: end; }
  @media (min-width: 700px) { .pg { grid-template-columns: 150px minmax(0, 1fr); gap: 1.5rem; } }
  .pg__poster {
    width: 116px; aspect-ratio: 2/3; object-fit: cover;
    border-radius: 10px; box-shadow: 0 20px 44px -18px rgba(0,0,0,.9);
  }
  @media (min-width: 700px) { .pg__poster { width: 150px; } }

  .pcols { display: grid; gap: 1.75rem; align-items: start; }
  @media (min-width: 1000px) { .pcols { grid-template-columns: minmax(0, 1fr) 320px; gap: 2rem; } }
  .pbuy { position: sticky; top: 76px; }
</style>

<script>
  // Галерея: клік по мініатюрі міняє велике зображення
  const main = document.getElementById("galMain") as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>("[data-shot]").forEach((b) => {
    b.addEventListener("click", () => {
      if (!main) return;
      main.src = b.dataset.shot!;
      document.querySelectorAll("[data-shot]").forEach((x) => x.classList.remove("is-on"));
      b.classList.add("is-on");
    });
  });
</script>
