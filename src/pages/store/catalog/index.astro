---
// ─── Store Prototype — каталог із фасетами ────────────────────
// Пропозиція 6: бічна колонка з чекбоксами замість рядка пілюль.
// Використовує genre / platform / tags / series / status із games.ts.

import StoreLayout from "../../../layouts/StoreLayout.astro";
import { games } from "../../../data/games";
import { pluralize } from "../../../utils/pluralize";

type G = (typeof games)[number];

function xlat(g: G): number {
  const s = g.stageDetails ?? [];
  return (s.find((d) => /переклад/i.test(d.label)) ?? s[0])?.percent ?? g.progress;
}
const isPlayable = (g: G) => g.status === "done" || g.status === "early-access";

const STATUS_PRIORITY: Record<string, number> = { done: 0, "early-access": 1, "in-progress": 2, fundraising: 3 };
const sorted = [...games].sort((a, b) => {
  const pa = STATUS_PRIORITY[a.status] ?? 9;
  const pb = STATUS_PRIORITY[b.status] ?? 9;
  if (pa !== pb) return pa - pb;
  return (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? "");
});

// ── Фасети рахуємо на збірці, щоб показати кількість біля кожної опції ──
function tally(pick: (g: G) => string[]): { v: string; n: number }[] {
  const m = new Map<string, number>();
  for (const g of games) for (const v of pick(g)) m.set(v, (m.get(v) ?? 0) + 1);
  return [...m.entries()]
    .map(([v, n]) => ({ v, n }))
    .sort((a, b) => b.n - a.n || a.v.localeCompare(b.v, "uk"));
}

const facetState = [
  { v: "free", n: games.filter(isPlayable).length, label: "Можна завантажити" },
  { v: "working", n: games.filter((g) => !isPlayable(g)).length, label: "У роботі" },
  { v: "fund", n: games.filter((g) => g.fundraisingGoal && !g.fundraisingCompleted).length, label: "Збір коштів" },
];

const facetTags = tally((g) => g.tags).slice(0, 14);
const facetSeries = tally((g) => (g.series ? [g.series] : []));
const facetPlatform = tally((g) => g.platform ?? []);
---

<StoreLayout active="catalog" title="Каталог локалізацій — прототип магазину">
  <main class="flex-1 st-wrap" style="padding-top:1.75rem; padding-bottom:3rem;">
    <div style="margin-bottom:1.25rem;">
      <h1 style="font-size:1.6rem;font-weight:900;color:#f1f5f9;margin:0 0 .3rem;">Каталог</h1>
      <p style="font-size:.85rem;color:#94a3b8;margin:0;">
        {games.length} {pluralize(games.length, "локалізація", "локалізації", "локалізацій")} ·
        усі безкоштовні
      </p>
    </div>

    <div class="st-cat">
      <!-- ── Фасети ── -->
      <aside>
        <button class="fac__toggle" id="facToggle" type="button" aria-expanded="false">
          <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M6 12h12M10 20h4"/>
          </svg>
          Фільтри
          <span id="facCount" style="color:#818cf8;"></span>
        </button>

        <div class="fac__body" id="facBody">
          <div class="fac">
            <div class="fac__grp">
              <p class="fac__h">Стан</p>
              {facetState.map((f) => (
                <label class="fac__l">
                  <input type="checkbox" data-facet="state" value={f.v} />
                  {f.label}
                  <span class="fac__c">{f.n}</span>
                </label>
              ))}
            </div>

            <div class="fac__grp">
              <p class="fac__h">Жанр і теги</p>
              {facetTags.map((f) => (
                <label class="fac__l">
                  <input type="checkbox" data-facet="tag" value={f.v} />
                  {f.v}
                  <span class="fac__c">{f.n}</span>
                </label>
              ))}
            </div>

            {facetSeries.length > 0 && (
              <div class="fac__grp">
                <p class="fac__h">Серія</p>
                {facetSeries.map((f) => (
                  <label class="fac__l">
                    <input type="checkbox" data-facet="series" value={f.v} />
                    {f.v}
                    <span class="fac__c">{f.n}</span>
                  </label>
                ))}
              </div>
            )}

            {facetPlatform.length > 0 && (
              <div class="fac__grp">
                <p class="fac__h">Платформа</p>
                {facetPlatform.map((f) => (
                  <label class="fac__l">
                    <input type="checkbox" data-facet="platform" value={f.v} />
                    {f.v}
                    <span class="fac__c">{f.n}</span>
                  </label>
                ))}
              </div>
            )}

            <button class="fac__reset" id="facReset" type="button">Скинути все</button>
          </div>
        </div>
      </aside>

      <!-- ── Результати ── -->
      <div>
        <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.9rem;">
          <span id="resCount" style="font-size:.8rem;font-weight:600;color:#94a3b8;"></span>
          <select
            id="sortSel"
            style="margin-left:auto;padding:.4rem .7rem;border-radius:8px;background:rgba(255,255,255,.06);
                   border:1px solid rgba(255,255,255,.1);color:#cbd5e1;font-size:.78rem;font-weight:600;
                   cursor:pointer;color-scheme:dark;"
          >
            <option value="default">За станом</option>
            <option value="progress-desc">Готовність ↓</option>
            <option value="progress-asc">Готовність ↑</option>
            <option value="title">Назва А→Я</option>
            <option value="updated">Останні оновлення</option>
          </select>
        </div>

        <div class="st-grid" id="catGrid">
          {sorted.map((g, i) => (
            <a
              href={`/store/game/${g.id}/`}
              class="gc"
              data-card
              data-idx={i}
              data-state={[
                isPlayable(g) ? "free" : "working",
                g.fundraisingGoal && !g.fundraisingCompleted ? "fund" : "",
              ].filter(Boolean).join(",")}
              data-tag={g.tags.join(",")}
              data-series={g.series ?? ""}
              data-platform={(g.platform ?? []).join(",")}
              data-title={g.title}
              data-progress={xlat(g)}
              data-updated={g.lastUpdate ?? ""}
            >
              <span class="gc__art">
                <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                {isPlayable(g) && <span class="gc__badge">безкоштовно</span>}
                {g.fundraisingGoal && !g.fundraisingCompleted && !isPlayable(g) && (
                  <span class="gc__badge gc__badge--fund">збір</span>
                )}
                <button class="wl" data-watch={g.id} type="button" aria-pressed="false">
                  <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 3h14a2 2 0 012 2v16l-9-4-9 4V5a2 2 0 012-2z"/>
                  </svg>
                </button>
                <span class="gc__over">
                  <span class="gc__ovtags">
                    {g.tags.slice(0, 3).map((t) => <span class="st-tag">{t}</span>)}
                  </span>
                  <span class={`st-btn st-btn--sm st-btn--block ${isPlayable(g) ? "st-btn--free" : "st-btn--ghost"}`}>
                    {isPlayable(g) ? "Завантажити" : "Стежити"}
                  </span>
                </span>
              </span>
              <span class="gc__t">{g.title}</span>
              <span class="gc__foot">
                {isPlayable(g) ? (
                  <span class="price">Безкоштовно</span>
                ) : (
                  <span class="gc__prog">
                    <span class="gc__bar"><span style={`width:${xlat(g)}%`}></span></span>
                    <span class="gc__pct">{xlat(g)}%</span>
                  </span>
                )}
              </span>
            </a>
          ))}
        </div>

        <div class="st-empty" id="catEmpty" hidden>
          За цими фільтрами нічого не знайдено.
        </div>
      </div>
    </div>
  </main>
</StoreLayout>

<script>
  const grid = document.getElementById("catGrid")!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-card]"));
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>("[data-facet]"));
  const resCount = document.getElementById("resCount")!;
  const empty = document.getElementById("catEmpty")!;
  const sortSel = document.getElementById("sortSel") as HTMLSelectElement;
  const facCount = document.getElementById("facCount")!;

  // Початковий стан із URL: /store/catalog/?tag=Стелс або ?status=working
  const params = new URLSearchParams(location.search);
  const preTag = params.get("tag");
  const preStatus = params.get("status");
  if (preTag || preStatus) {
    boxes.forEach((b) => {
      if (preTag && b.dataset.facet === "tag" && b.value === preTag) b.checked = true;
      if (preStatus && b.dataset.facet === "state" && b.value === preStatus) b.checked = true;
    });
  }

  function picked(kind: string): string[] {
    return boxes.filter((b) => b.dataset.facet === kind && b.checked).map((b) => b.value);
  }

  function apply() {
    const st = picked("state");
    const tg = picked("tag");
    const sr = picked("series");
    const pl = picked("platform");
    const total = st.length + tg.length + sr.length + pl.length;
    facCount.textContent = total ? `· ${total}` : "";

    let shown = 0;
    const visible: HTMLElement[] = [];

    cards.forEach((c) => {
      const cs = (c.dataset.state || "").split(",");
      const ct = (c.dataset.tag || "").split(",");
      const cp = (c.dataset.platform || "").split(",");

      // Усередині групи — АБО, між групами — І (як у магазинах)
      const okState = !st.length || st.some((v) => cs.includes(v));
      const okTag = !tg.length || tg.some((v) => ct.includes(v));
      const okSeries = !sr.length || sr.includes(c.dataset.series || "");
      const okPlat = !pl.length || pl.some((v) => cp.includes(v));

      const ok = okState && okTag && okSeries && okPlat;
      c.hidden = !ok;
      if (ok) { shown++; visible.push(c); }
    });

    // Сортування — через CSS order, щоб не чіпати DOM
    const mode = sortSel.value;
    const keyed = visible.map((c) => ({
      el: c,
      idx: Number(c.dataset.idx),
      p: Number(c.dataset.progress),
      t: c.dataset.title || "",
      u: c.dataset.updated || "",
    }));
    keyed.sort((a, b) => {
      switch (mode) {
        case "progress-desc": return b.p - a.p;
        case "progress-asc":  return a.p - b.p;
        case "title":         return a.t.localeCompare(b.t, "uk");
        case "updated":       return b.u.localeCompare(a.u);
        default:              return a.idx - b.idx;
      }
    });
    keyed.forEach((k, i) => { k.el.style.order = String(i); });

    resCount.textContent = total
      ? `${shown} із ${cards.length}`
      : `${cards.length} локалізацій`;
    empty.hidden = shown !== 0;
  }

  boxes.forEach((b) => b.addEventListener("change", apply));
  sortSel.addEventListener("change", apply);
  document.getElementById("facReset")?.addEventListener("click", () => {
    boxes.forEach((b) => (b.checked = false));
    sortSel.value = "default";
    apply();
  });

  const toggle = document.getElementById("facToggle");
  toggle?.addEventListener("click", () => {
    const body = document.getElementById("facBody")!;
    const open = body.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(open));
  });

  apply();
</script>
