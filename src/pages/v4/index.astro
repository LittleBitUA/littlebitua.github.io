---
// ─── V4 Prototype — вітрина ───────────────────────────────────
// Логіка ігрового магазину: великий showcase із перемикачем,
// горизонтальні полиці, картки з ховером. Артворк — головний.

import V4Layout from "../../layouts/V4Layout.astro";
import { games } from "../../data/games";
import { getAllUpdates } from "../../utils/updates";

type G = (typeof games)[number];

function xlat(g: G): number {
  const s = g.stageDetails ?? [];
  return (s.find((d) => /переклад/i.test(d.label)) ?? s[0])?.percent ?? g.progress;
}

const isPlayable = (g: G) => g.status === "done" || g.status === "early-access";

const playable = games
  .filter(isPlayable)
  .sort((a, b) => (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? ""));

const working = games
  .filter((g) => !isPlayable(g))
  .sort((a, b) => xlat(b) - xlat(a));

// Найближчі до релізу — окрема полиця, це найцікавіше очікування
const almost = working.filter((g) => xlat(g) >= 70);

const fundraisers = games.filter((g) => g.fundraisingGoal && !g.fundraisingCompleted);

// Нещодавно оновлені — беремо з реальної стрічки подій
const updatedIds = [...new Set(getAllUpdates().map((e) => e.gameId))];
const recent = updatedIds
  .map((id) => games.find((g) => g.id === id))
  .filter((g): g is G => !!g)
  .slice(0, 12);

// Showcase: свіжі доступні релізи
const featured = playable.slice(0, 5);

const playableCount = playable.length;

function fundPct(g: G): number {
  if (!g.fundraisingGoal) return 0;
  return Math.min(Math.round(((g.fundraisingRaised ?? 0) / g.fundraisingGoal) * 100), 100);
}

// Дані для клієнтського перемикача showcase
const featData = featured.map((g) => ({
  id: g.id,
  title: g.title,
  cover: g.cover,
  status: g.status,
  tags: g.tags.slice(0, 4),
  desc: g.description,
  download: g.downloadUrl ?? "",
  steam: g.steamUrl ?? "",
  series: g.series ?? "",
  year: g.gameYear ?? 0,
}));
---

<V4Layout>
  <!-- ── Header ── -->
  <header class="hd">
    <div class="wrap hd__in">
      <a href="/v4/" class="hd__brand">
        <span class="hd__mark">LB</span>
        <span>Little Bit</span>
      </a>

      <nav class="hd__nav">
        <a href="#store" class="is-on">Вітрина</a>
        <a href="#playable">Каталог</a>
        <a href="#working">У роботі</a>
        <a href="#fund">Підтримати</a>
      </nav>

      <div class="hd__right">
        <a href="https://lbklauncher.com/" target="_blank" rel="noopener" class="btn btn--go btn--sm">
          Завантажити лаунчер
        </a>
        <a href="/" class="hd__back">поточний сайт ↗</a>
      </div>
    </div>
  </header>

  <main id="store">
    <!-- ── Showcase ── -->
    {featured.length > 0 && (
      <section class="show">
        <!-- Розмита обкладинка як тло, як у картці гри в магазині -->
        <div class="show__bg" id="showBg" aria-hidden="true">
          <img id="showBgImg" src={featured[0].cover} alt="" decoding="async" />
          <div class="show__veil"></div>
        </div>

        <div class="wrap show__in">
          <div class="show__main">
            <img class="show__art" id="showArt" src={featured[0].cover} alt={featured[0].title} decoding="async" />

            <div class="show__body">
              <p class="show__kicker" id="showKicker">Нове в бібліотеці</p>
              <h1 class="show__t" id="showTitle">{featured[0].title}</h1>

              <div class="show__tags" id="showTags">
                {featured[0].tags.slice(0, 4).map((t) => <span class="tg">{t}</span>)}
              </div>

              <p class="show__d" id="showDesc">{featured[0].description}</p>

              <div class="show__price">
                <span class="free">Безкоштовно</span>
                <span class="show__note">українська локалізація</span>
              </div>

              <div class="show__cta">
                <a class="btn btn--go btn--lg" id="showPlay" href={`/games/${featured[0].id}/`}>
                  Завантажити переклад
                </a>
                <a class="btn btn--ghost btn--lg" id="showMore" href={`/games/${featured[0].id}/`}>
                  Детальніше
                </a>
              </div>
            </div>
          </div>

          <!-- Черга showcase — як у Steam праворуч -->
          <ol class="queue" id="showQueue">
            {featured.map((g, i) => (
              <li>
                <button class={`qi ${i === 0 ? "is-on" : ""}`} data-i={i} type="button">
                  <img src={g.cover} alt="" loading="lazy" decoding="async" />
                  <span class="qi__t">{g.title}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- ── Полиця: можна грати ── -->
    <section class="shelf-sec" id="playable">
      <div class="wrap">
        <div class="sh-head">
          <h2>Можна грати зараз</h2>
          <span class="sh-count">{playableCount}</span>
          <div class="sh-nav">
            <button class="arw" data-scroll="playRow" data-dir="-1" aria-label="Назад">‹</button>
            <button class="arw" data-scroll="playRow" data-dir="1" aria-label="Далі">›</button>
          </div>
        </div>

        <div class="shelf" id="playRow">
          {playable.map((g) => (
            <a href={`/games/${g.id}/`} class="cd">
              <span class="cd__art">
                <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                <span class="cd__over">
                  <span class="cd__tags">
                    {g.tags.slice(0, 3).map((t) => <span class="tg tg--sm">{t}</span>)}
                  </span>
                  <span class="cd__go">Завантажити</span>
                </span>
                {g.status === "done" && <span class="cd__badge">повний переклад</span>}
              </span>
              <span class="cd__t">{g.title}</span>
              <span class="cd__price free">Безкоштовно</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Полиця: щойно оновлені ── -->
    {recent.length > 0 && (
      <section class="shelf-sec">
        <div class="wrap">
          <div class="sh-head">
            <h2>Щойно оновлені</h2>
            <span class="sh-count">{recent.length}</span>
            <div class="sh-nav">
              <button class="arw" data-scroll="recRow" data-dir="-1" aria-label="Назад">‹</button>
              <button class="arw" data-scroll="recRow" data-dir="1" aria-label="Далі">›</button>
            </div>
          </div>

          <div class="shelf" id="recRow">
            {recent.map((g) => (
              <a href={`/games/${g.id}/`} class="cd">
                <span class="cd__art">
                  <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                  <span class="cd__over">
                    <span class="cd__tags">
                      {g.tags.slice(0, 3).map((t) => <span class="tg tg--sm">{t}</span>)}
                    </span>
                    <span class="cd__go">{isPlayable(g) ? "Завантажити" : "Стежити"}</span>
                  </span>
                </span>
                <span class="cd__t">{g.title}</span>
                {isPlayable(g) ? (
                  <span class="cd__price free">Безкоштовно</span>
                ) : (
                  <span class="cd__prog">
                    <span class="cd__bar"><span style={`width:${xlat(g)}%`}></span></span>
                    <span class="cd__pct">{xlat(g)}%</span>
                  </span>
                )}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Полиця: скоро ── -->
    {almost.length > 0 && (
      <section class="shelf-sec">
        <div class="wrap">
          <div class="sh-head">
            <h2>Скоро вийде</h2>
            <span class="sh-count">{almost.length}</span>
            <div class="sh-nav">
              <button class="arw" data-scroll="soonRow" data-dir="-1" aria-label="Назад">‹</button>
              <button class="arw" data-scroll="soonRow" data-dir="1" aria-label="Далі">›</button>
            </div>
          </div>

          <div class="shelf" id="soonRow">
            {almost.map((g) => (
              <a href={`/games/${g.id}/`} class="cd">
                <span class="cd__art">
                  <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                  <span class="cd__over">
                    <span class="cd__tags">
                      {g.tags.slice(0, 3).map((t) => <span class="tg tg--sm">{t}</span>)}
                    </span>
                    <span class="cd__go">Стежити</span>
                  </span>
                  <span class="cd__badge cd__badge--soon">{xlat(g)}%</span>
                </span>
                <span class="cd__t">{g.title}</span>
                <span class="cd__prog">
                  <span class="cd__bar"><span style={`width:${xlat(g)}%`}></span></span>
                  <span class="cd__pct">{g.stage ?? "Переклад"}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Збори — банер, як акція в магазині ── -->
    {fundraisers.length > 0 && (
      <section class="shelf-sec" id="fund">
        <div class="wrap">
          <div class="sh-head">
            <h2>Збираємо на переклад</h2>
            <span class="sh-count">{fundraisers.length}</span>
          </div>

          <div class="fnd">
            {fundraisers.map((g) => (
              <a href={`/games/${g.id}/`} class="fbn">
                <span class="fbn__bg" aria-hidden="true">
                  <img src={g.cover} alt="" loading="lazy" decoding="async" />
                </span>
                <img class="fbn__art" src={g.cover} alt="" loading="lazy" decoding="async" />
                <span class="fbn__b">
                  <span class="fbn__k">Активний збір</span>
                  <span class="fbn__t">{g.title}</span>
                  {g.fundraisingDescription && (
                    <span class="fbn__d">{g.fundraisingDescription}</span>
                  )}
                  <span class="fbn__bar"><span style={`width:${fundPct(g)}%`}></span></span>
                  <span class="fbn__n">
                    <b>{(g.fundraisingRaised ?? 0).toLocaleString("uk-UA")} ₴</b>
                    <span>із {g.fundraisingGoal!.toLocaleString("uk-UA")} ₴</span>
                    <span class="fbn__pct">{fundPct(g)}%</span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Уся решта ── -->
    <section class="shelf-sec" id="working">
      <div class="wrap">
        <div class="sh-head">
          <h2>У роботі</h2>
          <span class="sh-count">{working.length}</span>
        </div>

        <div class="grid">
          {working.map((g) => (
            <a href={`/games/${g.id}/`} class="cd cd--grid">
              <span class="cd__art">
                <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                <span class="cd__over">
                  <span class="cd__tags">
                    {g.tags.slice(0, 3).map((t) => <span class="tg tg--sm">{t}</span>)}
                  </span>
                  <span class="cd__go">Стежити</span>
                </span>
                {g.fundraisingGoal && !g.fundraisingCompleted && (
                  <span class="cd__badge cd__badge--fund">збір</span>
                )}
              </span>
              <span class="cd__t">{g.title}</span>
              <span class="cd__prog">
                <span class="cd__bar"><span style={`width:${xlat(g)}%`}></span></span>
                <span class="cd__pct">{xlat(g)}%</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="wrap ft__in">
      <span>Прототип v4 · вітрина</span>
      <a href="/">← поточний сайт</a>
    </div>
  </footer>
</V4Layout>

<script define:vars={{ featData }}>
  // ── Перемикач showcase ──
  const bgImg  = document.getElementById("showBgImg");
  const art    = document.getElementById("showArt");
  const title  = document.getElementById("showTitle");
  const desc   = document.getElementById("showDesc");
  const tags   = document.getElementById("showTags");
  const play   = document.getElementById("showPlay");
  const more   = document.getElementById("showMore");
  const kicker = document.getElementById("showKicker");
  const queue  = document.getElementById("showQueue");

  function paint(i) {
    const g = featData[i];
    if (!g) return;
    bgImg.src = g.cover;
    art.src = g.cover;
    art.alt = g.title;
    title.textContent = g.title;
    desc.textContent = g.desc;
    kicker.textContent = g.status === "done" ? "Повністю українською" : "Ранній доступ";
    tags.innerHTML = g.tags.map((t) => `<span class="tg">${t}</span>`).join("");
    play.href = g.download || `/games/${g.id}/`;
    if (g.download) { play.target = "_blank"; play.rel = "noopener"; }
    else { play.removeAttribute("target"); play.removeAttribute("rel"); }
    more.href = `/games/${g.id}/`;

    queue.querySelectorAll(".qi").forEach((b, n) => b.classList.toggle("is-on", n === i));
  }

  queue?.querySelectorAll(".qi").forEach((btn) => {
    const i = Number(btn.dataset.i);
    btn.addEventListener("click", () => paint(i));
    btn.addEventListener("mouseenter", () => paint(i));
  });

  paint(0);

  // ── Стрілки полиць ──
  document.querySelectorAll("[data-scroll]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = document.getElementById(btn.dataset.scroll);
      if (!row) return;
      row.scrollBy({ left: Number(btn.dataset.dir) * row.clientWidth * 0.8, behavior: "smooth" });
    });
  });
</script>

<style>
  /* ─── Header ───────────────────────────────────────────────── */
  .hd {
    position: sticky; top: 0; z-index: 40;
    background: rgba(13, 19, 25, .92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .hd__in { display: flex; align-items: center; gap: 1.5rem; height: 60px; }
  .hd__brand { display: flex; align-items: center; gap: .6rem; color: var(--fg); font-weight: 700; font-size: .95rem; }
  .hd__mark {
    display: grid; place-items: center;
    width: 30px; height: 30px; border-radius: var(--r);
    background: var(--go); color: #0B0F14; font-weight: 800; font-size: .72rem;
  }
  .hd__nav { display: none; gap: .3rem; }
  @media (min-width: 900px) { .hd__nav { display: flex; } }
  .hd__nav a {
    padding: .4rem .8rem; border-radius: var(--r);
    font-size: .85rem; font-weight: 500; color: var(--fg-2);
    transition: background .15s, color .15s;
  }
  .hd__nav a:hover { background: var(--panel-2); color: var(--fg); }
  .hd__nav a.is-on { color: var(--fg); background: var(--panel-2); }

  .hd__right { display: flex; align-items: center; gap: 1rem; margin-left: auto; }
  .hd__back { font-size: .74rem; color: var(--fg-3); white-space: nowrap; display: none; }
  @media (min-width: 1100px) { .hd__back { display: inline; } }
  .hd__back:hover { color: var(--fg); }

  /* ─── Buttons ──────────────────────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: .6rem 1.2rem; border-radius: var(--r);
    font-weight: 600; font-size: .88rem;
    border: 1px solid transparent;
    transition: background .15s, border-color .15s, color .15s, transform .1s;
    white-space: nowrap;
  }
  .btn:active { transform: translateY(1px); }
  .btn--sm { padding: .42rem .85rem; font-size: .78rem; }
  .btn--lg { padding: .8rem 1.7rem; font-size: .95rem; }
  .btn--go { background: var(--go); color: #0B0F14; }
  .btn--go:hover { background: var(--go-2); }
  .btn--ghost { background: var(--panel-2); color: var(--fg); border-color: var(--line); }
  .btn--ghost:hover { background: var(--panel-3); }

  /* ─── Showcase ─────────────────────────────────────────────── */
  .show { position: relative; padding: 2.5rem 0 3rem; overflow: hidden; }

  .show__bg { position: absolute; inset: 0; z-index: 0; }
  .show__bg img {
    width: 100%; height: 100%; object-fit: cover;
    filter: blur(46px) saturate(1.25);
    transform: scale(1.2);
    opacity: .32;
    transition: opacity .35s;
  }
  .show__veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(13,19,25,.55) 0%, rgba(13,19,25,.86) 62%, var(--bg) 100%);
  }

  .show__in { position: relative; z-index: 1; display: grid; gap: 1.25rem; }
  @media (min-width: 1000px) {
    .show__in { grid-template-columns: minmax(0, 1fr) 268px; gap: 1.5rem; }
  }

  .show__main { display: grid; gap: 1.5rem; align-content: start; }
  @media (min-width: 640px) {
    .show__main { grid-template-columns: 210px minmax(0, 1fr); gap: 1.75rem; }
  }

  .show__art {
    width: 100%; max-width: 210px;
    aspect-ratio: 2/3; object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 20px 48px -18px rgba(0,0,0,.85);
  }

  .show__body { min-width: 0; align-self: center; }
  .show__kicker {
    margin: 0 0 .55rem;
    font-size: .72rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--go);
  }
  .show__t {
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: 800; margin-bottom: .75rem;
  }
  .show__tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .9rem; }
  .show__d {
    font-size: .88rem; line-height: 1.6; margin: 0 0 1.2rem;
    max-width: 60ch; color: var(--fg-2);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .show__price { display: flex; align-items: baseline; gap: .6rem; margin-bottom: 1.1rem; }
  .show__note { font-size: .76rem; color: var(--fg-3); }
  .show__cta { display: flex; flex-wrap: wrap; gap: .55rem; }

  .free {
    display: inline-block;
    padding: .22rem .6rem;
    border-radius: 4px;
    background: rgba(123, 198, 45, .16);
    color: var(--go);
    font-weight: 700; font-size: .82rem;
  }

  .tg {
    display: inline-block;
    padding: .2rem .55rem;
    border-radius: 4px;
    background: rgba(232,238,244,.09);
    font-size: .72rem; color: var(--fg-2);
    white-space: nowrap;
  }
  .tg--sm { font-size: .64rem; padding: .12rem .4rem; }

  /* Черга showcase */
  .queue { list-style: none; margin: 0; padding: 0; display: none; flex-direction: column; gap: .3rem; }
  @media (min-width: 1000px) { .queue { display: flex; } }
  .qi {
    display: flex; align-items: center; gap: .7rem; width: 100%;
    padding: .45rem .6rem;
    background: transparent; border: 0; border-radius: var(--r);
    cursor: pointer; text-align: left;
    transition: background .15s;
  }
  .qi:hover { background: rgba(232,238,244,.06); }
  .qi.is-on { background: var(--panel-2); }
  .qi img { width: 34px; height: 48px; object-fit: cover; border-radius: 3px; flex-shrink: 0; }
  .qi__t {
    font-size: .78rem; color: var(--fg-2); line-height: 1.3;
    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .qi.is-on .qi__t { color: var(--fg); }

  /* ─── Полиці ───────────────────────────────────────────────── */
  .shelf-sec { padding: 1.75rem 0; }

  .sh-head { display: flex; align-items: center; gap: .75rem; margin-bottom: 1rem; }
  .sh-head h2 { font-size: 1.15rem; font-weight: 700; }
  .sh-count {
    font-size: .78rem; font-weight: 600; color: var(--fg-3);
    background: var(--panel-2); padding: .1rem .5rem; border-radius: 999px;
  }
  .sh-nav { margin-left: auto; display: none; gap: .35rem; }
  @media (min-width: 768px) { .sh-nav { display: flex; } }
  .arw {
    width: 30px; height: 30px; border-radius: var(--r);
    background: var(--panel-2); border: 1px solid var(--line);
    color: var(--fg-2); font-size: 1.1rem; line-height: 1;
    cursor: pointer; transition: background .15s, color .15s;
  }
  .arw:hover { background: var(--panel-3); color: var(--fg); }

  .shelf {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 152px;
    gap: .85rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: .5rem;
    scrollbar-width: thin;
  }
  @media (min-width: 768px) { .shelf { grid-auto-columns: 178px; } }
  .shelf > * { scroll-snap-align: start; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 1.25rem .85rem;
  }

  /* ─── Картка ───────────────────────────────────────────────── */
  .cd { display: flex; flex-direction: column; gap: .5rem; min-width: 0; }

  .cd__art {
    position: relative;
    aspect-ratio: 2/3;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--panel-2);
    box-shadow: 0 6px 18px -10px rgba(0,0,0,.8);
    transition: transform .2s cubic-bezier(.16,1,.3,1), box-shadow .2s;
  }
  .cd__art img { width: 100%; height: 100%; object-fit: cover; }
  .cd:hover .cd__art {
    transform: translateY(-4px);
    box-shadow: 0 16px 30px -12px rgba(0,0,0,.9);
  }

  /* Ховер розкриває теги й дію — як у магазині */
  .cd__over {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: flex-end;
    gap: .5rem; padding: .6rem;
