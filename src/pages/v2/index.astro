---
// ─── V2 Prototype — головна ───────────────────────────────────
// Структура будується навколо одного питання користувача:
// «чи можу я грати цю гру українською просто зараз?»
// Тому: полиця готового (без відсотків) + список у роботі (з відсотками).

import V2Layout from "../../layouts/V2Layout.astro";
import { games } from "../../data/games";
import { getAllUpdates, formatUpdateDate } from "../../utils/updates";
import { pluralize } from "../../utils/pluralize";

// ── Групування за дією, а не за внутрішнім статусом ──
const playable = games
  .filter((g) => g.status === "done" || g.status === "early-access")
  .sort((a, b) => (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? ""));

/** Стадія перекладу окремо від загальної готовності */
function xlat(g: (typeof games)[number]): number {
  const s = g.stageDetails ?? [];
  return (s.find((d) => /переклад/i.test(d.label)) ?? s[0])?.percent ?? g.progress;
}

// Сортуємо саме за тим числом, яке показуємо — інакше 100% опинявся
// між 80% і 70%, бо g.progress і відсоток перекладу це різні величини.
const working = games
  .filter((g) => g.status === "in-progress" || g.status === "fundraising")
  .sort((a, b) => xlat(b) - xlat(a));

const fundraisers = games.filter((g) => g.fundraisingGoal && !g.fundraisingCompleted);

// ── Обсяг роботи — реальна цифра, не «х років досвіду» ──
const totalLines = games.reduce((n, g) => n + (g.stats?.translatedLines ?? 0), 0);

const latest = getAllUpdates().slice(0, 5);

function fundPercent(g: (typeof games)[number]): number {
  if (!g.fundraisingGoal) return 0;
  return Math.min(Math.round(((g.fundraisingRaised ?? 0) / g.fundraisingGoal) * 100), 100);
}
---

<V2Layout>
  <!-- ── Header ── -->
  <header class="hd">
    <div class="wrap hd__in">
      <a href="/v2/" class="hd__brand">
        <span class="hd__mark">LB</span>
        <span class="hd__name">Little&nbsp;Bit</span>
      </a>
      <nav class="hd__nav">
        <a href="#playable">Готове</a>
        <a href="#working">У роботі</a>
        <a href="#support">Підтримати</a>
      </nav>
      <a href="/" class="hd__back">← поточний сайт</a>
    </div>
  </header>

  <main>
    <!-- ── Hero: тип несе екран, обкладинок тут немає навмисно ── -->
    <section class="hero">
      <div class="wrap">
        <p class="hero__eyebrow">Українська локалізація відеоігор</p>

        <h1 class="hero__h">
          Перекладаємо те,<br />
          у що <span class="hero__em">самі граємо</span>
        </h1>

        <p class="hero__sub">
          Сюжет, інтерфейс і дрібниці — українською.
          Без машинного перекладу, без компромісів.
        </p>

        <div class="hero__figures">
          <div class="fig fig--lead">
            <span class="fig__n tnum">{playable.length}</span>
            <span class="fig__l">{pluralize(playable.length, "гра", "гри", "ігор")}<br />можна грати</span>
          </div>
          <div class="fig">
            <span class="fig__n fig__n--sm tnum">{working.length}</span>
            <span class="fig__l">у роботі</span>
          </div>
          <div class="fig">
            <span class="fig__n fig__n--sm tnum">{Math.round(totalLines / 1000)}K</span>
            <span class="fig__l">рядків<br />перекладено</span>
          </div>
        </div>

        <div class="hero__cta">
          <a href="#playable" class="btn btn--solid">Що можна грати</a>
          <a href="https://lbklauncher.com/" target="_blank" rel="noopener" class="btn btn--line">
            Завантажити LBK Launcher
          </a>
        </div>
      </div>

      <!-- Живий доказ активності — те, що зараз сховане на /updates -->
      <div class="ticker" aria-label="Останні оновлення">
        <div class="ticker__track">
          {[...latest, ...latest].map((e) => (
            <span class="ticker__item">
              <span class="ticker__dot" data-kind={e.kind}></span>
              <span class="ticker__title">{e.gameTitle}</span>
              <span class="ticker__date">{formatUpdateDate(e.date)}</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Полиця готового: жодних відсотків, лише дія ── -->
    <section id="playable" class="sec">
      <div class="wrap">
        <div class="eyebrow">
          Можна грати зараз <span class="eyebrow__n">{playable.length}</span>
        </div>

        <div class="shelf">
          {playable.map((g) => (
            <a href={`/games/${g.id}/`} class="tile">
              <div class="tile__art">
                <img src={g.cover} alt={g.title} loading="lazy" decoding="async" />
                {g.status === "done" && <span class="tile__flag">повністю</span>}
              </div>
              <h3 class="tile__t">{g.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── У роботі: список, бо тут відсоток і є змістом ── -->
    <section id="working" class="sec sec--alt">
      <div class="wrap">
        <div class="eyebrow">
          У роботі <span class="eyebrow__n">{working.length}</span>
        </div>

        <ol class="queue">
          {working.map((g) => (
            <li class="row">
              <a href={`/games/${g.id}/`} class="row__in">
                <img class="row__art" src={g.cover} alt="" loading="lazy" decoding="async" />
                <span class="row__t">{g.title}</span>
                <span class="row__stage">{g.stage ?? "Переклад"}</span>
                <span class="row__bar">
                  <span class="row__fill" style={`width:${xlat(g)}%`}></span>
                </span>
                <span class="row__n tnum">{xlat(g)}%</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Збори: рідкісні, тому їм дають вагу ── -->
    {fundraisers.length > 0 && (
      <section id="support" class="sec">
        <div class="wrap">
          <div class="eyebrow">
            Збираємо на переклад <span class="eyebrow__n">{fundraisers.length}</span>
          </div>

          <div class="funds">
            {fundraisers.map((g) => (
              <article class="fund">
                <img class="fund__art" src={g.cover} alt="" loading="lazy" decoding="async" />
                <div class="fund__body">
                  <h3 class="fund__t">{g.title}</h3>
                  {g.fundraisingDescription && (
                    <p class="fund__d">{g.fundraisingDescription}</p>
                  )}
                  <div class="fund__meter">
                    <span class="fund__fill" style={`width:${fundPercent(g)}%`}></span>
                  </div>
                  <p class="fund__num">
                    <strong class="tnum">{(g.fundraisingRaised ?? 0).toLocaleString("uk-UA")} ₴</strong>
                    <span class="tnum">із {g.fundraisingGoal!.toLocaleString("uk-UA")} ₴</span>
                    <span class="fund__pct tnum">{fundPercent(g)}%</span>
                  </p>
                  <a href={g.donateUrl} target="_blank" rel="noopener" class="btn btn--ember">
                    Підтримати
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="ft">
    <div class="wrap ft__in">
      <p class="ft__note">
        Прототип дизайну. Поточний сайт — <a href="/">на головній</a>.
      </p>
      <p class="ft__note">«Little Bit» · Українські локалізації</p>
    </div>
  </footer>
</V2Layout>

<style>
  /* ─── Header ───────────────────────────────────────────────── */
  .hd {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .hd__in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 68px;
  }
  .hd__brand { display: flex; align-items: center; gap: 0.65rem; }
  .hd__mark {
    display: grid;
    place-items: center;
    width: 30px; height: 30px;
    border-radius: 7px;
    background: var(--wheat);
    color: var(--ground);
    font-family: "Unbounded", sans-serif;
    font-weight: 900;
    font-size: 0.7rem;
    letter-spacing: -0.04em;
  }
  .hd__name {
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--paper);
  }
  .hd__nav {
    display: none;
    gap: 1.75rem;
    margin-left: auto;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .hd__nav a { color: var(--paper-dim); transition: color .18s; }
  .hd__nav a:hover { color: var(--wheat); }
  .hd__back {
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--paper-faint);
    white-space: nowrap;
    transition: color .18s;
  }
  .hd__back:hover { color: var(--paper); }
  @media (min-width: 820px) {
    .hd__nav { display: flex; }
    .hd__back { margin-left: 0; }
  }

  /* ─── Hero ─────────────────────────────────────────────────── */
  .hero { padding: clamp(3.5rem, 9vw, 7rem) 0 0; }

  .hero__eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wheat);
    margin: 0 0 1.5rem;
  }

  .hero__h {
    font-size: clamp(2.4rem, 7.2vw, 5.25rem);
    font-weight: 900;
    margin-bottom: 1.5rem;
  }
  .hero__em {
    color: var(--wheat);
    /* Підкреслення як редакторська позначка — тема команди */
    box-shadow: inset 0 -0.11em 0 var(--wheat-deep);
  }

  .hero__sub {
    max-width: 44ch;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--paper-dim);
    margin: 0 0 3rem;
  }

  /* Цифри — головна, дві допоміжні */
  /* Стовпчики, а не baseline-рядок: підписи різної висоти
     інакше «стрибають» по вертикалі. */
  .hero__figures {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 2rem 3.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }
  .fig { display: flex; flex-direction: column; gap: 0.5rem; }
  .fig__n {
    font-family: "Unbounded", sans-serif;
    font-weight: 900;
    font-size: 2.1rem;
    line-height: 0.85;
    color: var(--paper);
  }
  .fig--lead .fig__n {
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    color: var(--wheat);
  }
  .fig__n--sm { font-size: 2.1rem; }
  .fig__l {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--paper-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 2.75rem 0 3.5rem;
  }

  /* ─── Buttons ──────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.4rem;
    border-radius: 4px;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border: 1px solid transparent;
    transition: background .18s, color .18s, border-color .18s, transform .12s;
  }
  .btn:active { transform: translateY(1px); }
  .btn--solid { background: var(--wheat); color: var(--ground); }
  .btn--solid:hover { background: #F5C960; }
  .btn--line { border-color: var(--line-2); color: var(--paper); }
  .btn--line:hover { border-color: var(--paper-dim); background: var(--surface); }
  .btn--ember { background: var(--ember); color: #fff; align-self: flex-start; }
  .btn--ember:hover { filter: brightness(1.08); }

  /* ─── Ticker ───────────────────────────────────────────────── */
  .ticker {
    border-block: 1px solid var(--line);
    overflow: hidden;
    padding: 0.85rem 0;
    background: var(--surface);
  }
  .ticker__track {
    display: flex;
    gap: 3rem;
    width: max-content;
    animation: slide 44s linear infinite;
  }
  .ticker:hover .ticker__track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.76rem;
    white-space: nowrap;
    color: var(--paper-faint);
  }
  .ticker__dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--paper-faint);
  }
  .ticker__dot[data-kind="release"] { background: var(--sprout); }
  .ticker__dot[data-kind="early-access"] { background: var(--wheat); }
  .ticker__title { color: var(--paper); font-weight: 600; }

  /* ─── Sections ─────────────────────────────────────────────── */
  .sec { padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
  .sec--alt { background: var(--surface); border-block: 1px solid var(--line); }

  /* ─── Shelf (playable) ─────────────────────────────────────── */
  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(132px, 1fr));
    gap: 1.5rem 1.1rem;
  }
  @media (min-width: 768px) {
    .shelf { grid-template-columns: repeat(auto-fill, minmax(158px, 1fr)); }
  }

  .tile__art {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: 3px;
    overflow: hidden;
    background: var(--surface-2);
    transition: transform .25s cubic-bezier(.16,1,.3,1);
  }
  .tile__art img { width: 100%; height: 100%; object-fit: cover; }
  .tile:hover .tile__art { transform: translateY(-5px); }

  .tile__flag {
    position: absolute;
    left: 0; bottom: 0;
    padding: 0.18rem 0.5rem;
    background: var(--wheat);
    color: var(--ground);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Дві лінії завжди — інакше ряд плитки має рваний низ */
  .tile__t {
    font-family: "Onest", sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.32;
    color: var(--paper-dim);
    margin-top: 0.65rem;
    letter-spacing: 0;
    transition: color .18s;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.32em * 2);
  }
  .tile:hover .tile__t { color: var(--paper); }

  /* ─── Queue (in progress) ──────────────────────────────────── */
  .queue { list-style: none; margin: 0; padding: 0; }
  .row + .row { border-top: 1px solid var(--line); }

  .row__in {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    grid-template-areas:
      "art title title"
      "art bar   num";
    align-items: center;
    gap: 0.35rem 0.9rem;
    padding: 0.85rem 0.25rem;
    transition: background .18s;
  }
  .row__in:hover { background: var(--surface-2); }

  .row__art {
    grid-area: art;
    width: 30px; height: 42px;
    object-fit: cover;
    border-radius: 2px;
  }
  .row__t {
    grid-area: title;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--paper);
    line-height: 1.3;
  }
  .row__stage { display: none; }
  .row__bar {
    grid-area: bar;
    height: 3px;
    background: var(--line-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .row__fill { display: block; height: 100%; background: var(--wheat); }
  .row__n {
    grid-area: num;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--wheat);
    min-width: 3.2ch;
    text-align: right;
  }

  @media (min-width: 720px) {
    .row__in {
      grid-template-columns: 34px minmax(0, 1fr) 108px minmax(120px, 200px) 3.5rem;
      grid-template-areas: "art title stage bar num";
      gap: 1.25rem;
      padding: 0.7rem 0.25rem;
    }
    .row__art { width: 34px; height: 48px; }
    .row__stage {
      grid-area: stage;
      display: block;
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--paper-faint);
    }
  }

  /* ─── Fundraising ──────────────────────────────────────────── */
  .funds {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 860px) { .funds { grid-template-columns: 1fr 1fr; } }

  .fund {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .fund__art {
    width: 84px;
    aspect-ratio: 2/3;
    object-fit: cover;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .fund__body { display: flex; flex-direction: column; min-width: 0; }
  .fund__t {
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }
  .fund__d {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--paper-faint);
    margin: 0 0 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fund__meter {
    height: 5px;
    background: var(--line-2);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.55rem;
  }
  .fund__fill { display: block; height: 100%; background: var(--ember); }
  .fund__num {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: var(--paper-faint);
    margin: 0 0 1rem;
  }
  .fund__num strong { color: var(--paper); font-size: 0.92rem; }
  .fund__pct { margin-left: auto; color: var(--ember); font-weight: 700; }

  /* ─── Footer ───────────────────────────────────────────────── */
  .ft { border-top: 1px solid var(--line); padding: 2.5rem 0; }
  .ft__in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ft__note { font-size: 0.75rem; color: var(--paper-faint); margin: 0; }
  .ft__note a { color: var(--wheat); }
</style>
