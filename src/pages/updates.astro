---
// ─── Updates Page ──────────────────────────────────────────────
// Хроніка оновлень: зібрана з progressHistory та lastUpdate усіх ігор.
import Layout from "../layouts/Layout.astro";
import { getAllUpdates, formatUpdateDate, eventTone } from "../utils/updates";
import { SITE_URL } from "../utils/seo";

const events = getAllUpdates();

const groups = new Map<string, typeof events>();
for (const e of events) {
  const key = e.date.slice(0, 7);
  groups.set(key, [...(groups.get(key) ?? []), e]);
}

const monthTitle = (ym: string) => {
  const [y, m] = ym.split("-").map(Number);
  return new Date(y, m - 1, 1).toLocaleDateString("uk-UA", { month: "long", year: "numeric" });
};
---

<Layout
  title="Оновлення локалізацій Yakuza, MGS, NieR — «Little Bit»"
  description="Усі оновлення проєктів локалізації «Little Bit»: прогрес перекладу, релізи, ранній доступ. Можна підписатися через RSS."
  canonicalUrl={`${SITE_URL}/updates`}
>
  <div class="page container narrow">
    <header class="section-head">
      <div>
        <span class="eyebrow">Хроніка</span>
        <h1 class="title">Оновлення локалізацій</h1>
        <p>Кожен крок наших проєктів: прогрес, релізи, ранній доступ.</p>
      </div>
      <a href="/rss.xml" class="btn btn--sm">Підписатися через RSS</a>
    </header>

    {events.length === 0 ? (
      <p class="empty">Поки що немає подій.</p>
    ) : (
      Array.from(groups.entries()).map(([key, list]) => (
        <section class="month">
          <h2>{monthTitle(key)}</h2>
          <ol>
            {list.map((e) => {
              const tone = eventTone(e.kind);
              return (
                <li>
                  <a href={`/games/${e.gameId}/`} class="event" style={`--state:${tone.color}`}>
                    <img src={e.gameCover} alt="" width="56" height="84" loading="lazy" decoding="async" />
                    <div class="event__body">
                      <p class="event__meta">
                        <span class="event__kind">{tone.label}</span>
                        <time datetime={e.date}>{formatUpdateDate(e.date)}</time>
                      </p>
                      <h3>{e.title}</h3>
                      <p class="event__text">{e.description}</p>
                      {typeof e.progress === "number" && (
                        <div class="event__progress">
                          <div class="bar"><i style={`width:${e.progress}%`}></i></div>
                          <span class="num">{e.progress}%</span>
                        </div>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    )}
  </div>
</Layout>

<style>
  .narrow { max-width: 960px; }
  .title { margin-top: 10px; font-size: clamp(1.8rem, 4vw, 3.25rem); text-transform: uppercase; }
  .empty { padding: 64px 0; color: var(--muted); text-align: center; }

  .month { margin-top: 40px; }
  .month h2 {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    padding: 12px 0;
    background: var(--bg);
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .month ol { border-top: 1px solid var(--line); }

  .event {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0 18px 14px;
    border-bottom: 1px solid var(--line);
    border-left: 3px solid var(--state);
    transition: background-color 0.18s ease;
  }
  .event:hover { background: var(--surface); }
  .event:hover h3 { color: var(--accent); }
  .event img { width: 56px; height: 84px; object-fit: cover; border: 1px solid var(--line); }
  .event__meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 12px; }
  .event__kind { color: var(--state); font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  .event__meta time { color: var(--faint); }
  .event h3 { margin: 6px 0 4px; font-family: var(--font-body); font-size: 1rem; font-weight: 800; letter-spacing: 0; transition: color 0.18s ease; }
  .event__text { color: var(--muted); font-size: 14px; }
  .event__progress { display: flex; align-items: center; gap: 10px; max-width: 240px; margin-top: 10px; }
  .event__progress .bar { flex: 1; }
  .event__progress span { color: var(--muted); font-size: 12px; }
</style>
