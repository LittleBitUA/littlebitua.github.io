---
// ─── Series Page ───────────────────────────────────────────────
import Layout from "../../../layouts/Layout.astro";
import GameCard from "../../../components/GameCard.astro";
import { SITE_URL, generateBreadcrumbs } from "../../../utils/seo";
import { getSeriesGroups } from "../../../utils/series";
import { pluralize } from "../../../utils/pluralize";
import { isPlayable } from "../../../utils/status";

export function getStaticPaths() {
  return getSeriesGroups().map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
const list = group.games;
const playable = list.filter(isPlayable).length;
const inProgress = list.filter((g) => g.status === "in-progress").length;
const noun = pluralize(list.length, "проєкт", "проєкти", "проєктів");

const canonicalUrl = `${SITE_URL}/games/series/${group.slug}/`;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    JSON.parse(
      generateBreadcrumbs([
        { name: "Головна", url: `${SITE_URL}/` },
        { name: "Локалізації", url: `${SITE_URL}/games/` },
        { name: group.name, url: canonicalUrl },
      ]),
    ),
    {
      "@type": "ItemList",
      name: `Локалізації серії ${group.name}`,
      numberOfItems: list.length,
      itemListElement: list.map((g, i) => ({ "@type": "ListItem", position: i + 1, name: g.title, url: `${SITE_URL}/games/${g.id}/` })),
    },
  ],
});
const others = getSeriesGroups().filter((g) => g.slug !== group.slug);
---

<Layout
  title={`${group.name} українською — усі локалізації «Little Bit»`}
  description={`Українські локалізації серії ${group.name}: ${list.length} ${noun}, з яких ${playable} вже можна грати.`}
  canonicalUrl={canonicalUrl}
  ogImage={list[0].cover}
  structuredData={structuredData}
>
  <div class="page container">
    <nav aria-label="Навігація">
      <ol class="crumbs">
        <li><a href="/">Головна</a></li>
        <li class="sep" aria-hidden="true">/</li>
        <li><a href="/games/">Каталог</a></li>
        <li class="sep" aria-hidden="true">/</li>
        <li aria-current="page">{group.name}</li>
      </ol>
    </nav>

    <header class="section-head head">
      <div>
        <span class="eyebrow">Серія · {list.length} {noun}</span>
        <h1 class="title">{group.name} українською</h1>
        <p>
          {playable > 0 ? `${playable} можна грати вже зараз` : "Поки що жодна гра серії не вийшла"}
          {inProgress > 0 && ` · ${inProgress} у роботі`}
        </p>
      </div>
    </header>

    <div class="game-grid">
      {list.map((game) => <GameCard game={game} />)}
    </div>

    {others.length > 0 && (
      <nav class="others" aria-label="Інші серії">
        <span>Інші серії</span>
        {others.map((s) => <a href={`/games/series/${s.slug}/`} class="chip">{s.name}<small>{s.games.length}</small></a>)}
      </nav>
    )}
  </div>
</Layout>

<style>
  .head { margin-top: 24px; }
  .title { margin-top: 10px; font-size: clamp(1.8rem, 4vw, 3.25rem); text-transform: uppercase; }
  .others { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 64px; padding-top: 20px; border-top: 1px solid var(--line); }
  .others > span { margin-right: 6px; color: var(--faint); font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .others small { color: var(--faint); font-size: 10px; }
</style>
