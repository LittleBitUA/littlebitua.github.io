---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import GameCard from "../../../components/GameCard.astro";
import Footer from "../../../components/Footer.astro";
import { SITE_URL, generateBreadcrumbs } from "../../../utils/seo";
import { getSeriesGroups } from "../../../utils/series";
import { pluralize } from "../../../utils/pluralize";

export function getStaticPaths() {
  return getSeriesGroups().map((group) => ({
    params: { slug: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
const seriesGames = group.games;

const doneCount = seriesGames.filter((g) => g.status === "done").length;
const earlyCount = seriesGames.filter((g) => g.status === "early-access").length;
const inProgressCount = seriesGames.filter((g) => g.status === "in-progress").length;
const playable = doneCount + earlyCount;

const avgProgress = Math.round(
  seriesGames.reduce((sum, g) => sum + g.progress, 0) / seriesGames.length
);

const canonicalUrl = `${SITE_URL}/games/series/${group.slug}/`;
const pageTitle = `${group.name} українською — усі локалізації Little Bit`;
const pageDesc = `Українські локалізації серії ${group.name}: ${seriesGames.length} ${pluralize(seriesGames.length, "проєкт", "проєкти", "проєктів")}, з яких ${playable} вже можна грати. Прогрес перекладу й завантаження.`;

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    JSON.parse(
      generateBreadcrumbs([
        { name: "Головна", url: `${SITE_URL}/` },
        { name: "Локалізації", url: `${SITE_URL}/games/` },
        { name: group.name, url: canonicalUrl },
      ])
    ),
    {
      "@type": "ItemList",
      name: `Локалізації серії ${group.name}`,
      numberOfItems: seriesGames.length,
      itemListElement: seriesGames.map((g, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: g.title,
        url: `${SITE_URL}/games/${g.id}/`,
      })),
    },
  ],
});

const otherSeries = getSeriesGroups().filter((g) => g.slug !== group.slug);
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={seriesGames[0].cover}
  structuredData={structuredData}
>
  <Header />

  <main class="flex-1 pt-28 pb-24">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumbs -->
      <nav class="mb-6" aria-label="Навігація">
        <ol class="flex items-center gap-1.5 text-xs text-slate-500 flex-wrap">
          <li><a href="/" class="hover:text-indigo-400 transition-colors">Головна</a></li>
          <li aria-hidden="true">
            <svg class="w-3 h-3 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li><a href="/games/" class="hover:text-indigo-400 transition-colors">Локалізації</a></li>
          <li aria-hidden="true">
            <svg class="w-3 h-3 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li class="text-slate-300 font-semibold">{group.name}</li>
        </ol>
      </nav>

      <!-- Page header -->
      <div class="mb-8" data-animate>
        <div class="flex items-end justify-between gap-4 flex-wrap">
          <div>
            <span class="lb-section-eyebrow">Серія</span>
            <h1 class="text-2xl sm:text-3xl font-black text-white mt-1 leading-tight">
              {group.name} українською
            </h1>
          </div>
          <div class="text-right shrink-0">
            <span class="text-2xl font-black text-slate-100 tabular-nums">{seriesGames.length}</span>
            <span class="text-xs font-semibold text-slate-500 block mt-0.5">
              {pluralize(seriesGames.length, "проєкт", "проєкти", "проєктів")}
            </span>
          </div>
        </div>

        <div class="flex flex-wrap gap-x-5 gap-y-1 mt-3">
          {playable > 0 && (
            <span class="text-xs font-bold" style="color:#34d399;">{playable} можна грати</span>
          )}
          {inProgressCount > 0 && (
            <>
              <span class="text-xs font-semibold text-slate-500">·</span>
              <span class="text-xs font-bold" style="color:#a78bfa;">{inProgressCount} у роботі</span>
            </>
          )}
          <span class="text-xs font-semibold text-slate-500">·</span>
          <span class="text-xs font-bold" style="color:#818cf8;">{avgProgress}% середній прогрес</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4">
        {seriesGames.map((game) => <GameCard game={game} />)}
      </div>

      <!-- Other series -->
      {otherSeries.length > 0 && (
        <section class="mt-14 pt-8 border-t border-white/8" data-animate>
          <h2 class="text-[0.7rem] font-bold uppercase tracking-[0.1em] text-slate-500 mb-3">
            Інші серії
          </h2>
          <div class="flex flex-wrap gap-2">
            {otherSeries.map((s) => (
              <a
                href={`/games/series/${s.slug}/`}
                class="lb-glass px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-300 hover:text-white transition-colors lb-lift"
              >
                {s.name}
                <span class="text-xs text-slate-500 ml-1.5 tabular-nums">{s.games.length}</span>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>
