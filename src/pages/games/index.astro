---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import GameCard from "../../components/GameCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import Footer from "../../components/Footer.astro";
import { games } from "../../data/games";
import { SITE_URL } from "../../utils/seo";
import { pluralize } from "../../utils/pluralize";
import { getSeriesGroups } from "../../utils/series";

const seriesGroups = getSeriesGroups();

const STATUS_PRIORITY: Record<string, number> = { done: 0, "early-access": 1, "in-progress": 2, fundraising: 3 };

const sortedGames = [...games].sort((a, b) => {
  const pa = STATUS_PRIORITY[a.status] ?? 9;
  const pb = STATUS_PRIORITY[b.status] ?? 9;
  if (pa !== pb) return pa - pb;
  return (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? "");
});

const doneCount = games.filter((g) => g.status === "done").length;
const earlyCount = games.filter((g) => g.status === "early-access").length;
const playable = doneCount + earlyCount;

const canonicalUrl = `${SITE_URL}/games/`;
const pageTitle = "Усі локалізації — Little Bit";
const pageDesc = `Каталог українських локалізацій від Little Bit: ${games.length} ігор, з яких ${playable} вже можна грати.`;
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <main class="flex-1 pt-28 pb-24">

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" style="z-index:1;">

      <!-- Page header -->
      <div class="mb-8" data-animate>
        <div class="flex items-end justify-between gap-4">
          <div>
            <span class="lb-section-eyebrow">Каталог</span>
            <h1 class="text-2xl sm:text-3xl font-black text-white mt-1 leading-tight">
              Усі локалізації
            </h1>
          </div>
          <div class="text-right shrink-0">
            <span class="text-2xl font-black text-slate-100">{games.length}</span>
            <span class="text-xs font-semibold text-slate-500 block mt-0.5">{pluralize(games.length, "проєкт", "проєкти", "проєктів")}</span>
          </div>
        </div>

        <!-- Quick stats row -->
        <div class="flex flex-wrap gap-x-5 gap-y-1 mt-3">
          <a href="/games/" class="qs-link" style="color:#34d399;">
            {playable} можна грати
          </a>
          <span class="text-xs font-semibold text-slate-500">·</span>
          <a href="/games/?status=in-progress" class="qs-link" style="color:#a78bfa;">
            {games.filter((g) => g.status === "in-progress").length} у роботі
          </a>
          <span class="text-xs font-semibold text-slate-500">·</span>
          <a href="/games/?status=fundraising" class="qs-link" style="color:#f59e0b;">
            {games.filter((g) => g.fundraisingGoal && !g.fundraisingCompleted).length} збір коштів
          </a>
        </div>
      </div>

      <FilterBar />

      <div
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4"
        id="games-grid"
      >
        {sortedGames.map((game) => <GameCard game={game} />)}
      </div>

      <!-- Series -->
      {seriesGroups.length > 0 && (
        <section class="mt-14 pt-8 border-t border-white/8" data-animate>
          <h2 class="text-[0.7rem] font-bold uppercase tracking-[0.1em] text-slate-500 mb-3">
            За серіями
          </h2>
          <div class="flex flex-wrap gap-2">
            {seriesGroups.map((s) => (
              <a
                href={`/games/series/${s.slug}/`}
                class="lb-glass px-3.5 py-2 rounded-xl text-sm font-semibold text-slate-300 hover:text-white transition-colors lb-lift"
              >
                {s.name}
                <span class="text-xs text-slate-500 ml-1.5 tabular-nums">{s.games.length}</span>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .qs-link {
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.15s ease;
    text-underline-offset: 3px;
  }
  .qs-link:hover {
    opacity: 1;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }
</style>
