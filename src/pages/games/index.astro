---
// ─── Каталог ───────────────────────────────────────────────────
// Шапка з підсумками за статусами (вони ж фільтри), коротке пояснення
// статусів, серії, липка панель пошуку й сітка постерів.
import Layout from "../../layouts/Layout.astro";
import CatalogCard from "../../components/CatalogCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import { games } from "../../data/catalog";
import { SITE_URL } from "../../utils/seo";
import { getSeriesGroups } from "../../utils/series";
import { sortByStatus, isPlayable, isFundraising, STATUS_META } from "../../utils/status";
import { pluralize } from "../../utils/pluralize";
import { cover } from "../../lib/cover";
import type { GameStatus } from "../../data/games";

const catalog = sortByStatus(games);
const playable = games.filter(isPlayable).length;
const series = await Promise.all(
  getSeriesGroups().map(async (s) => ({ ...s, count: s.games.reduce((n, g) => n + (g.gamesCount ?? 1), 0), covers: await Promise.all(s.games.slice(0, 3).map((g) => cover(g.cover, 120))) })),
);

const ORDER: GameStatus[] = ["done", "early-access", "in-progress", "fundraising", "planned"];
const kpis = ORDER.map((s) => ({
  value: s,
  label: STATUS_META[s].label,
  color: STATUS_META[s].color,
  n: s === "fundraising" ? games.filter((g) => g.status === s || isFundraising(g)).length : games.filter((g) => g.status === s).length,
})).filter((k) => k.n > 0);
---

<Layout
  title="Усі локалізації — «Little Bit»"
  description={`Каталог українських локалізацій від «Little Bit»: ${games.length} ігор, з яких ${playable} вже можна грати.`}
  canonicalUrl={`${SITE_URL}/games/`}
>
  <div class="page container">
    <header class="head">
      <span class="eyebrow">Каталог · {games.length} {pluralize(games.length, "гра", "гри", "ігор")}</span>
      <h1 class="title">Усі локалізації</h1>
      <p class="lead">
        <b>{playable}</b> з {games.length} уже можна грати українською через
        <a href="/#launcher">LBK Launcher</a>. Решта — у роботі або чекає на збір коштів.
      </p>
    </header>

    <!-- Підсумки за статусами — водночас фільтри -->
    <ul class="kpi" role="group" aria-label="Статуси — натисніть, щоб відфільтрувати">
      <li>
        <button type="button" class="kpi__btn" data-status-filter data-kpi data-value="playable" aria-pressed="false">
          <strong>{playable}</strong>
          <span>Можна грати</span>
        </button>
      </li>
      {kpis.map((k) => (
        <li>
          <button type="button" class="kpi__btn" data-status-filter data-kpi data-value={k.value} aria-pressed="false" style={`--state:${k.color}`}>
            <strong>{k.n}</strong>
            <span><i aria-hidden="true"></i>{k.label}</span>
          </button>
        </li>
      ))}
    </ul>

    <details class="howto">
      <summary>Що означають статуси</summary>
      <dl>
        <div style="--state:var(--st-done)"><dt>Готово</dt><dd>Усі етапи завершено, фінальну версію локалізації опубліковано.</dd></div>
        <div style="--state:var(--st-early)"><dt>Ранній доступ</dt><dd>Уже можна грати. Текст часто перекладено повністю — ще триває редактура або малювання українських написів. Оновлення приходять через лаунчер.</dd></div>
        <div style="--state:var(--st-progress)"><dt>У роботі</dt><dd>Грати поки не можна; поступ кожного етапу видно на картці.</dd></div>
        <div style="--state:var(--st-fund)"><dt>Збір коштів</dt><dd>Гроші йдуть безпосередньо перекладачам, які працюють саме над цією грою. Зібрану й потрібну суму видно на картці.</dd></div>
        <div style="--state:var(--st-planned)"><dt>Заплановано</dt><dd>Проєкт оголошено, робота ще не почалася.</dd></div>
      </dl>
    </details>

    {series.length > 0 && (
      <nav class="series" aria-label="Серії">
        <p class="series__label">Серії</p>
        <ul class="series__list">
          {series.map((s) => (
            <li>
              <a href={`/games/series/${s.slug}/`} class="c-panel serie">
                <span class="serie__fan" aria-hidden="true">
                  {s.covers.map((src) => <img src={src} alt="" width="40" height="60" loading="lazy" decoding="async" />)}
                </span>
                <span class="serie__text">
                  <strong>{s.name}</strong>
                  <small>{s.count} {pluralize(s.count, "гра", "гри", "ігор")}</small>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <FilterBar />

    <div class="grid">
      {catalog.map((game, i) => <CatalogCard game={game} eager={i < 6} />)}
    </div>
  </div>
</Layout>

<style>
  .head { margin: 24px 0 28px; }
  .title { margin-top: 10px; font-size: clamp(2rem, 5vw, 3.75rem); letter-spacing: -0.02em; }
  .lead { max-width: 68ch; margin-top: 14px; color: var(--muted); font-size: 17px; line-height: 1.7; }
  .lead b { color: var(--ink); }
  .lead a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  /* Підсумки-фільтри */
  .kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .kpi li + li { border-left: 1px solid var(--line); }
  .kpi__btn { display: grid; gap: 8px; width: 100%; height: 100%; padding: 22px 18px; text-align: left; transition: background-color 0.18s ease; }
  .kpi li:first-child .kpi__btn { padding-left: 0; }
  .kpi__btn:hover { background: rgba(255, 255, 255, 0.04); }
  .kpi__btn strong { font-size: clamp(1.9rem, 3.4vw, 2.7rem); font-weight: 700; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .kpi__btn span { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 13px; }
  .kpi__btn i { width: 8px; height: 8px; border-radius: 50%; background: var(--state); }
  .kpi__btn[aria-pressed="true"] span { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

  /* Пояснення статусів */
  .howto { margin-top: 16px; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .howto summary { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); font-weight: 600; cursor: pointer; list-style: none; }
  .howto summary::-webkit-details-marker { display: none; }
  .howto summary::after { content: "+"; color: var(--faint); font-weight: 500; }
  .howto[open] summary::after { content: "−"; }
  .howto dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 16px 28px; margin-top: 14px; }
  .howto dt { display: flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 600; }
  .howto dt::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--state); }
  .howto dd { margin-top: 4px; font-size: 13px; }

  /* Серії */
  .series { margin: 32px 0 20px; }
  .series__label { margin-bottom: 12px; color: var(--faint); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .series__list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 10px; }
  .serie { display: flex; align-items: center; gap: 14px; height: 100%; padding: 10px 14px 10px 10px; box-shadow: none; transition: border-color 0.2s ease, transform 0.2s ease; }
  .serie:hover { border-color: rgba(255, 255, 255, 0.4); transform: translateY(-2px); }
  .serie__fan { display: flex; flex-shrink: 0; }
  .serie__fan img { width: 34px; height: 51px; object-fit: cover; border-radius: 5px; box-shadow: 0 0 0 2px rgba(20, 18, 24, 0.95), 0 6px 14px rgba(0, 0, 0, 0.4); }
  .serie__fan img + img { margin-left: -16px; }
  .serie__fan img:nth-child(1) { position: relative; z-index: 3; }
  .serie__fan img:nth-child(2) { position: relative; z-index: 2; transform: rotate(6deg); }
  .serie__fan img:nth-child(3) { position: relative; z-index: 1; transform: rotate(12deg); }
  .serie__text { display: grid; gap: 2px; min-width: 0; }
  .serie__text strong { overflow: hidden; font-size: 14px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .serie__text small { color: var(--faint); font-size: 12px; }

  /* Сітка */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 32px 18px; }

  @media (max-width: 760px) {
    .kpi { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .kpi li + li { border-left: 0; }
    .kpi li:not(:nth-child(3n + 1)) { border-left: 1px solid var(--line); }
    .kpi li:nth-child(-n + 3) { border-bottom: 1px solid var(--line); }
    .kpi__btn, .kpi li:first-child .kpi__btn { padding: 16px 10px; }
    .kpi li:nth-child(3n + 1) .kpi__btn { padding-left: 0; }
    .kpi__btn span { font-size: 12px; }
    .series__list { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 210px; overflow-x: auto; scrollbar-width: none; margin-right: calc(-1 * var(--side)); padding-right: var(--side); }
    .series__list::-webkit-scrollbar { display: none; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  }
</style>
