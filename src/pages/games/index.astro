---
// ─── Catalog Page ──────────────────────────────────────────────
import Layout from "../../layouts/Layout.astro";
import GameCard from "../../components/GameCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import StatusLegend from "../../components/StatusLegend.astro";
import { games } from "../../data/catalog";
import { SITE_URL } from "../../utils/seo";
import { getSeriesGroups } from "../../utils/series";
import { sortByStatus, isPlayable } from "../../utils/status";

const catalog = sortByStatus(games);
const playable = games.filter(isPlayable).length;
const series = getSeriesGroups();
---

<Layout
  title="Усі локалізації — «Little Bit»"
  description={`Каталог українських локалізацій від «Little Bit»: ${games.length} ігор, з яких ${playable} вже можна грати.`}
  canonicalUrl={`${SITE_URL}/games/`}
>
  <div class="page container">
    <header class="section-head">
      <div>
        <span class="eyebrow">Каталог · {games.length}</span>
        <h1 class="title">Усі локалізації</h1>
        <p>{playable} з {games.length} уже можна грати через LBK Launcher.</p>
      </div>
    </header>

    {series.length > 0 && (
      <nav class="series" aria-label="Серії">
        <span>Серії</span>
        {series.map((s) => (
          <a href={`/games/series/${s.slug}/`} class="chip">{s.name}<small>{s.games.length}</small></a>
        ))}
      </nav>
    )}

    <StatusLegend />
    <FilterBar />

    <div class="game-grid">
      {catalog.map((game) => <GameCard game={game} />)}
    </div>
  </div>
</Layout>

<style>
  .title { margin-top: 10px; font-size: clamp(1.8rem, 4vw, 3.25rem); text-transform: uppercase; }
  .series { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 24px; }
  .series > span { margin-right: 6px; color: var(--faint); font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .series small { color: var(--faint); font-size: 10px; }
</style>
