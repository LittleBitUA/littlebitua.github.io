---
// ─── Game Page ─────────────────────────────────────────────────
import Layout from "../../layouts/Layout.astro";
import GameCard from "../../components/GameCard.astro";
import StageList from "../../components/StageList.astro";
import Tag from "../../components/Tag.astro";
import { games } from "../../data/catalog";
import { SITE_URL, generateGameStructuredData, generateBreadcrumbs, generateKeywords } from "../../utils/seo";
import { seriesSlug, hasSeriesPage } from "../../utils/series";
import {
  statusMeta, sortByStatus, isFundraising, fundraisingPercent, translationPercent,
  earlyAccessReason, formatMoney, formatDate, stageName, isPlayable,
} from "../../utils/status";
import { marked } from "marked";

export function getStaticPaths() {
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;

// ── SEO ──
const canonicalUrl = `${SITE_URL}/games/${game.id}/`;
const pageTitle = `Українська локалізація ${game.title} — «Little Bit»`;
const pageDesc = game.description.length > 155 ? game.description.slice(0, 152) + "…" : game.description;
const { "@context": _c1, ...gameSchema } = JSON.parse(generateGameStructuredData(game));
const { "@context": _c2, ...breadcrumbSchema } = JSON.parse(
  generateBreadcrumbs([
    { name: "Головна", url: `${SITE_URL}/` },
    { name: "Локалізації", url: `${SITE_URL}/games/` },
    { name: game.title, url: canonicalUrl },
  ]),
);
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": [gameSchema, breadcrumbSchema] });

// ── Стан ──
const st = statusMeta(game.status);
const pct = translationPercent(game);
const fundActive = isFundraising(game);
const fundPct = fundraisingPercent(game);
const fundUrl = game.fundraisingUrl ?? game.donateUrl;
const ea = earlyAccessReason(game);
const showSeries = hasSeriesPage(game.series);

// ── Контент ──
const installHtml = game.installInstructions ? String(await marked.parse(game.installInstructions)) : null;
const ytId = game.videoUrl?.match(/(?:[?&]v=|youtu\.be\/|embed\/)([A-Za-z0-9_-]{11})/)?.[1];
const videoUrl = ytId ? `https://www.youtube-nocookie.com/embed/${ytId}?rel=0&modestbranding=1` : null;

const facts = [
  { label: "Статус", value: st.label },
  { label: "Версія", value: game.version ? `v${game.version}` : null },
  { label: "Реліз перекладу", value: game.releaseDate && game.status === "done" ? formatDate(game.releaseDate) : null },
  { label: "Оновлено", value: game.lastUpdate ? formatDate(game.lastUpdate) : null },
  { label: "Платформи", value: game.platform?.join(" · ") ?? null },
  { label: "Рік виходу", value: game.gameYear ? String(game.gameYear) : null },
].filter((f) => f.value);

const statsRows = [
  { label: "рядків загалом", value: game.stats?.totalLines },
  { label: "рядків перекладено", value: game.stats?.translatedLines },
  { label: "слів", value: game.stats?.totalWords },
  { label: "символів", value: game.stats?.totalCharacters },
].filter((s) => s.value);

// Розділи нумеруються автоматично — лише ті, що реально показані
const sections = [
  { id: "progress", title: "Стан локалізації", show: true },
  { id: "fund", title: "Збір коштів", show: fundActive },
  { id: "shots", title: "Скріншоти перекладу", show: !!game.screenshots?.length },
  { id: "video", title: "Відео", show: !!videoUrl },
  { id: "install", title: "Як встановити", show: !!installHtml },
  { id: "faq", title: "Часті питання", show: !!game.faq?.length },
].filter((s) => s.show);
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, "0");

// ── Навігація ──
const ordered = sortByStatus(games);
const idx = ordered.findIndex((g) => g.id === game.id);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx < ordered.length - 1 ? ordered[idx + 1] : null;

const related = games
  .filter((g) => g.id !== game.id && ((game.series && g.series === game.series) || g.tags.some((t) => game.tags.includes(t))))
  .sort((a, b) => Number(b.series === game.series) - Number(a.series === game.series))
  .slice(0, 5);
---

<Layout
  title={pageTitle}
  description={pageDesc}
  ogImage={game.cover}
  canonicalUrl={canonicalUrl}
  keywords={generateKeywords(game)}
  structuredData={structuredData}
>
  <div class="backdrop" aria-hidden="true"><img src={game.cover} alt="" /></div>

  <div class="page container game" style={`--state:${st.color}`}>
    <nav aria-label="Навігація">
      <ol class="crumbs">
        <li><a href="/">Головна</a></li>
        <li class="sep" aria-hidden="true">/</li>
        <li><a href="/games/">Каталог</a></li>
        {showSeries && (
          <>
            <li class="sep" aria-hidden="true">/</li>
            <li><a href={`/games/series/${seriesSlug(game.series!)}/`}>{game.series}</a></li>
          </>
        )}
        <li class="sep" aria-hidden="true">/</li>
        <li aria-current="page">{game.title}</li>
      </ol>
    </nav>

    <!-- ── Hero ── -->
    <section class="intro">
      <div class="poster">
        <img src={game.cover} alt={game.title} width="360" height="540" loading="eager" fetchpriority="high" />
        <span class="status poster__status">{st.label}</span>
      </div>

      <div class="intro__copy">
        <p class="intro__kicker">Українська локалізація</p>
        <h1>{game.title}</h1>
        <p class="intro__text">{game.detailedDescription ?? game.description}</p>

        {game.tags.length > 0 && <div class="intro__tags">{game.tags.map((t) => <Tag label={t} />)}</div>}

        <div class="intro__progress">
          <span>{fundActive ? "Зібрано" : "Переклад тексту"}</span>
          <strong class="num">{fundActive ? fundPct : pct}<sup>%</sup></strong>
        </div>
        <div class="bar intro__bar" style={fundActive ? "--state:var(--st-fund)" : pct >= 100 ? "--state:var(--st-done)" : undefined}>
          <i style={`width:${fundActive ? fundPct : pct}%`}></i>
        </div>

        <div class="intro__actions">
          {game.downloadUrl && isPlayable(game) ? (
            <a class="btn btn--primary" href={game.downloadUrl} target="_blank" rel="noopener noreferrer">Встановити через LBK Launcher</a>
          ) : fundActive && fundUrl ? (
            <a class="btn btn--primary" href={fundUrl} target="_blank" rel="noopener noreferrer">Підтримати збір</a>
          ) : null}
          {game.steamUrl && <a class="btn" href={game.steamUrl} target="_blank" rel="noopener noreferrer">Сторінка в Steam</a>}
          {!fundActive && game.donateUrl && <a class="btn" href={game.donateUrl} target="_blank" rel="noopener noreferrer">Підтримати команду</a>}
        </div>
      </div>
    </section>

    {game.abandonedStage && (
      <aside class="ab" aria-labelledby="ab-title">
        <div class="ab__head">
          <span class="ab__badge">Закинуто</span>
          <h2 id="ab-title">
            {stageName(game.abandonedStage)}: роботу припинено
          </h2>
        </div>
        {game.abandonedReason && (
          <div class="ab__reason">
            <p class="ab__label">Причина</p>
            <p>{game.abandonedReason}</p>
          </div>
        )}
      </aside>
    )}

    {ea && (
      <aside class="ea" aria-labelledby="ea-title">
        <div class="ea__head">
          <span class="ea__badge">Ранній доступ</span>
          <h2 id="ea-title">
            {ea.textComplete ? "Текст перекладено повністю — грати можна вже зараз" : "Грати можна вже зараз"}
          </h2>
        </div>
        <p class="ea__text">
          У гру вже можна грати з українською локалізацією, але робота над нею ще триває. Щойно вийде нова
          версія перекладу, її можна буде завантажити через LBK Launcher.
        </p>
        <div class="ea__cols">
          {ea.done.length > 0 && (
            <div class="ea__col is-done">
              <p>Уже готово</p>
              <ul>{ea.done.map((s) => <li>{stageName(s)}</li>)}</ul>
            </div>
          )}
          {ea.pending.length > 0 && (
            <div class="ea__col is-pending">
              <p>Ще триває</p>
              <ul>{ea.pending.map((s) => <li>{stageName(s)}</li>)}</ul>
            </div>
          )}
        </div>
      </aside>
    )}

    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <!-- ── Body ── -->
    <div class="body">
      <div class="body__main">
        <section class="block" id="progress">
          <h2 class="block__title"><span class="num">{num("progress")}</span>Стан локалізації</h2>
          <StageList game={game} />
        </section>

        {fundActive && game.fundraisingGoal && (
          <section class="block fund" id="fund">
            <h2 class="block__title"><span class="num">{num("fund")}</span>Збір коштів</h2>
            <div class="fund__numbers">
              <strong class="num">{formatMoney(game.fundraisingRaised ?? 0)}</strong>
              <span>зібрано з {formatMoney(game.fundraisingGoal)}</span>
              <b class="num">{fundPct}%</b>
            </div>
            <div class="bar" style="--state:var(--st-fund)"><i style={`width:${fundPct}%`}></i></div>
            {game.fundraisingDescription && <p class="fund__text">{game.fundraisingDescription}</p>}
            <p class="fund__note">
              <b>Прозоро:</b> усі кошти з цього збору надсилаються перекладачам, які працюють саме над {game.title}.
            </p>
            {fundUrl && <a class="btn btn--primary" href={fundUrl} target="_blank" rel="noopener noreferrer">Підтримати збір</a>}
          </section>
        )}

        {game.screenshots && game.screenshots.length > 0 && (
          <section class="block" id="shots">
            <h2 class="block__title"><span class="num">{num("shots")}</span>Скріншоти перекладу</h2>
            <div class="shots">
              {game.screenshots.map((src, i) => (
                <a href={src} target="_blank" rel="noopener noreferrer">
                  <img src={src} alt={`Скріншот перекладу ${i + 1}`} loading="lazy" />
                </a>
              ))}
            </div>
          </section>
        )}

        {videoUrl && (
          <section class="block" id="video">
            <h2 class="block__title"><span class="num">{num("video")}</span>Відео</h2>
            <div class="video">
              <iframe
                src={videoUrl}
                title={`Відео: ${game.title}`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </section>
        )}

        {installHtml && (
          <section class="block" id="install">
            <h2 class="block__title"><span class="num">{num("install")}</span>Як встановити</h2>
            <div class="prose" set:html={installHtml} />
          </section>
        )}

        {game.faq && game.faq.length > 0 && (
          <section class="block" id="faq">
            <h2 class="block__title"><span class="num">{num("faq")}</span>Часті питання</h2>
            <div class="qa">
              {game.faq.map((item) => (
                <details>
                  <summary>{item.question}<i aria-hidden="true">+</i></summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="body__side">
        {statsRows.length > 0 && (
          <section>
            <h2 class="side__title">Обсяг роботи</h2>
            <dl class="side__stats">
              {statsRows.map((s) => (
                <div>
                  <dd class="num">{s.value!.toLocaleString("uk-UA")}</dd>
                  <dt>{s.label}</dt>
                </div>
              ))}
            </dl>
          </section>
        )}

        {game.team && game.team.length > 0 && (
          <section>
            <h2 class="side__title">Команда</h2>
            <ul class="side__list">
              {game.team.map((m) => (
                <li>
                  {m.link ? <a href={m.link} target="_blank" rel="noopener noreferrer">{m.name}</a> : <strong>{m.name}</strong>}
                  <span>{m.role}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section>
          <h2 class="side__title">Посилання</h2>
          <ul class="side__list side__links">
            {game.downloadUrl && <li><a href={game.downloadUrl} target="_blank" rel="noopener noreferrer">LBK Launcher</a></li>}
            {game.steamUrl && <li><a href={game.steamUrl} target="_blank" rel="noopener noreferrer">Steam</a></li>}
            {game.donateUrl && <li><a href={game.donateUrl} target="_blank" rel="noopener noreferrer">Підтримати</a></li>}
            {showSeries && <li><a href={`/games/series/${seriesSlug(game.series!)}/`}>Уся серія {game.series}</a></li>}
          </ul>
        </section>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related">
        <header class="section-head">
          <div>
            <span class="eyebrow">Схожі проєкти</span>
            <h2>Ще локалізації</h2>
          </div>
          <a href="/games/" class="link">Увесь каталог</a>
        </header>
        <div class="game-grid">{related.map((g) => <GameCard game={g} />)}</div>
      </section>
    )}

    <nav class="pager" aria-label="Інші ігри">
      {prev ? (
        <a href={`/games/${prev.id}/`} rel="prev"><small>Попередня</small><span>{prev.title}</span></a>
      ) : <span></span>}
      {next && (
        <a href={`/games/${next.id}/`} rel="next" class="pager__next"><small>Наступна</small><span>{next.title}</span></a>
      )}
    </nav>
  </div>
</Layout>

<style>
  /* Розмита обкладинка як атмосфера верхньої частини */
  .backdrop { position: absolute; inset: 0 0 auto; z-index: -1; height: 720px; overflow: hidden; pointer-events: none; }
  .backdrop img { width: 100%; height: 100%; object-fit: cover; filter: blur(48px) saturate(0.6); opacity: 0.18; scale: 1.15; }
  .backdrop::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 9, 11, 0.3), var(--bg) 85%); }

  .game { position: relative; }

  /* ── Intro ── */
  .intro {
    display: grid;
    gap: 32px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .poster { position: relative; width: min(100%, 320px); aspect-ratio: 2 / 3; overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
  .poster img { width: 100%; height: 100%; object-fit: cover; }
  .poster__status { position: absolute; top: 12px; left: 12px; }

  .intro__copy { min-width: 0; }
  .intro__kicker { color: var(--accent); font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .intro h1 {
    margin: 14px 0 20px;
    font-size: clamp(2rem, 4.6vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    overflow-wrap: break-word;
  }
  .intro__text { max-width: 70ch; color: var(--muted); font-size: 1.05rem; line-height: 1.7; }
  .intro__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }

  .intro__progress {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .intro__progress span { color: var(--faint); font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .intro__progress strong { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 800; line-height: 0.9; }
  .intro__progress sup { margin-left: 4px; color: var(--accent); font-size: 0.35em; vertical-align: top; }
  .intro__bar { height: 4px; margin-top: 14px; }

  .intro__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }

  /* ── Abandoned ── */
  .ab {
    margin-top: 40px;
    padding: clamp(20px, 3vw, 32px);
    background:
      linear-gradient(90deg, rgba(224, 104, 95, 0.1), transparent 60%),
      #140c0c;
    border: 1px solid rgba(224, 104, 95, 0.35);
    border-left: 4px solid var(--st-abandoned);
  }
  .ab__head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .ab__badge {
    padding: 6px 10px;
    background: var(--st-abandoned);
    color: var(--on-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ab h2 { font-family: var(--font-body); font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 800; letter-spacing: -0.01em; }
  .ab__reason { margin-top: 18px; padding-left: 14px; border-left: 2px solid rgba(224, 104, 95, 0.5); }
  .ab__label { color: var(--st-abandoned); font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .ab__reason p + p { margin-top: 6px; max-width: 70ch; color: var(--muted); }

  /* ── Early access explainer ── */
  .ea {
    margin-top: 40px;
    padding: clamp(20px, 3vw, 32px);
    background: #0c1119;
    border: 1px solid rgba(92, 169, 255, 0.35);
    border-left: 4px solid var(--st-early);
  }
  .ea__head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .ea__badge {
    padding: 6px 10px;
    background: var(--st-early);
    color: var(--on-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ea h2 { font-family: var(--font-body); font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 800; letter-spacing: -0.01em; }
  .ea__text { max-width: 70ch; margin-top: 14px; color: var(--muted); }
  .ea__cols { display: flex; flex-wrap: wrap; gap: 16px 48px; margin-top: 20px; }
  .ea__col p { margin-bottom: 8px; color: var(--faint); font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .ea__col ul { display: flex; flex-wrap: wrap; gap: 6px; }
  .ea__col li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    font-size: 13px;
    font-weight: 800;
  }
  .ea__col li::before { content: ""; width: 8px; height: 8px; }
  .is-done li { color: var(--st-done); border-color: rgba(86, 211, 145, 0.4); }
  .is-done li::before { background: var(--st-done); }
  .is-pending li { color: var(--accent); border-color: rgba(242, 212, 72, 0.35); }
  .is-pending li::before { border: 2px solid var(--accent); }

  /* ── Facts ── */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .facts div { padding: 16px 16px 16px 0; border-bottom: 1px solid var(--line); min-width: 0; }
  .facts dt { color: var(--faint); font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .facts dd { margin-top: 6px; font-weight: 800; overflow-wrap: anywhere; }

  /* ── Body ── */
  .body { display: grid; gap: 48px; margin-top: 64px; }
  .body__main { min-width: 0; }
  .block { padding-bottom: 48px; margin-bottom: 48px; border-bottom: 1px solid var(--line); }
  .block__title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 28px;
    font-size: clamp(1.2rem, 2vw, 1.75rem);
    text-transform: uppercase;
  }
  .block__title .num { color: var(--accent); font-size: 12px; }

  .fund { padding: 28px; background: var(--surface); border: 1px solid rgba(242, 169, 75, 0.35); }
  .fund__numbers { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: 14px; }
  .fund__numbers strong { color: var(--st-fund); font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 800; }
  .fund__numbers span { color: var(--muted); }
  .fund__numbers b { margin-left: auto; font-size: 1.25rem; }
  .fund__text { max-width: 70ch; margin-top: 20px; color: var(--muted); }
  .fund__note { max-width: 70ch; margin: 16px 0 24px; padding-left: 12px; border-left: 3px solid var(--st-fund); color: var(--muted); font-size: 14px; }
  .fund__note b { color: var(--st-fund); }

  .shots { display: grid; gap: 10px; }
  .shots a { aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--line); }
  .shots img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
  .shots a:hover img { transform: scale(1.02); }

  .video { aspect-ratio: 16 / 9; border: 1px solid var(--line); background: #050607; }
  .video iframe { width: 100%; height: 100%; border: 0; }

  .prose { max-width: 70ch; color: var(--muted); line-height: 1.75; }
  .prose :global(h2), .prose :global(h3) { margin: 28px 0 10px; color: var(--ink); font-family: var(--font-body); font-size: 1.1rem; font-weight: 800; }
  .prose :global(p) { margin-bottom: 14px; }
  .prose :global(a) { color: var(--accent); text-decoration: underline; }
  .prose :global(ol), .prose :global(ul) { margin-bottom: 14px; padding-left: 22px; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(ul) { list-style: disc; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(code) { padding: 2px 6px; background: var(--surface-2); font-size: 0.9em; }

  .qa { border-top: 1px solid var(--line); }
  .qa details { border-bottom: 1px solid var(--line); }
