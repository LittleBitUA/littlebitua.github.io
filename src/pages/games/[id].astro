---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Tag from "../../components/Tag.astro";
import { games, STATUS_LABELS } from "../../data/games";
import { SITE_URL, generateGameStructuredData, generateBreadcrumbs, generateKeywords } from "../../utils/seo";
import { getProgressPalette } from "../../utils/statusColors";
import { seriesSlug, hasSeriesPage } from "../../utils/series";
import { marked } from "marked";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { id: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;

const canonicalUrl = `${SITE_URL}/games/${game.id}/`;
const pageTitle = `Українська локалізація ${game.title} — Little Bit`;
const pageDesc = game.description.length > 155
  ? game.description.slice(0, 152) + "..."
  : game.description;
const keywords = generateKeywords(game);

const { "@context": _c1, ...gameSchema } = JSON.parse(generateGameStructuredData(game));
const { "@context": _c2, ...breadcrumbSchema } = JSON.parse(generateBreadcrumbs([
  { name: "Головна", url: `${SITE_URL}/` },
  { name: "Локалізації", url: `${SITE_URL}/#projects` },
  { name: game.title, url: canonicalUrl },
]));
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [gameSchema, breadcrumbSchema],
});

const filledCubes = Math.floor(game.progress / 5);
const cubePalette = getProgressPalette(game.status, game.progress);

const topPillColor =
  game.status === "done" ? "text-emerald-300 bg-emerald-950/60 border-emerald-700/40" :
  game.status === "early-access" ? "text-sky-300 bg-sky-950/60 border-sky-700/40" :
  game.status === "in-progress" ? "text-violet-300 bg-violet-950/60 border-violet-700/40" :
  game.status === "fundraising" ? "text-amber-300 bg-amber-950/60 border-amber-700/40" :
  "text-slate-300 bg-slate-900/60 border-slate-600/40";

const fundraisingActive = !!game.fundraisingGoal && !game.fundraisingCompleted;
const fundraisingPercent = game.fundraisingGoal
  ? Math.min(Math.round(((game.fundraisingRaised ?? 0) / game.fundraisingGoal) * 100), 100)
  : 0;

function formatDate(d: string) {
  return new Date(d).toLocaleDateString("uk-UA", { day: "numeric", month: "long", year: "numeric" });
}

// Prev / Next navigation (same sort order as main page)
const STATUS_PRIORITY: Record<string, number> = { done: 0, "early-access": 1, "in-progress": 2, fundraising: 3 };
const sortedForNav = [...games].sort((a, b) => {
  const pa = STATUS_PRIORITY[a.status] ?? 9;
  const pb = STATUS_PRIORITY[b.status] ?? 9;
  if (pa !== pb) return pa - pb;
  return (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? "");
});
const navIdx = sortedForNav.findIndex(g => g.id === game.id);
const prevGame = navIdx > 0 ? sortedForNav[navIdx - 1] : null;
const nextGame = navIdx < sortedForNav.length - 1 ? sortedForNav[navIdx + 1] : null;

// YouTube → privacy-enhanced embed URL
function ytEmbed(url: string): string | null {
  const m = url.match(/(?:[?&]v=|youtu\.be\/|embed\/)([A-Za-z0-9_-]{11})/);
  return m ? `https://www.youtube-nocookie.com/embed/${m[1]}?rel=0&modestbranding=1` : null;
}
const videoEmbedUrl = game.videoUrl ? ytEmbed(game.videoUrl) : null;

// Render install instructions markdown → HTML
const installHtml = game.installInstructions
  ? String(await marked.parse(game.installInstructions))
  : null;

// Sidebar donate CTA: show for games without downloadUrl and without active fundraise
const showDonateOnly = !game.downloadUrl && !fundraisingActive && !!game.donateUrl;

// ── Progress block: показуємо кожне число рівно один раз ──
// Раніше гра з однією стадією («Переклад 60%») малювала 60% тричі:
// заголовний бар, куби «загальної готовності» й рядок розбивки.
const stages = game.stageDetails ?? [];
const xlatStage = stages.find((d) => /переклад/i.test(d.label)) ?? stages[0];
const xlatPercent = xlatStage?.percent ?? game.progress;
// Решта стадій — редактура, текстури, шрифти тощо
const otherStages = stages.filter((d) => d !== xlatStage);
// Куби загальної готовності мають сенс лише коли вона відрізняється від перекладу
const showOverall = game.progress !== xlatPercent;
---

<Layout
  title={pageTitle}
  description={pageDesc}
  ogImage={game.cover}
  canonicalUrl={canonicalUrl}
  keywords={keywords}
  structuredData={structuredData}
>
  <Header />

  <main class="flex-1 pt-28 pb-20 relative">

    <!-- ── Покращення 3: Blurred cover background ──────────────────
         Обкладинка гри розмивається і стає ледь помітним фоном вгорі.
         Щоб вимкнути: видали цей <div> блок. -->
    <div
      class="pointer-events-none select-none absolute inset-x-0 top-0 h-[65vh] overflow-hidden"
      aria-hidden="true"
      style="z-index: 0;
             -webkit-mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);
             mask-image: linear-gradient(to bottom, black 0%, black 35%, transparent 100%);"
    >
      <img
        src={game.cover}
        alt=""
        class="w-full h-full object-cover object-top"
        style="filter: blur(72px) saturate(0.5); opacity: 0.13; transform: scale(1.25);"
        loading="eager"
        decoding="async"
      />
      <!-- Затемнення НЕ доходить до непрозорого — інакше шар обривався
           різкою горизонтальною межею там, де закінчувались його 65vh.
           Плавне згасання тепер робить mask-image на контейнері. -->
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(7,11,20,0.45) 0%, rgba(7,11,20,0.8) 70%, rgba(7,11,20,0.8) 100%);"></div>
    </div>
    <!-- ── кінець Покращення 3 ──────────────────────────────────── -->

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8" style="z-index: 1;">

      <!-- Breadcrumbs -->
      <nav class="mb-8" aria-label="Навігація">
        <ol class="flex items-center gap-1.5 text-xs text-slate-500 flex-wrap">
          <li><a href="/" class="hover:text-indigo-400 transition-colors">Головна</a></li>
          <li aria-hidden="true">
            <svg class="w-3 h-3 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li><a href="/#projects" class="hover:text-indigo-400 transition-colors">Локалізації</a></li>
          <li aria-hidden="true">
            <svg class="w-3 h-3 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          {hasSeriesPage(game.series) && (
            <>
              <li>
                <a href={`/games/series/${seriesSlug(game.series!)}/`} class="hover:text-indigo-400 transition-colors">
                  {game.series}
                </a>
              </li>
              <li aria-hidden="true">
                <svg class="w-3 h-3 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </li>
            </>
          )}
          <li class="text-slate-300 font-semibold truncate max-w-[220px]">{game.title}</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-8 items-start">

        <!-- Cover column -->
        <div class="shrink-0" data-animate>
          <div class="relative aspect-[2/3] rounded-2xl overflow-hidden lb-glass mb-4">
            <img
              src={game.cover}
              alt={`Обкладинка ${game.title}`}
              class="absolute inset-0 w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
            <div class="absolute top-2.5 left-2.5 z-10">
              <span class={`inline-flex items-center gap-1 px-2.5 py-1 text-[10px] font-bold rounded-full border ${topPillColor}`}>
                {game.status === "done" && (
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                )}
                {(game.status === "early-access" || game.status === "in-progress") && (
                  <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                )}
                {game.status === "fundraising" && <span class="text-xs font-bold leading-none">₴</span>}
                {STATUS_LABELS[game.status]}
              </span>
            </div>
            <div class="absolute top-2.5 right-2.5 z-10">
              <span
                class="px-2.5 py-1 text-xs font-extrabold tabular-nums text-white rounded-lg"
                style="background: rgba(15,23,42,0.78); box-shadow: 0 0 0 1px rgba(255,255,255,0.18) inset;"
              >
                {game.progress}<span class="text-[10px] font-medium opacity-70">%</span>
              </span>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            {game.downloadUrl && (
              <a
                href={game.downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="lb-btn !py-2.5 !text-sm"
                style="color:#4ade80; background: rgba(34,197,94,0.18); border: 1px solid rgba(34,197,94,0.45);"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                Завантажити локалізацію
              </a>
            )}
            {game.steamUrl && (
              <a
                href={game.steamUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="lb-btn lb-btn--ghost !py-2.5 !text-sm"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.455 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/>
                </svg>
                Відкрити в Steam
              </a>
            )}
            {fundraisingActive && game.donateUrl && (
              <a
                href={game.donateUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="lb-btn !py-2.5 !text-sm"
                style="color:#fbbf24; background: rgba(245,158,11,0.18); border: 1px solid rgba(245,158,11,0.45);"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                Підтримати збір
              </a>
            )}
            {showDonateOnly && (
              <a
                href={game.donateUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="lb-btn !py-2.5 !text-sm"
                style="color:#a78bfa; background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.35);"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                Підтримати переклад
              </a>
            )}
            <a href="/#projects" class="lb-btn lb-btn--ghost !py-2 !text-xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              Усі локалізації
            </a>
          </div>
        </div>

        <!-- Info column -->
        <div data-animate>
          <!-- Префікс лишається в h1 для SEO, але візуально підпорядкований -->
          <h1 class="mb-3">
            <span class="block text-[0.7rem] font-bold uppercase tracking-[0.12em] text-indigo-400 mb-1.5">
              Українська локалізація
            </span>
            <span class="block text-2xl sm:text-3xl font-black text-slate-100 leading-tight">
              {game.title}
            </span>
          </h1>

          <div class="flex flex-wrap gap-1.5 mb-3">
            {game.tags.map((tag) => <Tag label={tag} />)}
          </div>

          <!-- Metadata row: year, platform, version, release date -->
          {(game.gameYear || game.platform?.length || game.version || (game.releaseDate && game.status === "done")) && (
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-5">
              {game.gameYear && (
                <span class="text-[11px] text-slate-500 font-medium">{game.gameYear} р.</span>
              )}
              {game.platform && game.platform.length > 0 && (
                <span class="text-[11px] text-slate-500 font-medium">{game.platform.join(" · ")}</span>
              )}
              {game.version && (
                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-indigo-400 bg-indigo-950/50 border border-indigo-700/30 px-2 py-0.5 rounded-full">
                  v{game.version}
                </span>
              )}
              {game.releaseDate && game.status === "done" && (
                <span class="text-[11px] text-emerald-500 font-medium">Реліз: {formatDate(game.releaseDate)}</span>
              )}
            </div>
          )}

          <!-- Progress -->
          <div class="lb-glass p-4 rounded-2xl mb-4">
            <!-- Головна метрика — прогрес перекладу -->
            <div class="flex items-baseline justify-between mb-2">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Прогрес перекладу</span>
              <span class="text-2xl font-black tabular-nums text-indigo-300 leading-none">{xlatPercent}<span class="text-sm font-bold opacity-60">%</span></span>
            </div>
            <div class="h-2.5 rounded-full bg-white/10 overflow-hidden">
              <div
                class="h-full rounded-full transition-all duration-500"
                style={`width: ${xlatPercent}%; background: linear-gradient(90deg,#818cf8,#6366f1);`}
              ></div>
            </div>

            {/* Загальна готовність — лише коли відрізняється від перекладу */}
            {showOverall && (
              <>
                <div class="flex items-center justify-between mb-1.5 mt-4 pt-3 border-t border-white/8">
                  <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Загальна готовність</span>
                  <span class="text-xs font-extrabold tabular-nums text-slate-400">{game.progress}%</span>
                </div>
                <div class="flex items-center gap-[2px]">
                  {Array.from({ length: 20 }).map((_, i) => {
                    const isFull = i < filledCubes;
                    const isNext = i === filledCubes && game.progress < 100;
                    return (
                      <div class="flex-1 h-2 rounded-sm bg-white/10 overflow-hidden relative">
                        {isFull && <div class="absolute inset-0" style={`background: ${cubePalette.solid};`}></div>}
                        {isNext && <div class="lb-cube-next absolute inset-0" style={`background: ${cubePalette.solid};`}></div>}
                      </div>
                    );
                  })}
                </div>
              </>
            )}

            {/* Інші стадії — переклад уже показано вище, тому його тут немає */}
            {otherStages.length > 0 && (
              <div class="space-y-1.5 mt-4 pt-3 border-t border-white/8">
                {otherStages.map((detail) => (
                  <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-between gap-1.5 flex-shrink-0 w-[110px] px-2 py-0.5 rounded-full bg-slate-800/60 border border-white/10 text-slate-400">
                      <span class="text-[10px] font-semibold truncate">{detail.label}</span>
                      <span class="text-[10px] font-bold tabular-nums">{detail.percent}%</span>
                    </span>
                    <div class="flex-1 h-1.5 rounded-full bg-white/10 overflow-hidden">
                      <div
                        class="h-full rounded-full transition-all duration-500"
                        style={`width: ${detail.percent}%; background: ${detail.percent >= 100 ? "linear-gradient(90deg,#14b8a6,#0d9488)" : detail.percent > 0 ? "linear-gradient(90deg,#5eead4,#14b8a6)" : "transparent"};`}
                      ></div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Description -->
          <div class="lb-glass p-4 rounded-2xl mb-4">
            <p class="text-sm text-slate-300 leading-relaxed">{game.detailedDescription ?? game.description}</p>
          </div>

          <!-- Fundraising -->
          {fundraisingActive && game.fundraisingGoal && (
            <div class="lb-glass p-4 rounded-2xl mb-4" style="border: 1px solid rgba(245,158,11,0.25);">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Збір коштів</span>
                <span class="text-xs font-semibold text-amber-300 tabular-nums">
                  {(game.fundraisingRaised ?? 0).toLocaleString("uk-UA")} / {game.fundraisingGoal.toLocaleString("uk-UA")} ₴ ({fundraisingPercent}%)
                </span>
              </div>
              <div class="h-2 rounded-full bg-white/10 overflow-hidden mb-3">
                <div
                  class="h-full rounded-full"
                  style={`width: ${fundraisingPercent}%; background: linear-gradient(90deg,#f59e0b,#fbbf24);`}
                ></div>
              </div>
              {game.fundraisingDescription && (
                <p class="text-xs text-slate-400 leading-relaxed">{game.fundraisingDescription}</p>
              )}
            </div>
          )}

          <!-- Stats -->
          {game.stats && (game.stats.totalLines || game.stats.translatedLines) && (
            <div class="lb-glass p-4 rounded-2xl mb-4">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-3">Обсяг перекладу</span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                {game.stats.totalLines && (
                  <div>
                    <div class="text-xl font-extrabold tabular-nums text-slate-100">
                      {game.stats.totalLines.toLocaleString("uk-UA")}
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">рядків загалом</div>
                  </div>
                )}
                {game.stats.translatedLines && (
                  <div>
                    <div class="text-xl font-extrabold tabular-nums text-teal-300">
                      {game.stats.translatedLines.toLocaleString("uk-UA")}
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">перекладено</div>
                  </div>
                )}
                {game.stats.totalWords && (
                  <div>
                    <div class="text-xl font-extrabold tabular-nums text-slate-100">
                      {Math.round(game.stats.totalWords / 1000)}k
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">слів</div>
                  </div>
                )}
                {game.stats.totalCharacters && (
                  <div>
                    <div class="text-xl font-extrabold tabular-nums text-slate-100">
                      {Math.round(game.stats.totalCharacters / 1000)}k
                    </div>
                    <div class="text-xs text-slate-500 mt-0.5">символів</div>
                  </div>
                )}
              </div>
            </div>
          )}

        </div>
      </div>

      <!-- ── Extended sections (full-width below the two-column grid) ── -->

      {/* Screenshots */}
      {game.screenshots && game.screenshots.length > 0 && (
        <section class="mt-10" data-animate>
          <h2 class="lb-section-label">Скріншоти перекладу</h2>
          <div class="flex gap-2.5 overflow-x-auto pb-2 -mx-1 px-1 snap-x snap-mandatory">
            {game.screenshots.map((src, i) => (
              <a
                href={src}
                target="_blank"
                rel="noopener"
                class="shrink-0 rounded-xl overflow-hidden lb-lift block snap-start"
                style="width: 260px;"
              >
                <img
                  src={src}
                  alt={`Скріншот перекладу ${i + 1}`}
                  class="object-cover w-full"
                  style="height: 160px;"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Video */}
      {videoEmbedUrl && (
        <section class="mt-10" data-animate>
          <h2 class="lb-section-label">Відео</h2>
          <div class="aspect-video rounded-2xl overflow-hidden lb-glass">
            <iframe
              src={videoEmbedUrl}
              title={`Відео: ${game.title}`}
              class="w-full h-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </section>
      )}

      {/* Installation instructions */}
      {installHtml && (
        <section class="mt-10" data-animate>
          <h2 class="lb-section-label">Як встановити</h2>
          <div class="lb-glass p-5 sm:p-6 rounded-2xl lb-markdown">
            <Fragment set:html={installHtml} />
          </div>
        </section>
      )}

      {/* Team */}

      {/* Per-game FAQ */}
      {game.faq && game.faq.length > 0 && (
        <section class="mt-10" data-animate>
          <h2 class="lb-section-label">Часті питання</h2>
          <div class="space-y-2">
            {game.faq.map(item => (
              <details class="lb-glass rounded-xl group">
                <summary class="flex items-center justify-between gap-3 px-4 py-3.5 cursor-pointer list-none select-none text-slate-100 font-semibold text-sm">
                  {item.question}
                  <svg class="w-4 h-4 shrink-0 text-slate-500 transition-transform duration-200 group-open:rotate-180"
                       fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <p class="px-4 pb-4 text-sm text-slate-400 leading-relaxed border-t border-white/6 pt-3">{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <!-- Prev / Next navigation -->
      <nav class="mt-12 pt-8 border-t border-white/8 flex items-stretch justify-between gap-3" aria-label="Між іграми">
        {prevGame ? (
          <a href={`/games/${prevGame.id}/`}
             class="lb-glass flex items-center gap-2.5 px-4 py-3 rounded-xl text-sm font-semibold text-slate-400 hover:text-white transition-colors lb-lift max-w-[48%]">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            <span class="truncate">{prevGame.title}</span>
          </a>
        ) : <div />}
        {nextGame ? (
          <a href={`/games/${nextGame.id}/`}
             class="lb-glass flex items-center gap-2.5 px-4 py-3 rounded-xl text-sm font-semibold text-slate-400 hover:text-white transition-colors lb-lift max-w-[48%] ml-auto text-right">
            <span class="truncate">{nextGame.title}</span>
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ) : <div />}
      </nav>

    </div>
  </main>

  <Footer />
</Layout>

