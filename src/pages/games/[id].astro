---
// ─── Game Page ─────────────────────────────────────────────────
// Великий банер гри, логотип замість заголовка, скляна панель із фактами
// праворуч; нижче — стан локалізації, скріншоти рядом карток, схожі ігри.
import Layout from "../../layouts/Layout.astro";
import Row from "../../components/cinema/Row.astro";
import ProgressChart from "../../components/ProgressChart.astro";
import { games } from "../../data/catalog";
import { SITE_URL, generateGameStructuredData, generateBreadcrumbs, generateKeywords } from "../../utils/seo";
import { seriesSlug, hasSeriesPage } from "../../utils/series";
import {
  statusMeta, sortByStatus, isFundraising, fundraisingPercent, translationPercent, formatPct,
  earlyAccessReason, formatMoney, formatDate, stageName, isPlayable, stagesOf, isStageAbandoned,
} from "../../utils/status";
import { marked } from "marked";
import { chronologyEntry, latestReport } from "../../lib/chronology";
import { cover } from "../../lib/cover";
import { artOf } from "../../lib/art";
import { liveNumbers, liveLabel } from "../../lib/live";
import { peopleOf } from "../../data/people";
import { leadOf, paragraphs, hasMore } from "../../lib/description";
import PersonAvatar from "../../components/PersonAvatar.astro";

export function getStaticPaths() {
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

const { game } = Astro.props;

// ── SEO ──
const canonicalUrl = `${SITE_URL}/games/${game.id}/`;
const pageTitle = `Українська локалізація ${game.title} — «Little Bit»`;
const lead = leadOf(game);
const pageDesc = lead.length > 155 ? lead.slice(0, 152) + "…" : lead;
const { "@context": _c1, ...gameSchema } = JSON.parse(generateGameStructuredData(game));
const { "@context": _c2, ...breadcrumbSchema } = JSON.parse(
  generateBreadcrumbs([
    { name: "Головна", url: `${SITE_URL}/` },
    { name: "Локалізації", url: `${SITE_URL}/games/` },
    { name: game.title, url: canonicalUrl },
  ]),
);
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": [gameSchema, breadcrumbSchema] });

// ── Стан ──
const st = statusMeta(game.status);
const pct = translationPercent(game);
const fundActive = isFundraising(game);
const fundPct = fundraisingPercent(game);
const fundUrl = game.fundraisingUrl ?? game.donateUrl;
const ea = earlyAccessReason(game);
const showSeries = hasSeriesPage(game.series);
const chron = chronologyEntry(game.id);
// Свіжі цифри з LBK Launcher — звіт міг застаріти
const live = chron ? liveNumbers(game, chron.html) : null;
const crew = peopleOf(game.id);
const art = await artOf(game);
const poster = await cover(game.cover, 720);
const stages = stagesOf(game);
const editing = stages.find((s) => /редакт/i.test(s.label));

// ── Контент ──
const installHtml = game.installInstructions ? String(await marked.parse(game.installInstructions)) : null;
const ytId = game.videoUrl?.match(/(?:[?&]v=|youtu\.be\/|embed\/)([A-Za-z0-9_-]{11})/)?.[1];
const videoUrl = ytId ? `https://www.youtube-nocookie.com/embed/${ytId}?rel=0&modestbranding=1` : null;
// Локальні скріншоти (/images/…) вже стиснуті — віддаємо як є
const shots = await Promise.all((game.screenshots ?? []).map((src) => (src.startsWith("/") ? src : cover(src, 640))));

const meta = [
  pct >= 100 ? "Текст перекладено" : `Перекладено ${formatPct(pct)}%`,
  editing && editing.percent > 0 ? `${stageName(editing.label)} ${formatPct(editing.percent)}%` : null,
  game.gameYear ? String(game.gameYear) : null,
  game.version ? `v${game.version}` : null,
].filter(Boolean) as string[];

// Панель фактів праворуч (як TYPE / RELEASED / GENRES)
const facts = [
  { label: "Статус", value: st.label },
  { label: "Переклад", value: `${formatPct(pct)}%` },
  { label: "Етапи", value: stages.map((s) => `${stageName(s.label)} ${formatPct(s.percent)}%`).join(", ") },
  { label: "Реліз", value: game.releaseDate ? formatDate(game.releaseDate) : null },
  { label: "Оновлено", value: game.lastUpdate ? formatDate(game.lastUpdate) : null },
  { label: "Версія", value: game.version ? `v${game.version}` : null },
  { label: "Рік гри", value: game.gameYear ? String(game.gameYear) : null },
  { label: "Жанри", value: game.tags.slice(0, 4).join(", ") || null },
].filter((f) => f.value);

const statsRows = [
  { label: "рядків загалом", value: game.stats?.totalLines },
  { label: "рядків перекладено", value: game.stats?.translatedLines },
  { label: "слів", value: game.stats?.totalWords },
  { label: "символів", value: game.stats?.totalCharacters },
].filter((s) => s.value);

const primary =
  game.downloadUrl && isPlayable(game)
    ? { label: "Грати", sub: "через LBK Launcher", href: game.downloadUrl, fund: false }
    : fundActive && fundUrl
      ? { label: "Підтримати збір", sub: null, href: fundUrl, fund: true }
      : null;

// ── Навігація ──
const ordered = sortByStatus(games);
const idx = ordered.findIndex((g) => g.id === game.id);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx < ordered.length - 1 ? ordered[idx + 1] : null;

const related = games
  .filter((g) => g.id !== game.id && ((game.series && g.series === game.series) || g.tags.some((t) => game.tags.includes(t))))
  .sort((a, b) => Number(b.series === game.series) - Number(a.series === game.series))
  .slice(0, 14);
---

<Layout
  title={pageTitle}
  description={pageDesc}
  ogImage={art.banner ? SITE_URL + art.banner : game.cover}
  canonicalUrl={canonicalUrl}
  keywords={generateKeywords(game)}
  structuredData={structuredData}
  tint={art.tint}
>
  <!-- ── Hero ── -->
  <section class="gh" style={`--state:${st.color}`}>
    <picture class="gh__bg" aria-hidden="true">
      <img src={art.bannerLow ?? poster} data-hi={art.bannerSrcset ?? undefined} sizes="(max-width: 760px) 100vw, max(100vw, 260vh)" alt="" fetchpriority="high" decoding="async" />
    </picture>

    <div class="gh__inner">
      <div class="gh__copy">
        <a class="gh__back" href="/games/">← Каталог{showSeries && <span> · {game.series}</span>}</a>
        {art.logo ? (
          <>
            <img class="c-logo gh__logo" src={art.logo} srcset={art.logoSrcset ?? undefined} sizes="(max-width: 760px) 80vw, 560px" alt="" fetchpriority="high" decoding="async" />
            <h1 class="sr-only">Українська локалізація {game.title}</h1>
          </>
        ) : (
          <h1 class="c-title gh__title"><span class="sr-only">Українська локалізація </span>{game.title}</h1>
        )}

        <p class="c-meta gh__meta">
          <span class="c-badge">{st.label}</span>
          {meta.map((m) => <span>{m}</span>)}
        </p>
        <p class="gh__text">{lead}</p>

        <div class="gh__actions">
          {primary && (
            <a class:list={["c-btn", { "c-btn--fund": primary.fund }]} href={primary.href} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" /></svg>
              {primary.label}
            </a>
          )}
          {(game.steamUrl || game.donateUrl) && (
            <span class="c-group">
              {game.steamUrl && (
                <a href={game.steamUrl} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5H5V6h5" /></svg>
                  Steam
                </a>
              )}
              {!fundActive && game.donateUrl && (
                <a href={game.donateUrl} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg>
                  Підтримати команду
                </a>
              )}
            </span>
          )}
        </div>
        {primary?.sub && <p class="gh__sub">{primary.sub}</p>}

        <div class="gh__progress" aria-label={`Переклад ${formatPct(pct)}%`}>
          <span class="gh__bar"><i style={`width:${fundActive ? fundPct : pct}%`}></i></span>
          <span>{fundActive ? `Зібрано ${fundPct}%` : `${formatPct(pct)}%`}</span>
        </div>
      </div>

      <dl class="c-panel gh__facts">
        {facts.map((f) => (
          <div>
            <dt class="c-label">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
        {showSeries && (
          <div>
            <dt class="c-label">Серія</dt>
            <dd><a href={`/games/series/${seriesSlug(game.series!)}/`}>{game.series} →</a></dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  <div class="gbody c-wrap">
    {game.abandonedStage && (
      <aside class="c-panel note note--abandoned">
        <span class="c-badge" style="--state:var(--st-abandoned)">Закинуто</span>
        <h2>{stageName(game.abandonedStage)}: роботу припинено</h2>
        {game.abandonedReason && <p>{game.abandonedReason}</p>}
      </aside>
    )}

    {ea && (
      <aside class="c-panel note" style="--state:var(--st-early)">
        <span class="c-badge">Ранній доступ</span>
        <h2>{ea.textComplete ? "Текст перекладено повністю — грати можна вже зараз" : "Грати можна вже зараз"}</h2>
        <p>
          У гру вже можна грати з українською локалізацією, але робота над нею ще триває. Щойно вийде нова
          версія перекладу, її можна буде завантажити через LBK Launcher.
        </p>
        <div class="note__cols">
          {ea.done.length > 0 && <p><span class="c-label">Уже готово</span> {ea.done.map(stageName).join(", ")}</p>}
          {ea.pending.length > 0 && <p><span class="c-label">Ще триває</span> {ea.pending.map(stageName).join(", ")}</p>}
        </div>
      </aside>
    )}

    <!-- ── Про гру: повний опис із LBK Launcher ── -->
    {hasMore(game) && (
      <section class="gsec about">
        <h2 class="gsec__title">Про гру</h2>
        {paragraphs(game.description).map((p) => <p class:list={{ about__h: p.length < 60 && !/[.!?…»]$/.test(p) }}>{p}</p>)}
      </section>
    )}

    <!-- ── Стан локалізації ── -->
    <section class="gsec">
      <h2 class="gsec__title">Стан локалізації</h2>
      <ul class="stages">
        {stages.map((s) => {
          const abandoned = s.percent < 100 && isStageAbandoned(game, s.label);
          const state = abandoned ? "abandoned" : s.percent >= 100 ? "done" : s.percent > 0 ? "active" : "todo";
          return (
            <li class={`c-panel stage is-${state}`}>
              <span class="c-label">{stageName(s.label)}</span>
              <strong>{state === "todo" ? "—" : `${formatPct(s.percent)}%`}</strong>
              <span class="stage__bar"><i style={`width:${s.percent}%`}></i></span>
              <small>{abandoned ? "закинуто" : state === "done" ? "завершено" : state === "active" ? "у роботі" : "не розпочато"}</small>
            </li>
          );
        })}
      </ul>

      <ProgressChart game={game} />

      {statsRows.length > 0 && (
        <dl class="stats">
          {statsRows.map((s) => (
            <div>
              <dd>{s.value!.toLocaleString("uk-UA")}</dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
      )}
    </section>

    {fundActive && game.fundraisingGoal && (
      <section class="gsec">
        <h2 class="gsec__title">Збір коштів</h2>
        <div class="c-panel fund">
          <div class="fund__numbers">
            <strong>{formatMoney(game.fundraisingRaised ?? 0)}</strong>
            <span>зібрано з {formatMoney(game.fundraisingGoal)}</span>
            <b>{fundPct}%</b>
          </div>
          <span class="stage__bar fund__bar"><i style={`width:${fundPct}%`}></i></span>
          {game.fundraisingDescription && <p>{game.fundraisingDescription}</p>}
          <p class="fund__note">Усі кошти з цього збору надсилаються перекладачам, які працюють саме над {game.title}.</p>
          {fundUrl && <a class="c-btn c-btn--fund" href={fundUrl} target="_blank" rel="noopener noreferrer">Підтримати збір</a>}
        </div>
      </section>
    )}

    {crew.length > 0 && (
      <section class="gsec">
        <h2 class="gsec__title">Над локалізацією працюють</h2>
        <ul class="crew">
          {crew.map(({ person, role }) => (
            <li>
              <a href={`/team/${person.slug}/`} class="c-panel crew__item">
                <PersonAvatar name={person.name} slug={person.slug} size={40} />
                <span><strong>{person.name}</strong><small>{role}{person.from && ` · команда ${person.from}`}</small></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {chron && latestReport && (
      <section class="gsec">
        <h2 class="gsec__title">Стан проєкту</h2>
        <div class="c-panel chron">
          <p class="chron__meta">
            <span class="c-label">Зі звіту станом на {latestReport.dateLabel}</span>
            {chron.date && <span class="c-label">Вихід: {chron.date}</span>}
          </p>
          <div class="chron__text" set:html={chron.html} />
          {live?.differs && (
            <p class="chron__live">
              <span class="chron__now">Зараз</span>
              {liveLabel(live)}
              <small>за даними LBK Launcher; звіт написано раніше, тож цифри в ньому могли застаріти</small>
            </p>
          )}
          <a class="chron__link" href={`/chronology/#${chron.id}`}>Уся хронологія перекладів →</a>
        </div>
      </section>
    )}
  </div>

  {shots.length > 0 && (
    <section class="c-row">
      <header class="c-row__head"><h2>Скріншоти перекладу</h2></header>
      <div class="c-track c-track--wide">
        {shots.map((src, i) => (
          <a class="shot" href={game.screenshots![i]} data-shot={i}>
            <img src={src} alt={`Скріншот перекладу ${i + 1}`} loading="lazy" decoding="async" />
            <span class="c-label">Скріншот {i + 1}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Перегляд скріншотів на весь екран, без переходу на іншу вкладку -->
    <dialog class="lightbox" id="lightbox" aria-label="Перегляд скріншотів">
      <img class="lightbox__img" alt="" />
      <p class="lightbox__count c-label" aria-live="polite"></p>
      <button class="lightbox__btn lightbox__close" type="button" aria-label="Закрити">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
      {shots.length > 1 && (
        <>
          <button class="lightbox__btn lightbox__prev" type="button" aria-label="Попередній скріншот">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
          </button>
          <button class="lightbox__btn lightbox__next" type="button" aria-label="Наступний скріншот">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
          </button>
        </>
      )}
    </dialog>
  )}

  <div class="gbody c-wrap">
    {videoUrl && (
      <section class="gsec">
        <h2 class="gsec__title">Відео</h2>
        <div class="video">
          <iframe
            src={videoUrl}
            title={`Відео: ${game.title}`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </section>
    )}

    {installHtml && (
      <section class="gsec">
        <h2 class="gsec__title">Як встановити</h2>
        <div class="c-panel prose" set:html={installHtml} />
      </section>
    )}

    {game.faq && game.faq.length > 0 && (
      <section class="gsec">
        <h2 class="gsec__title">Часті питання</h2>
        <div class="qa">
          {game.faq.map((item) => (
            <details class="c-panel">
              <summary>{item.question}<i aria-hidden="true">+</i></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </div>

  <Row title="Схожі проєкти" games={related} href="/games/" hrefLabel="Увесь каталог" />

  <nav class="pager c-wrap" aria-label="Інші ігри">
    {prev ? (
      <a href={`/games/${prev.id}/`} rel="prev" class="c-panel"><small class="c-label">← Попередня</small><span>{prev.title}</span></a>
    ) : <span></span>}
    {next && (
      <a href={`/games/${next.id}/`} rel="next" class="c-panel pager__next"><small class="c-label">Наступна →</small><span>{next.title}</span></a>
    )}
  </nav>
</Layout>

<script>
  import { upgradeAll } from "../../scripts/hires";
  upgradeAll();
  const box = document.getElementById("lightbox") as HTMLDialogElement | null;
  const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-shot]")];
  if (box && links.length) {
    const img = box.querySelector<HTMLImageElement>(".lightbox__img")!;
    const count = box.querySelector<HTMLElement>(".lightbox__count")!;
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      img.src = links[index].href;
      img.alt = links[index].querySelector("img")?.alt ?? "";
      count.textContent = `${index + 1} / ${links.length}`;
    };

    links.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        e.preventDefault();
        show(i);
        box.showModal();
      }),
    );
    box.querySelector(".lightbox__close")?.addEventListener("click", () => box.close());
    box.querySelector(".lightbox__prev")?.addEventListener("click", () => show(index - 1));
    box.querySelector(".lightbox__next")?.addEventListener("click", () => show(index + 1));
    // Клік по темному тлу (не по картинці й кнопках) закриває перегляд
    box.addEventListener("click", (e) => { if (e.target === box) box.close(); });
    box.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show(index + 1);
      if (e.key === "ArrowLeft") show(index - 1);
    });

    let startX = 0;
    box.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    box.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  /* ── Hero ── */
  .gh { position: relative; isolation: isolate; min-height: min(86vh, 820px); display: flex; align-items: flex-end; }
  .gh__bg { position: absolute; inset: 0; z-index: -1; }
  .gh__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 20%;
    -webkit-mask-image: linear-gradient(180deg, #000 50%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 50%, transparent 100%);
  }
  .gh::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, color-mix(in srgb, var(--tint) 65%, rgba(0, 0, 0, 0.6)) 0%, transparent 65%);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
  }

  .gh__inner {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: end;
    padding: 110px var(--side) 48px;
  }
  .gh__copy { min-width: 0; max-width: 720px; }
  .gh__back { display: inline-block; margin-bottom: 22px; color: rgba(255, 255, 255, 0.75); font-size: 13px; font-weight: 600; }
  .gh__back:hover { color: #fff; }
  .gh__logo { max-height: clamp(120px, 22vh, 230px); margin-bottom: 22px; }
  .gh__title { margin-bottom: 22px; max-width: 18ch; }
  .gh__meta { margin-bottom: 14px; }
  .gh__text { max-width: 62ch; color: rgba(255, 255, 255, 0.92); font-size: 16px; font-weight: 500; line-height: 1.6; text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45); }
  .gh__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .gh__sub { margin-top: 10px; padding-left: 4px; color: rgba(255, 255, 255, 0.6); font-size: 12px; }

  .gh__progress { display: flex; align-items: center; gap: 12px; max-width: 420px; margin-top: 26px; color: rgba(255, 255, 255, 0.85); font-size: 13px; font-weight: 700; }
  .gh__bar { flex: 1; height: 5px; border-radius: 5px; background: rgba(255, 255, 255, 0.18); overflow: hidden; }
  .gh__bar i { display: block; height: 100%; border-radius: 5px; background: var(--state); }

  .gh__facts { display: grid; gap: 12px; padding: 22px 24px; }
  .gh__facts div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 16px; align-items: baseline; }
  .gh__facts dd { font-size: 14px; font-weight: 600; }
  .gh__facts a { text-decoration: underline; text-underline-offset: 3px; }

  /* ── Body ── */
  .gbody { display: grid; gap: 28px; padding-top: 12px; }
  .gsec { margin-top: 12px; }
  .about { max-width: 72ch; margin-bottom: 40px; color: var(--muted); line-height: 1.7; }
  .about p + p { margin-top: 12px; }
  .about .about__h { margin-top: 22px; color: var(--ink); font-weight: 600; }
  .about .about__h + .about__h { margin-top: 0; color: var(--faint); font-size: 13px; font-weight: 500; }
  .gsec__title { margin-bottom: 16px; font-size: clamp(1.15rem, 1.8vw, 1.45rem); font-weight: 600; }

  .note { padding: 22px 24px; --state: var(--st-early); }
  .note--abandoned { --state: var(--st-abandoned); }
