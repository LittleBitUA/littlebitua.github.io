---
// ─── Home Page ─────────────────────────────────────────────────
// Hero-карусель з банерами ігор, далі — горизонтальні ряди постерів.
import Layout from "../layouts/Layout.astro";
import HeroCarousel from "../components/cinema/HeroCarousel.astro";
import Row from "../components/cinema/Row.astro";
import GetStarted from "../components/GetStarted.astro";
import Support from "../components/Support.astro";
import FAQ from "../components/FAQ.astro";
import StatsBand from "../components/StatsBand.astro";
import Process from "../components/Process.astro";
import { games } from "../data/catalog";
import { SITE_URL } from "../utils/seo";
import { getSeriesGroups } from "../utils/series";
import { isPlayable, isFundraising, translationPercent, sortByStatus } from "../utils/status";
import { artOf } from "../lib/art";
import UpdatesFeed from "../components/UpdatesFeed.astro";
import { getUpdates } from "../lib/updates";

const byFresh = (a: (typeof games)[number], b: (typeof games)[number]) =>
  (b.releaseDate ?? b.lastUpdate ?? "").localeCompare(a.releaseDate ?? a.lastUpdate ?? "");

const playable = games.filter(isPlayable).sort(byFresh);

// Слайди: спершу свіжі релізи (є releaseDate), потім нещодавно оновлені; лише з широким банером
const heroOrder = [...playable].sort(
  (a, b) => Number(!!b.releaseDate) - Number(!!a.releaseDate) || byFresh(a, b),
);
const withArt = await Promise.all(heroOrder.map(async (g) => ({ g, art: await artOf(g) })));
const slides = withArt.filter((x) => x.art.banner).slice(0, 7).map((x) => x.g);
const firstTint = withArt.find((x) => x.g === slides[0])?.art.tint;

const inWork = games.filter((g) => !isPlayable(g) && g.status !== "fundraising");
const rows = [
  { title: "Нещодавно вийшли", games: playable.slice(0, 16), href: "/games/?status=playable" },
  {
    title: "Майже готово",
    games: inWork.filter((g) => translationPercent(g) >= 70).sort((a, b) => translationPercent(b) - translationPercent(a)),
  },
  { title: "Потрібна ваша підтримка", games: games.filter(isFundraising), href: "/games/?status=fundraising" },
  {
    title: "Перекладаємо зараз",
    games: inWork.filter((g) => translationPercent(g) < 70).sort(byFresh),
    href: "/games/?status=in-progress",
  },
];
const series = getSeriesGroups(3);
const latest = (await getUpdates(games)).slice(0, 6);
---

<Layout
  title="«Little Bit» — Українські локалізації відеоігор"
  description="Безкоштовні якісні переклади відеоігор українською. Без машинного перекладу. Сюжет, інтерфейс і дрібниці — рідною мовою."
  canonicalUrl={SITE_URL + "/"}
  tint={firstTint}
>
  <HeroCarousel games={slides} />

  <div class="rows" id="projects">
    {rows.slice(0, 1).map((r) => <Row title={r.title} games={r.games} href={r.href} />)}
    {latest.length > 0 && (
      <section class="c-row news">
        <header class="c-row__head">
          <h2>Що нового</h2>
          <a href="/news/">Уся стрічка →</a>
        </header>
        <UpdatesFeed items={latest} />
      </section>
    )}
    {rows.slice(1).map((r) => <Row title={r.title} games={r.games} href={r.href} />)}
    {series.map((s) => (
      <Row title={s.name} games={s.games} href={`/games/series/${s.slug}/`} hrefLabel="Уся серія" />
    ))}
    <Row title={`Усі локалізації · ${games.length}`} games={sortByStatus(games)} href="/games/" hrefLabel="Каталог з фільтрами" />
  </div>

  <StatsBand />
  <Process />
  <GetStarted />
  <Support />
  <FAQ />
</Layout>

<style>
  .rows { position: relative; margin-top: clamp(-120px, -9vh, -72px); padding-bottom: 40px; }
  .news :global(.feed) { padding-inline: var(--side); }
  @media (max-width: 760px) { .rows { margin-top: 12px; } }
</style>
