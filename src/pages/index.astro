---
// ─── Home Page ─────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import GameCard from "../components/GameCard.astro";
import FilterBar from "../components/FilterBar.astro";
import StatusLegend from "../components/StatusLegend.astro";
import Pipeline from "../components/Pipeline.astro";
import StatsCards from "../components/StatsCards.astro";
import GetStarted from "../components/GetStarted.astro";
import Support from "../components/Support.astro";
import FAQ from "../components/FAQ.astro";
import { games } from "../data/catalog";
import { SITE_URL } from "../utils/seo";
import { sortByStatus } from "../utils/status";
import { fetchTelegramPosts } from "../lib/telegram";
import { latestReport } from "../lib/chronology";
import { cover } from "../lib/cover";

const catalog = sortByStatus(games);

// Права колонка: свіжі пости каналу про наші ігри; якщо Telegram недоступний — останні виходи зі звіту
const posts = await fetchTelegramPosts(3);
const telegramNews = await Promise.all(posts.map(async (p) => ({ ...p, thumb: await cover(p.game.cover, 120) })));
const releases = await Promise.all(
  (latestReport?.entries ?? [])
    .filter((e) => e.kind === "released" && e.date)
    .slice(-5)
    .reverse()
    .map(async (e) => ({ ...e, thumb: e.game ? await cover(e.game.cover, 120) : null })),
);
const fmtDate = (d: string) => new Date(d).toLocaleDateString("uk-UA", { day: "numeric", month: "long" });
---

<Layout
  title="«Little Bit» — Українські локалізації відеоігор"
  description="Безкоштовні якісні переклади відеоігор українською. Без машинного перекладу. Сюжет, інтерфейс і дрібниці — рідною мовою."
  canonicalUrl={SITE_URL + "/"}
>
  <Hero />

  <section id="projects" class="section">
    <div class="container">
      <header class="section-head">
        <div>
          <span class="eyebrow">Каталог · {games.length}</span>
          <h2>Усі наші локалізації</h2>
        </div>
      </header>
      <StatusLegend />
      <FilterBar />
      <div class="game-grid">
        {catalog.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <Pipeline />

  <section class="section">
    <div class="container numbers">
      <div>
        <header class="section-head">
          <div>
            <span class="eyebrow">Цифри</span>
            <h2>Обсяг роботи</h2>
          </div>
        </header>
        <StatsCards />
      </div>

      <div>
        {telegramNews.length > 0 ? (
          <>
            <header class="section-head">
              <div>
                <span class="eyebrow">Telegram-канал</span>
                <h2>Новини</h2>
              </div>
              <a href="https://t.me/LittleBitUA" target="_blank" rel="noopener noreferrer" class="link">Підписатися</a>
            </header>
            <ol class="feed">
              {telegramNews.map((p) => (
                <li>
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="feed__item">
                    <img src={p.thumb} alt="" width="48" height="72" loading="lazy" decoding="async" />
                    <span class="feed__body">
                      <span class="feed__meta"><time datetime={p.date}>{fmtDate(p.date)}</time>{p.kicker}</span>
                      <span class="feed__title">{p.game.title}</span>
                      {p.excerpt && <span class="feed__text">{p.excerpt}</span>}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <>
            <header class="section-head">
              <div>
                <span class="eyebrow">Хронологія</span>
                <h2>Останні виходи</h2>
              </div>
              <a href="/chronology/" class="link">Уся хронологія</a>
            </header>
            <ol class="feed">
              {releases.map((e) => (
                <li>
                  <a href={`/chronology/#${e.id}`} class="feed__item">
                    {e.thumb ? <img src={e.thumb} alt="" width="48" height="72" loading="lazy" decoding="async" /> : <span />}
                    <span class="feed__body">
                      <span class="feed__meta">{e.date}{e.note && ` · ${e.note}`}</span>
                      <span class="feed__title">{e.title}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </>
        )}
      </div>
    </div>
  </section>

  <GetStarted />
  <Support />
  <FAQ />
</Layout>

<style>
  .numbers { display: grid; gap: 56px; }
  @media (min-width: 1024px) {
    .numbers { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 72px; }
  }

  .feed { border-top: 1px solid var(--line); }
  .feed__item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .feed__item img { width: 48px; height: 72px; object-fit: cover; border: 1px solid var(--line); }
  .feed__body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .feed__meta { color: var(--muted); font-size: 12px; font-weight: 700; }
  .feed__meta time { margin-right: 8px; color: var(--accent); font-weight: 800; }
  .feed__title { font-size: 15px; font-weight: 800; transition: color 0.18s ease; }
  .feed__item:hover .feed__title { color: var(--accent); }
  .feed__text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--faint);
    font-size: 13px;
    line-height: 1.5;
  }
</style>
