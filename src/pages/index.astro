---
// ─── Home Page ─────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import GameCard from "../components/GameCard.astro";
import FilterBar from "../components/FilterBar.astro";
import StatusLegend from "../components/StatusLegend.astro";
import Pipeline from "../components/Pipeline.astro";
import StatsCards from "../components/StatsCards.astro";
import GetStarted from "../components/GetStarted.astro";
import Support from "../components/Support.astro";
import FAQ from "../components/FAQ.astro";
import { games } from "../data/catalog";
import { getAllUpdates, eventTone } from "../utils/updates";
import { SITE_URL } from "../utils/seo";
import { sortByStatus } from "../utils/status";


const catalog = sortByStatus(games);

const updates = getAllUpdates(6);
const fmtDate = (d: string) => new Date(d).toLocaleDateString("uk-UA", { day: "numeric", month: "short" });
---

<Layout
  title="«Little Bit» — Українські локалізації відеоігор"
  description="Безкоштовні якісні переклади відеоігор українською. Без машинного перекладу. Сюжет, інтерфейс і дрібниці — рідною мовою."
  canonicalUrl={SITE_URL + "/"}
>
  <Hero />

  <section id="projects" class="section">
    <div class="container">
      <header class="section-head">
        <div>
          <span class="eyebrow">Каталог · {games.length}</span>
          <h2>Усі наші локалізації</h2>
        </div>
      </header>
      <StatusLegend />
      <FilterBar />
      <div class="game-grid">
        {catalog.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </section>

  <Pipeline />

  <section class="section">
    <div class="container numbers">
      <div>
        <header class="section-head">
          <div>
            <span class="eyebrow">Цифри</span>
            <h2>Обсяг роботи</h2>
          </div>
        </header>
        <StatsCards />
      </div>

      <div>
        <header class="section-head">
          <div>
            <span class="eyebrow">Хроніка</span>
            <h2>Останні події</h2>
          </div>
          <a href="/updates/" class="link">Уся хроніка</a>
        </header>
        <ol class="feed">
          {updates.map((e) => {
            const tone = eventTone(e.kind);
            return (
              <li>
                <a href={`/games/${e.gameId}/`} class="feed__item" style={`--state:${tone.color}`}>
                  <time datetime={e.date}>{fmtDate(e.date)}</time>
                  <span class="feed__title">{e.title}</span>
                  <span class="feed__kind">{tone.label}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <GetStarted />
  <Support />
  <FAQ />
</Layout>

<style>
  .numbers { display: grid; gap: 56px; }
  @media (min-width: 1024px) {
    .numbers { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 72px; }
  }

  .feed { border-top: 1px solid var(--line); }
  .feed__item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.18s ease;
  }
  .feed__item:hover .feed__title { color: var(--accent); }
  .feed__item time { color: var(--faint); font-size: 12px; font-weight: 700; }
  .feed__title {
    overflow: hidden;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 0.18s ease;
  }
  .feed__kind {
    padding-left: 8px;
    border-left: 3px solid var(--state);
    color: var(--muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (max-width: 479px) {
    .feed__item { grid-template-columns: 1fr auto; }
    .feed__item time { grid-column: 1 / -1; }
  }
</style>
