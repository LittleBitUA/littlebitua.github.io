---
// ─── Home Page ─────────────────────────────────────────────────

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import GameCard from "../components/GameCard.astro";
import FilterBar from "../components/FilterBar.astro";
import Pipeline from "../components/Pipeline.astro";
import StatsCards from "../components/StatsCards.astro";
import GetStarted from "../components/GetStarted.astro";
import Support from "../components/Support.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { games } from "../data/games";
import { getAllUpdates } from "../utils/updates";

const STATUS_PRIORITY: Record<string, number> = { done: 0, "early-access": 1, "in-progress": 2, fundraising: 3 };
const sortedGames = [...games].sort((a, b) => {
  const pa = STATUS_PRIORITY[a.status] ?? 9;
  const pb = STATUS_PRIORITY[b.status] ?? 9;
  if (pa !== pb) return pa - pb;
  return (b.lastUpdate ?? "").localeCompare(a.lastUpdate ?? "");
});

const recentUpdates = getAllUpdates().slice(0, 4);

function fmtDate(d: string): string {
  return new Date(d).toLocaleDateString("uk-UA", { day: "numeric", month: "short" });
}
---

<Layout>
  <Header />

  <main class="flex-1">
    <Hero />

    <!-- ── Projects ── -->
    <section id="projects" class="pt-10 pb-20 sm:pt-14 sm:pb-24 relative">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8" data-animate>
          <div>
            <span class="lb-section-eyebrow">Локалізації</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white mt-1">Наші проєкти</h2>
          </div>
          <a href="/games/" class="text-sm font-semibold text-indigo-400 hover:text-indigo-300 whitespace-nowrap transition-colors">
            Наші проєкти →
          </a>
        </div>

        <FilterBar />

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 sm:gap-4" id="games-grid">
          {sortedGames.map((game) => <GameCard game={game} />)}
        </div>
      </div>
    </section>

    <Pipeline />

    <!-- ── Stats + Recent updates ── -->
    <section class="py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 lg:gap-12 items-start">

          <!-- Stats cards -->
          <div data-animate>
            <span class="lb-section-eyebrow mb-3">Цифри</span>
            <StatsCards />
          </div>

          <!-- Recent updates feed -->
          <div class="lg:w-72 shrink-0" data-animate>
            <div class="flex items-center justify-between mb-4">
              <span class="lb-section-eyebrow">Останні оновлення</span>
              <a href="/updates" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition-colors">
                Всі →
              </a>
            </div>
            <div class="space-y-2">
              {recentUpdates.map((e) => (
                <div class="flex gap-3 items-start p-3 rounded-xl" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
                  <span class="text-[10px] font-bold text-slate-500 whitespace-nowrap mt-0.5">{fmtDate(e.date)}</span>
                  <div class="min-w-0">
                    <p class="text-xs font-semibold text-slate-300 truncate">{e.title}</p>
                    {e.kind !== "update" && (
                      <span class="text-[10px] font-bold uppercase tracking-wide" style={`color: ${e.kind === "release" ? "#10b981" : e.kind === "early-access" ? "#0ea5e9" : "#818cf8"};`}>
                        {e.kind === "release" ? "Реліз" : e.kind === "early-access" ? "Ранній доступ" : e.kind}
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <GetStarted />
    <Support />
    <FAQ />
  </main>

  <Footer />
</Layout>
