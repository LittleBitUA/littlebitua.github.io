---
// ─── V4 Prototype Layout ──────────────────────────────────────
// Напрям: вітрина магазину (Steam / Epic / GOG).
// Артворк домінує, дані — підпис до нього. Ізольовано. noindex.

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Little Bit — українські локалізації",
  description = "Експериментальний редизайн у логіці ігрового магазину.",
} = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0D1319" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg:      #0D1319;
    --panel:   #16202B;
    --panel-2: #1E2A38;
    --panel-3: #27364A;
    --line:    rgba(232, 238, 244, 0.08);

    --fg:   #E8EEF4;
    --fg-2: #9BACBD;
    --fg-3: #64788C;

    /* Зелений = безкоштовно й доступно, як цінник у магазині */
    --go:    #7BC62D;
    --go-2:  #8FDB3C;
    --info:  #4A9FE8;
    --warn:  #E8A33D;

    --r: 6px;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg-2);
    font-family: "Rubik", system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    overflow-x: hidden;
  }

  h1, h2, h3 { color: var(--fg); margin: 0; line-height: 1.2; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  button { font: inherit; }

  ::selection { background: var(--go); color: #0B0F14; }
  :focus-visible { outline: 2px solid var(--go); outline-offset: 2px; }

  ::-webkit-scrollbar { width: 12px; height: 12px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb {
    background: var(--panel-3); border-radius: 999px;
    border: 3px solid var(--bg); background-clip: padding-box;
  }

  .wrap {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 768px) { .wrap { padding-inline: 2rem; } }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
