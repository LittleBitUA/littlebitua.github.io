---
// ─── Root Layout ───────────────────────────────────────────────
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL, generateOrganizationData } from "../utils/seo";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article" | "product";
  keywords?: string;
  structuredData?: string;
}

const {
  title = "«Little Bit» — Українська локалізація відеоігор",
  description = "«Little Bit» — сюжет, інтерфейс і дрібниці — українською. Yakuza, Judgment, No More Heroes, Metal Gear Solid та інші. Слідкуйте за прогресом і завантажуйте готові локалізації.",
  ogImage = `${SITE_URL}/images/og.png`,
  canonicalUrl = SITE_URL,
  ogType = "website",
  keywords = "українська локалізація, переклад ігор, Little Bit, Yakuza, Judgment, No More Heroes, Metal Gear Solid, NieR, Uncharted, українською, локалізація відеоігор",
  structuredData,
} = Astro.props;

const FONTS =
  "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@600;700;800&display=swap";
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="«Little Bit»" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="«Little Bit» — Локалізації" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="«Little Bit» — перекладаємо те, у що самі граємо" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="«Little Bit» — Хронологія перекладів" href={`${SITE_URL}/rss.xml`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} />

    <title>{title}</title>

    <script is:inline type="application/ld+json" set:html={generateOrganizationData()} />
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
  </head>

  <body>
    <a class="skip-link" href="#main">Перейти до вмісту</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <button id="scroll-top" class="scroll-top" type="button" aria-label="Прокрутити вгору" hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
    </button>

    <script>
      const btn = document.getElementById("scroll-top")!;
      const sync = () => { btn.hidden = window.scrollY < 800; };
      window.addEventListener("scroll", sync, { passive: true });
      btn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
      sync();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 14px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 800;
    transform: translateY(-150%);
  }
  .skip-link:focus { transform: none; }

  .scroll-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  .scroll-top[hidden] { display: none; }
  .scroll-top:hover { border-color: var(--accent); color: var(--accent); }
  .scroll-top svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.4; }
</style>
