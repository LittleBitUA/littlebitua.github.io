---
// ─── V2 Prototype Layout ──────────────────────────────────────
// Ізольований від основного сайту: власні шрифти, власні токени,
// жодного global.css. noindex — це чернетка, не для пошуку.

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Little Bit — прототип дизайну",
  description = "Експериментальний редизайн сайту українських локалізацій.",
} = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A0E13" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;900&family=Onest:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ─── Tokens ──────────────────────────────────────────────── */
  :root {
    --ground:   #0A0E13;
    --surface:  #111821;
    --surface-2:#18212C;
    --line:     rgba(242, 239, 233, 0.09);
    --line-2:   rgba(242, 239, 233, 0.16);

    --paper:      #F2EFE9;
    --paper-dim:  #9AA5B1;
    --paper-faint:#616B77;

    --wheat:      #E8B84B;
    --wheat-deep: #B98F27;
    --sprout:     #6FBF9B;
    --ember:      #DD6B4B;

    --measure: 68ch;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--paper-dim);
    font-family: "Onest", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  h1, h2, h3 {
    font-family: "Unbounded", system-ui, sans-serif;
    color: var(--paper);
    text-wrap: balance;
    margin: 0;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }

  ::selection { background: var(--wheat); color: var(--ground); }

  :focus-visible {
    outline: 2px solid var(--wheat);
    outline-offset: 3px;
  }

  ::-webkit-scrollbar { width: 10px; }
  ::-webkit-scrollbar-track { background: var(--ground); }
  ::-webkit-scrollbar-thumb {
    background: var(--surface-2);
    border-radius: 999px;
    border: 2px solid var(--ground);
    background-clip: padding-box;
  }

  /* ─── Shared primitives ───────────────────────────────────── */
  .wrap {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) { .wrap { padding-inline: 2.5rem; } }

  /* Eyebrow: a rule + label, used to open every section */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--paper-faint);
    margin-bottom: 1.75rem;
  }
  .eyebrow::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .eyebrow__n {
    color: var(--wheat);
    font-variant-numeric: tabular-nums;
  }

  .tnum { font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
