---
// ─── Store Prototype Layout ───────────────────────────────────
// Свідомо використовує global.css основного сайту — та сама
// палітра, ambient-фон, шрифти. Змінюється лише механіка,
// не візуальна мова. store.css додає шар магазину. noindex.

import "../styles/global.css";
import "../styles/store.css";
import { games } from "../data/games";
import { steamCapsule } from "../utils/steamAssets";

export interface Props {
  title?: string;
  description?: string;
  active?: "store" | "catalog" | "watch";
}

const {
  title = "Little Bit — магазин локалізацій",
  description = "Прототип: українські локалізації відеоігор у форматі магазину.",
  active = "store",
} = Astro.props;

// Індекс для миттєвого пошуку — віддається клієнту одним масивом
const searchIndex = games.map((g) => {
  const s = g.stageDetails ?? [];
  const xlat = (s.find((d) => /переклад/i.test(d.label)) ?? s[0])?.percent ?? g.progress;
  return {
    id: g.id,
    t: g.title,
    c: g.cover,
    playable: g.status === "done" || g.status === "early-access",
    p: xlat,
    series: g.series ?? "",
    tags: g.tags.join(" "),
  };
});
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#090b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body class="min-h-screen flex flex-col overflow-x-hidden">
    <!-- Той самий ambient-фон, що й на основному сайті -->
    <div class="lb-ambient" aria-hidden="true">
      <div class="lb-ambient__blob lb-ambient__blob--1"></div>
      <div class="lb-ambient__blob lb-ambient__blob--2"></div>
      <div class="lb-ambient__blob lb-ambient__blob--3"></div>
      <div class="lb-ambient__vignette"></div>
      <div class="lb-ambient__grain"></div>
    </div>

    <header class="st-hd">
      <div class="st-hd__in">
        <a href="/store/" class="st-brand">
          <span class="st-brand__m">LB</span>
          <span class="st-brand__n">Little Bit</span>
        </a>

        <nav class="st-nav">
          <a href="/store/" class={active === "store" ? "is-on" : ""}>Вітрина</a>
          <a href="/store/catalog/" class={active === "catalog" ? "is-on" : ""}>Каталог</a>
          <a href="/store/#watchlist">Стежу</a>
          <a href="/store/#free">Безкоштовно</a>
        </nav>

        <div class="st-search">
          <svg class="st-search__i" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            type="text"
            id="stSearch"
            class="st-search__f"
            placeholder="Пошук гри…"
            autocomplete="off"
            aria-label="Пошук гри"
          />
          <div class="st-res" id="stRes"></div>
        </div>

        <a href="/" class="st-btn st-btn--ghost st-btn--sm" style="flex-shrink:0;">Старий сайт</a>
      </div>
    </header>

    <slot />

    <footer style="border-top:1px solid rgba(255,255,255,0.08); padding:1.6rem 0; margin-top:2rem;">
      <div class="st-wrap" style="display:flex; justify-content:space-between; gap:1rem; font-size:0.76rem; color:#64748b;">
        <span>Прототип магазину · дані з поточного сайту</span>
        <a href="/" style="color:#818cf8;">← повернутись на сайт</a>
      </div>
    </footer>

    <script define:vars={{ searchIndex }}>
      // ── Миттєвий пошук ──
      const input = document.getElementById("stSearch");
      const box = document.getElementById("stRes");
      let cur = -1;

      function render(list) {
        if (!list.length) {
          box.innerHTML = '<div class="st-res__empty">Нічого не знайдено</div>';
          box.classList.add("is-open");
          return;
        }
        box.innerHTML = list
          .map(
            (g, i) => `
            <a class="st-res__i" href="/store/game/${g.id}/" data-i="${i}">
              <img src="${g.c}" alt="" loading="lazy">
              <span style="min-width:0">
                <span class="st-res__t">${g.t}</span>
                <span class="st-res__s" style="color:${g.playable ? "#4ade80" : "#818cf8"}">
                  ${g.playable ? "Безкоштовно · можна завантажити" : g.p + "% перекладено"}
                </span>
              </span>
            </a>`
          )
          .join("");
        box.classList.add("is-open");
        cur = -1;
      }

      function search(q) {
        const s = q.trim().toLowerCase();
        if (!s) return [];
        return searchIndex
          .filter(
            (g) =>
              g.t.toLowerCase().includes(s) ||
              g.series.toLowerCase().includes(s) ||
              g.tags.toLowerCase().includes(s)
          )
          .slice(0, 8);
      }

      let t;
      input?.addEventListener("input", () => {
        clearTimeout(t);
        t = setTimeout(() => {
          const q = input.value;
          if (!q.trim()) { box.classList.remove("is-open"); return; }
          render(search(q));
        }, 120);
      });

      input?.addEventListener("keydown", (e) => {
        const items = box.querySelectorAll(".st-res__i");
        if (!items.length) return;
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          cur = e.key === "ArrowDown"
            ? Math.min(cur + 1, items.length - 1)
            : Math.max(cur - 1, 0);
          items.forEach((el, i) => el.classList.toggle("is-cur", i === cur));
          items[cur].scrollIntoView({ block: "nearest" });
        } else if (e.key === "Enter" && cur >= 0) {
          e.preventDefault();
          items[cur].click();
        } else if (e.key === "Escape") {
          box.classList.remove("is-open");
          input.blur();
        }
      });

      document.addEventListener("click", (e) => {
        if (!e.target.closest(".st-search")) box.classList.remove("is-open");
      });

      // ── Список стеження (localStorage) ──
      const KEY = "lb-watchlist";
      const read = () => {
        try { return JSON.parse(localStorage.getItem(KEY) || "[]"); }
        catch { return []; }
      };
      const write = (v) => localStorage.setItem(KEY, JSON.stringify(v));

      function syncButtons() {
        const list = read();
        document.querySelectorAll("[data-watch]").forEach((b) => {
          const on = list.includes(b.dataset.watch);
          b.classList.toggle("is-on", on);
          b.setAttribute("aria-pressed", String(on));
          b.title = on ? "Не стежити" : "Стежити за перекладом";
        });
        document.querySelectorAll("[data-watch-count]").forEach((el) => {
          el.textContent = String(list.length);
        });
        // На вітрині показуємо/ховаємо секцію зі збереженим
        document.querySelectorAll("[data-watch-item]").forEach((el) => {
          el.hidden = !list.includes(el.dataset.watchItem);
        });
        const sec = document.getElementById("watchlist");
        if (sec) sec.hidden = list.length === 0;
      }

      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-watch]");
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        const id = btn.dataset.watch;
        const list = read();
        const i = list.indexOf(id);
        if (i === -1) list.push(id); else list.splice(i, 1);
        write(list);
        syncButtons();
      });

      syncButtons();

      // ── Стрілки полиць ──
      document.querySelectorAll("[data-scroll]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const row = document.getElementById(btn.dataset.scroll);
          if (row) row.scrollBy({ left: Number(btn.dataset.dir) * row.clientWidth * 0.85, behavior: "smooth" });
        });
      });

      // ── Фолбек широкого арту: якщо header.jpg 404 — постер ──
      document.querySelectorAll("img[data-fallback]").forEach((img) => {
        img.addEventListener("error", () => {
          if (img.dataset.done) return;
          img.dataset.done = "1";
          img.src = img.dataset.fallback;
          img.style.objectFit = "cover";
        }, { once: true });
      });
    </script>
  </body>
</html>
